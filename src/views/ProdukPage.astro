<script>
  // Klaussa video: the poster is a plain link to YouTube. With JS the first click plays it in place,
  // loading YouTube only at that moment (privacy-enhanced domain).
  document.querySelectorAll<HTMLAnchorElement>('[data-yt]').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${a.dataset.yt}?autoplay=1&rel=0`;
      f.title = a.getAttribute('aria-label') || 'Video';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.className = 'yt-iframe';
      f.style.cssText = 'display:block;width:100%;height:100%;border:0;aspect-ratio:16/9';
      a.replaceWith(f);
      f.focus();
    });
  });

  const goto = (id: string, smooth = true) => {
    const el = document.getElementById(id);
    if (!el) return;
    const top = el.getBoundingClientRect().top + scrollY - (innerWidth < 640 ? 64 : 80);
    const L = (window as any).__lenis;
    if (L && smooth) L.scrollTo(top, { duration: 1.4 }); else scrollTo({ top, behavior: smooth ? 'smooth' : 'auto' });
  };
  document.querySelectorAll<HTMLElement>('[data-go]').forEach((el) => el.addEventListener('click', (e) => { e.preventDefault(); goto(el.dataset.go!); history.replaceState(null, '', '#' + el.dataset.go); }));
</script>

