---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { dict, type Lang } from '../lib/i18n';
import { postsByDate } from '../lib/content';
import { postView, TYPES } from '../lib/posts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict('wawasan', lang);

const all = await Promise.all(postsByDate().map((p) => postView(p, lang)));
const typesF = [['all', t.all]].concat(Object.keys(TYPES).map((k) => [k, TYPES[k][lang]])).map(([k, label]) => ({
  k, label, count: k === 'all' ? all.length : all.filter((p) => p.type === k).length,
}));
---
<BaseLayout lang={lang} path="wawasan/" active="wawasan" title={`Lexin — ${t.nav[6]}`}>

<PageHeader>
  <div class="eyebrow">{t.eyebrow}</div>
  <h1 class="ph-h1">{t.titleA} <span class="grad-text">{t.titleB}</span></h1>
  <div class="ph-rule"></div>
  <p class="u-65f54a">{t.intro}</p>
</PageHeader>

<section class="u-5cf619">
  <div class="container layout">
    <aside class="side">
      <span class="u-64c657">{t.typeLabel}</span>
      <div class="rail">
        {typesF.map((f) => <button type="button" class:list={['rbtn', { on: f.k === 'all', dim: !f.count }]} data-k={f.k}>{f.label}<span class="u-305db9">{f.count}</span></button>)}
      </div>
      <div class="pills">
        {typesF.map((f) => <button type="button" class:list={['pbtn', { on: f.k === 'all', dim: !f.count }]} data-k={f.k}>{f.label}<span class="u-305db9">{f.count}</span></button>)}
      </div>
    </aside>
    <div class="u-297e45">
      {all.map((u) => (
        <article class="row" data-type={u.type}>
          <a href={u.href} class="u-b508a5" tabindex="-1" aria-hidden="true"><div style={`position:relative;width:100%;aspect-ratio:4/3;background:${u.panel};color:${u.ink};display:flex;align-items:center;justify-content:center;overflow:hidden`}>
            <Icon name={u.icon} size={36} />
            <span style={`position:absolute;inset:0;background:${u.photoBg}`}></span>
          </div></a>
          <div class="u-0b9905">
            <div class="u-72fafc"><span class="type-tag" style={`background:${u.typeBg};color:${u.typeFg}`}>{u.typeLabel}</span><span class="u-d6e2eb">{u.dateLabel}</span></div>
            <a href={u.href} class="title">{u.title}</a>
            <p class="u-1a14cb">{u.dek}</p>
            <div class="u-bdad12"><div class="u-2075ff">
              {u.authors.map((a) => <a href={a.href} class="person"><span style={`width:22px;height:22px;border-radius:50%;background:${a.avBg};color:var(--fg-on-dark);display:flex;align-items:center;justify-content:center;font:700 9px/1 var(--font-display)`}>{a.ini}</span>{a.name}</a>)}
            </div><span class="u-e806c4">{u.srcLabel}</span></div>
          </div>
        </article>
      ))}
      <div class="empty" hidden>
        <span class="u-e32b75">{t.emptyTitle}</span>
        <span class="u-1c3257">{t.emptyBody}</span>
      </div>
    </div>
  </div>
</section>

<section class="u-5cf619">
  <div class="container u-3c657e">
    <div class="u-1a17bf">
      <div class="u-77325d">
        <span class="u-8014ef">{t.pitchTitle}</span>
        <span class="u-827c3f">{t.pitchBody}</span>
      </div>
      <Button variant="secondary" iconRight="mail" href="mailto:hadiputra@cs.ui.ac.id?subject=Wawasan%20Lexin">{t.pitchCta}</Button>
    </div>
  </div>
</section>

</BaseLayout>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.rbtn, .pbtn');
  const apply = (k: string) => {
    btns.forEach((b) => { const on = b.dataset.k === k; b.classList.toggle('on', on); b.setAttribute('aria-pressed', String(on)); });
    let n = 0;
    document.querySelectorAll<HTMLElement>('.row').forEach((r) => { const show = k === 'all' || r.dataset.type === k; r.hidden = !show; if (show) n++; });
    document.querySelector<HTMLElement>('.empty')!.hidden = n > 0;
  };
  btns.forEach((b) => b.addEventListener('click', () => apply(b.dataset.k!)));
</script>

<style>
  .layout { padding-top: clamp(32px,5vw,56px); padding-bottom: clamp(48px,7vw,80px); display: grid; grid-template-columns: minmax(0,1fr); gap: clamp(28px,4vw,56px); align-items: start; }
  .side { position: static; top: 104px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .rail { display: none; flex-direction: column; gap: 4px; }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; }
  @media (min-width: 1120px) {
    .layout { grid-template-columns: 260px minmax(0,1fr); }
    .side { position: sticky; }
    .rail { display: flex; }
    .pills { display: none; }
  }
  .rbtn { cursor: pointer; border: 0; min-height: 44px; padding: 0 14px; border-radius: 14px; display: flex; align-items: center; justify-content: space-between; gap: 10px; text-align: left; font: 600 14px/1.25 var(--font-display); background: transparent; color: var(--navy-900); }
  .rbtn:hover { box-shadow: inset 0 0 0 1px var(--navy-200); }
  .pbtn { cursor: pointer; border: 0; height: 36px; padding: 0 14px; border-radius: 999px; display: inline-flex; align-items: center; gap: 8px; font: 600 13px/1 var(--font-display); white-space: nowrap; background: var(--ink-0); color: var(--navy-900); box-shadow: inset 0 0 0 1px var(--border-subtle); }
  .rbtn.on, .pbtn.on { background: var(--navy-600); color:var(--fg-on-dark); box-shadow: none; }
  .dim:not(.on) { opacity: .55; }
  .row { display: grid; grid-template-columns: minmax(0,1fr); gap: 16px 28px; align-items: center; padding: 24px 0; box-shadow: inset 0 -1px 0 var(--border-subtle); }
  @media (min-width: 760px) { .row { grid-template-columns: 220px minmax(0,1fr); } }
  .title { font: 700 clamp(19px,2vw,22px)/1.3 var(--font-display); color: var(--text-heading); text-wrap: pretty; }
  .title:hover { color: var(--navy-600); }
  .person { height: 28px; padding: 0 10px 0 3px; border-radius: 999px; background: var(--navy-50); display: inline-flex; align-items: center; gap: 6px; font: 600 12px/1 var(--font-display); color: var(--navy-800); white-space: nowrap; }
  .person:hover { background: var(--navy-100); color: var(--navy-600); }
  .empty { border-radius: var(--radius-xl); border: 2px dashed var(--navy-200); padding: 32px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 8px; margin-top: 24px; }
  .empty[hidden] { display: none; }
  .u-65f54a { font:var(--type-body-lg);margin:24px 0 0;color:var(--text-body);max-width:640px;text-wrap:pretty; }
  .u-5cf619 { background:var(--surface-page); }
  .u-64c657 { font:600 12px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--text-muted);margin-bottom:4px; }
  .u-305db9 { font:500 12px/1 var(--font-mono);opacity:.7; }
  .u-297e45 { display:flex;flex-direction:column;box-shadow:inset 0 1px 0 var(--border-subtle);min-width:0; }
  .u-b508a5 { display:block;border-radius:20px;overflow:hidden; }
  .u-0b9905 { display:flex;flex-direction:column;gap:10px;min-width:0; }
  .u-72fafc { display:flex;align-items:center;gap:10px;flex-wrap:wrap; }
  .u-d6e2eb { font:500 13px/1 var(--font-mono);color:var(--text-muted); }
  .u-1a14cb { margin:0;font:var(--type-body);color:var(--text-muted);text-wrap:pretty; }
  .u-bdad12 { display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:4px; }
  .u-2075ff { display:flex;flex-wrap:wrap;gap:6px; }
  .u-e806c4 { font:500 12px/1.3 var(--font-mono);color:var(--text-muted); }
  .u-e32b75 { font:700 18px/1.3 var(--font-display);color:var(--text-heading); }
  .u-1c3257 { font:var(--type-body);color:var(--text-muted); }
  .u-3c657e { padding-bottom:clamp(56px,8vw,96px); }
  .u-1a17bf { border-radius:var(--radius-xl);background:var(--navy-50);box-shadow:inset 0 0 0 1px var(--navy-200);padding:clamp(22px,3vw,32px);display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px 32px; }
  .u-77325d { display:flex;flex-direction:column;gap:6px;max-width:640px; }
  .u-8014ef { font:700 clamp(20px,2.2vw,24px)/1.25 var(--font-display);color:var(--text-heading); }
  .u-827c3f { font:var(--type-body);color:var(--text-muted);text-wrap:pretty; }
  .type-tag { display: inline-flex; align-items: center; height: 24px; padding: 0 8px; border-radius: var(--radius-xs); font: 600 12px/1 var(--font-display); letter-spacing: var(--tracking-wide); text-transform: uppercase; white-space: nowrap; }
</style>
