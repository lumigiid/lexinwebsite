---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { dict, asset, mailto, MAIN_EMAIL, type Lang } from '../lib/i18n';
import { img } from '../lib/images';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict('kontak', lang);

// No form: each reason opens an email with the subject prefilled.
const reasons = t.reasons.map((r: any) => ({ ...r, mailto: mailto('Lexin · ' + r.subject) }));
const photo = await img('assets/people/panca-hadi-putra.png', 160);
---
<BaseLayout lang={lang} path="kontak/">

<PageHeader>
  <div class="eyebrow">{t.eyebrow}</div>
  <h1 class="ph-h1">{t.titleA} <span class="grad-text">{t.titleB}</span></h1>
  <div class="ph-rule"></div>
  <p class="u-65f54a">{t.intro}</p>
</PageHeader>

<section class="u-5cf619">
  <div class="container u-d61fac">
    <div class="u-177e56">
      <img src={asset('assets/lexin-mark.png')} alt="" class="u-88d3ce" />
      <div class="u-df7a10">
        <span class="u-bf79a6">{t.contactLabel}</span>
        <a href={mailto()} class="big-mail">{MAIN_EMAIL}</a>
        <div class="mail-actions">
          <Button variant="accent" size="sm" iconRight="mail" href={mailto()}>{t.contactUs}</Button>
          <button type="button" class="copy-mail" data-copy={MAIN_EMAIL} data-done={t.copied}><Icon name="copy" size={15} /><span>{t.copy}</span></button>
        </div>
        <div class="u-ee36e7">
          <img src={photo} alt="Dr. Panca Hadi Putra" width="72" height="72" class="u-5300a7" />
          <span class="u-e6c996">
            <span class="u-d3aef6">Dr. Panca Hadi Putra</span>
            <span class="u-8544d1">{t.role}</span>
          </span>
        </div>
      </div>
      <div class="u-ba5e94">
        <div class="u-3503ba">
          <span class="u-bf79a6">{t.addrLabel}</span>
          <span class="u-6fc58f">Fakultas Ilmu Komputer, Universitas Indonesia</span>
          <span class="u-d299a3">Kampus UI Depok, Depok, Jawa Barat 16424</span>
        </div>
        <div class="u-265308">
          <Button variant="inverse" iconLeft="map-pin" href="https://maps.google.com/?q=Fakultas+Ilmu+Komputer+Universitas+Indonesia">{t.maps}</Button>
          <a href="https://github.com/lab-lexin" class="gh" target="_blank" rel="noopener"><Icon name="github" size={16} />lab-lexin</a>
        </div>
      </div>
    </div>
    <div class="u-37d2b6">
      <h2 class="u-9ecc2d">{t.byNeed}</h2>
      <div class="u-43c23d">
        {reasons.map((r: any) => (
          <a href={r.mailto} class="reason">
            <span class="u-e5cb8d"><Icon name={r.icon} size={20} /></span>
            <span class="u-2fca08"><span class="u-cbcafe">{r.title}</span><span class="u-16e09c">{r.body}</span></span>
            <Icon name="mail" size={18} />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const label = b.querySelector('span')!;
    const idle = label.textContent;
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy!); } catch { return; }
      label.textContent = b.dataset.done!;
      setTimeout(() => { label.textContent = idle; }, 2000);
    });
  });
</script>

<style>
  .big-mail { font: 700 clamp(24px,3.6vw,40px)/1.15 var(--font-display); letter-spacing: var(--tracking-tight); color:var(--fg-on-dark); overflow-wrap: normal; word-break: normal; }
  .big-mail:hover { color: var(--yellow-300); }
  .big-mail { font-size: clamp(20px,2.6vw,30px); overflow-wrap: anywhere; user-select: all; }
  .mail-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .copy-mail { height: 36px; padding: 0 14px; border: 0; border-radius: 999px; background: none; box-shadow: inset 0 0 0 1px var(--on-dark-line-2); display: inline-flex; align-items: center; gap: 8px; font: 600 13px/1 var(--font-display); color: var(--fg-on-dark); cursor: pointer; }
  .copy-mail:hover { background: var(--on-dark-fill-2); }
  .gh { height: 44px; padding: 0 16px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--on-dark-line-2); display: inline-flex; align-items: center; gap: 8px; font: 600 14px/1 var(--font-display); color:var(--fg-on-dark); }
  .gh:hover { background: var(--on-dark-fill-2); color:var(--fg-on-dark); }
  .reason { display: flex; align-items: center; gap: 14px; padding: 16px 12px; border-bottom: 1px solid var(--border-default); color: var(--text-heading); transition: background-color var(--dur-base) var(--ease-out) }
  .reason:hover { background: var(--navy-50); color: var(--navy-600) }
  .u-65f54a { font:var(--type-body-lg);margin:24px 0 0;color:var(--text-body);max-width:640px;text-wrap:pretty; }
  .u-5cf619 { background:var(--surface-page); }
  .u-d61fac { padding-top:clamp(40px,6vw,72px);padding-bottom:clamp(56px,8vw,96px);display:flex;flex-direction:column;gap:clamp(28px,4vw,40px); }
  .u-177e56 { border-radius:clamp(24px,3vw,32px);background:var(--grad-night);color:var(--fg-on-dark);padding:clamp(24px,4vw,48px);position:relative;overflow:hidden;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:28px clamp(32px,5vw,64px);align-items:center; }
  .u-88d3ce { position:absolute;right:-60px;bottom:-80px;height:300px;opacity:.1;filter:brightness(0) invert(1);pointer-events:none;max-width:none; }
  .u-df7a10 { position:relative;display:flex;flex-direction:column;gap:18px;min-width:0; }
  .u-bf79a6 { font:600 12px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--yellow-300); }
  .u-ee36e7 { display:flex;align-items:center;gap:16px; }
  .u-5300a7 { width:72px;height:72px;border-radius:50%;object-fit:cover;flex-shrink:0;box-shadow:0 0 0 3px var(--on-dark-rule);background:var(--ink-0); }
  .u-e6c996 { display:flex;flex-direction:column;gap:4px;min-width:0; }
  .u-d3aef6 { font:700 20px/1.25 var(--font-display);color:var(--fg-on-dark); }
  .u-8544d1 { font:600 14px/1.3 var(--font-display);color:var(--yellow-300); }
  .u-ba5e94 { position:relative;border-top:1px solid var(--on-dark-line);padding:22px 0 0;display:flex;flex-direction:column;gap:16px }
  .u-3503ba { display:flex;flex-direction:column;gap:6px; }
  .u-6fc58f { font:600 16px/1.5 var(--font-display);color:var(--fg-on-dark); }
  .u-d299a3 { font:var(--type-body);color:var(--fg-on-dark-2); }
  .u-265308 { display:flex;flex-wrap:wrap;gap:10px; }
  .u-37d2b6 { display:flex;flex-direction:column;gap:16px; }
  .u-9ecc2d { font:var(--type-h2);font-size:clamp(24px,2.8vw,30px);letter-spacing:var(--tracking-snug);color:var(--text-heading);margin:0; }
  .u-43c23d { display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,340px),1fr));gap:12px; }
  .u-e5cb8d { color:var(--navy-500);display:flex;align-items:center;justify-content:center;flex-shrink:0 }
  .u-2fca08 { display:flex;flex-direction:column;gap:3px;flex:1;min-width:0; }
  .u-cbcafe { font:700 16px/1.3 var(--font-display); }
  .u-16e09c { font:var(--type-body-sm);color:var(--text-muted); }
</style>
