---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { dict, asset, type Lang } from '../lib/i18n';
import { img } from '../lib/images';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict('kontak', lang);

// No form: each reason opens an email with the subject prefilled.
const reasons = t.reasons.map((r: any) => ({ ...r, mailto: 'mailto:hadiputra@cs.ui.ac.id?subject=' + encodeURIComponent('Lexin · ' + r.subject) }));
const photo = await img('assets/people/panca-hadi-putra.png', 160);
---
<BaseLayout lang={lang} path="kontak/" title={`Lexin — ${t.contact}`}>

<PageHeader>
  <div class="eyebrow">{t.eyebrow}</div>
  <h1 class="ph-h1">{t.titleA} <span class="grad-text">{t.titleB}</span></h1>
  <div class="ph-rule"></div>
  <p style="font:var(--type-body-lg);margin:24px 0 0;color:var(--text-body);max-width:640px;text-wrap:pretty">{t.intro}</p>
</PageHeader>

<section style="background:var(--surface-page)">
  <div class="container" style="padding-top:clamp(40px,6vw,72px);padding-bottom:clamp(56px,8vw,96px);display:flex;flex-direction:column;gap:clamp(28px,4vw,40px)">
    <div style="border-radius:clamp(24px,3vw,32px);background:var(--grad-night);color:#FFFFFF;padding:clamp(24px,4vw,48px);position:relative;overflow:hidden;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:28px clamp(32px,5vw,64px);align-items:center">
      <img src={asset('assets/lexin-mark.png')} alt="" style="position:absolute;right:-60px;bottom:-80px;height:300px;opacity:.1;filter:brightness(0) invert(1);pointer-events:none;max-width:none" />
      <div style="position:relative;display:flex;flex-direction:column;gap:18px;min-width:0">
        <span style="font:600 12px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--yellow-300)">{t.contactLabel}</span>
        <a href="mailto:hadiputra@cs.ui.ac.id" class="big-mail">hadiputra<wbr />@cs.ui.ac.id</a>
        <div style="display:flex;align-items:center;gap:16px">
          <img src={photo} alt="Dr. Panca Hadi Putra" width="72" height="72" style="width:72px;height:72px;border-radius:50%;object-fit:cover;flex-shrink:0;box-shadow:0 0 0 3px rgba(255,255,255,.18);background:#FFFFFF" />
          <span style="display:flex;flex-direction:column;gap:4px;min-width:0">
            <span style="font:700 20px/1.25 var(--font-display);color:#FFFFFF">Dr. Panca Hadi Putra</span>
            <span style="font:600 14px/1.3 var(--font-display);color:var(--yellow-300)">{t.role}</span>
          </span>
        </div>
      </div>
      <div style="position:relative;border-radius:20px;background:rgba(255,255,255,.08);box-shadow:inset 0 0 0 1px rgba(255,255,255,.16);padding:22px;display:flex;flex-direction:column;gap:16px">
        <div style="display:flex;flex-direction:column;gap:6px">
          <span style="font:600 11px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--yellow-300)">{t.addrLabel}</span>
          <span style="font:600 16px/1.5 var(--font-display);color:#FFFFFF">Fakultas Ilmu Komputer, Universitas Indonesia</span>
          <span style="font:var(--type-body);color:var(--fg-on-dark-2)">Kampus UI Depok, Depok, Jawa Barat 16424</span>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:10px">
          <Button variant="inverse" iconLeft="map-pin" href="https://maps.google.com/?q=Fakultas+Ilmu+Komputer+Universitas+Indonesia">{t.maps}</Button>
          <a href="https://github.com/lab-lexin" class="gh" target="_blank" rel="noopener"><Icon name="github" size={16} />lab-lexin</a>
        </div>
      </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:16px">
      <h2 style="font:var(--type-h2);font-size:clamp(24px,2.8vw,30px);letter-spacing:var(--tracking-snug);color:var(--text-heading);margin:0">{t.byNeed}</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,340px),1fr));gap:12px">
        {reasons.map((r: any) => (
          <a href={r.mailto} class="reason">
            <span style="width:44px;height:44px;border-radius:13px;background:var(--navy-50);color:var(--navy-500);display:flex;align-items:center;justify-content:center;flex-shrink:0"><Icon name={r.icon} size={20} /></span>
            <span style="display:flex;flex-direction:column;gap:3px;flex:1;min-width:0"><span style="font:700 16px/1.3 var(--font-display)">{r.title}</span><span style="font:var(--type-body-sm);color:var(--text-muted)">{r.body}</span></span>
            <Icon name="mail" size={18} />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

</BaseLayout>

<style>
  .big-mail { font: 700 clamp(24px,3.6vw,40px)/1.15 var(--font-display); letter-spacing: var(--tracking-tight); color: #FFFFFF; overflow-wrap: normal; word-break: normal; }
  .big-mail:hover { color: var(--yellow-300); }
  .gh { height: 44px; padding: 0 16px; border-radius: 999px; box-shadow: inset 0 0 0 1px rgba(255,255,255,.4); display: inline-flex; align-items: center; gap: 8px; font: 600 14px/1 var(--font-display); color: #FFFFFF; }
  .gh:hover { background: rgba(255,255,255,.1); color: #FFFFFF; }
  .reason { display: flex; align-items: center; gap: 14px; padding: 16px 18px; border-radius: 18px; background: var(--surface-card); box-shadow: inset 0 0 0 1px var(--border-subtle); color: var(--text-heading); transition: box-shadow .2s; }
  .reason:hover { box-shadow: inset 0 0 0 1px var(--navy-300), var(--shadow-md); color: var(--navy-600); }
</style>
