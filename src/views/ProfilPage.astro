---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { dict, url, asset, type Lang } from '../lib/i18n';
import { members, type Member } from '../lib/content';
import { img } from '../lib/images';

interface Props { lang: Lang; member: Member }
const { lang, member: m } = Astro.props;
const t = dict('profil', lang);
const home = dict('home', lang);

const AV: Record<string, string> = { lead: 'var(--grad-signature)', fac: 'linear-gradient(135deg,var(--navy-500),var(--navy-700))', staff: 'linear-gradient(135deg,var(--red-500),var(--red-700))' };
const i = members.findIndex((x) => x.slug === m.slug);
const bio: string[] = (m.bio && m.bio[lang]) || [];
// Personal websites and LinkedIn are intentionally not shown (owner's decision).
const links = ((m.links || []) as { label: string; href: string }[]).filter((l) => !/linkedin|website|personal|situs/i.test(l.label + ' ' + l.href));
const p = {
  role: t.roles[m.role], group: t.groups[m.g], areaLabel: t.areas[m.area], avBg: AV[m.g],
  photoUrl: m.photo ? await img(m.photo, 720) : '',
  position: m.position ? m.position[lang] : '',
  edu: ((m.edu || []) as any[]).map((e) => ({ deg: e.deg, where: e.where[lang] })),
  interests: (m.interests || []) as string[],
  pubs: (m.pubs || []) as any[],
};
const nb = (k: number) => { const x = members[(i + k + members.length) % members.length]; return { name: x.name, href: url(lang, 'anggota/' + x.slug + '/') }; };
const prev = nb(-1), next = nb(1);
---
<BaseLayout lang={lang} path={`anggota/${m.slug}/`} active="anggota" title={`${m.name} — Lexin`} description={p.position || `${m.name}, ${p.role} — Lexin`}>

<section class="page-header">
  <img src={asset('assets/lexin-mark.png')} alt="" class="ph-mark" />
  <div class="container u-5ad733">
    <nav class="u-04f982" aria-label="Breadcrumb">
      <a href={url(lang, 'anggota/')} class="crumb"><Icon name="arrow-left" size={14} />{t.people}</a>
      <span class="u-5b795a">/</span>
      <span class="u-5b795a">{p.group}</span>
    </nav>
    <div class="hero-grid">
      <div class="photo" style={`background:${p.avBg}`}>
        <span class="u-38ccc7">{m.ini}</span>
        {p.photoUrl && <img src={p.photoUrl} alt={m.name} class="u-17e25e" />}
      </div>
      <div class="u-999047">
        <span class="eyebrow">{p.role}</span>
        <h1 class="u-8a62ec">{m.name}</h1>
        <span class="u-1451fe">{m.titles}</span>
        {p.position && <span class="u-1ea4ad">{p.position}</span>}
        <div class="u-cd6c2a">
          {m.tags.map((g: string) => <span class="u-444621">{g}</span>)}
        </div>
        <div class="u-e48f82">
          <Button variant="primary" iconLeft="mail" href={'mailto:' + m.email}>{m.email}</Button>
          {links.map((l) => <a href={l.href} class="ext-link" target="_blank" rel="noopener">{l.label}<Icon name="arrow-up-right" size={14} /></a>)}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="u-5cf619">
  <div class="container body-grid">
    <div class="u-edc1d0">
      <div class="u-f21b93">
        <h2 class="h-sub">{t.bio}</h2>
        {bio.map((para) => <p class="u-b41c80">{para}</p>)}
        {bio.length === 0 && <div class="u-af3fba">{t.bioPending}</div>}
      </div>
      {p.pubs.length > 0 && (
        <div class="u-f21b93">
          <h2 class="h-sub">{t.pubs}</h2>
          <div class="u-459fe4">
            {p.pubs.map((u) => (
              <a href={u.href} class="pub" target="_blank" rel="noopener">
                <span class="u-46a307">{u.year}</span>
                <span class="u-e6c996">
                  <span class="u-4fad8d">{u.title}</span>
                  <span class="u-16e09c">{u.venue}</span>
                </span>
                <span class="u-c6d710"><Icon name="arrow-up-right" size={16} /></span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
    <aside class="u-b68202">
      <div class="u-086c04">
        <span class="u-64fd1f">{t.atLexin}</span>
        <div class="u-fb7434"><span class="u-52547a">{t.roleLabel}</span><span class="u-9d8c3c">{p.role}</span></div>
        <div class="u-fb7434"><span class="u-52547a">{t.foundationLabel}</span><span class="u-9d8c3c">{p.areaLabel}</span></div>
      </div>
      {p.edu.length > 0 && (
        <div class="u-12e183">
          <span class="u-1dad34">{t.edu}</span>
          {p.edu.map((e) => (
            <div class="u-8141ff">
              <span class="u-e719ed"><Icon name="graduation-cap" size={18} /></span>
              <span class="u-1ec025"><span class="u-40e735">{e.deg}</span><span class="u-16e09c">{e.where}</span></span>
            </div>
          ))}
        </div>
      )}
      {p.interests.length > 0 && (
        <div class="u-bdbbd2">
          <span class="u-edb37f">{t.interests}</span>
          <div class="u-2075ff">
            {p.interests.map((g) => <span class="u-dbd782">{g}</span>)}
          </div>
        </div>
      )}
    </aside>
  </div>
</section>

<section class="u-5cf619">
  <div class="container u-3cd102">
    <a href={prev.href} class="pn">
      <Icon name="arrow-left" size={18} />
      <span class="u-e6c996"><span class="pn-lbl">{t.prev}</span><span class="u-cbcafe">{prev.name}</span></span>
    </a>
    <a href={next.href} class="pn u-432d1a">
      <span class="u-e6c996"><span class="pn-lbl">{t.next}</span><span class="u-cbcafe">{next.name}</span></span>
      <Icon name="arrow-right" size={18} />
    </a>
  </div>
</section>

</BaseLayout>

<style>
  .crumb { display: inline-flex; align-items: center; gap: 6px; color: var(--navy-600); }
  .crumb:hover { color: var(--red-600); }
  .hero-grid { display: grid; grid-template-columns: minmax(0,1fr); gap: 28px clamp(32px,5vw,56px); align-items: center; margin-top: clamp(24px,4vw,40px); }
  .photo { position: relative; width: 100%; max-width: 320px; aspect-ratio: 4/5; border-radius: 28px; overflow: hidden; box-shadow: var(--shadow-lg); }
  @media (min-width: 860px) {
    .hero-grid { grid-template-columns: minmax(0,360px) minmax(0,1fr); }
    .photo { max-width: 360px; }
  }
  .ext-link { height: 44px; padding: 0 16px; border-radius: 999px; background: var(--ink-0); box-shadow: inset 0 0 0 1px var(--border-subtle); display: inline-flex; align-items: center; gap: 6px; font: 600 14px/1 var(--font-display); color: var(--navy-900); white-space: nowrap; }
  .ext-link:hover { box-shadow: inset 0 0 0 1px var(--navy-300); color: var(--navy-600); }
  .body-grid { padding-top: clamp(48px,7vw,80px); padding-bottom: clamp(48px,7vw,80px); display: grid; grid-template-columns: minmax(0,1fr); gap: 40px clamp(32px,5vw,72px); align-items: start; }
  @media (min-width: 960px) { .body-grid { grid-template-columns: minmax(0,1fr) 340px; } }
  .h-sub { font: var(--type-h3); font-size: clamp(20px,2.2vw,24px); color: var(--text-heading); margin: 0; }
  .pub { display: grid; grid-template-columns: auto minmax(0,1fr) auto; gap: 14px; align-items: baseline; padding: 16px 12px; margin: 0 -12px; border-bottom: 1px solid var(--border-default); color: var(--text-heading); transition: background-color var(--dur-base) var(--ease-out) }
  .pub:hover { background: var(--navy-50); color: var(--text-heading) }
  .pn { border-top: 2px solid var(--navy-900); padding: 16px 4px 0; display: flex; align-items: center; gap: 14px; color: var(--text-heading) }
  .pn:hover { color: var(--navy-600) }
  .pn-lbl { font: 600 12px/1 var(--font-display); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--text-muted); }
  .u-5ad733 { position:relative;padding-top:clamp(28px,4vw,40px);padding-bottom:clamp(40px,6vw,64px); }
  .u-04f982 { display:flex;align-items:center;gap:8px;flex-wrap:wrap;font:600 13px/1 var(--font-display); }
  .u-5b795a { color:var(--text-muted); }
  .u-38ccc7 { position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font:700 clamp(56px,7vw,88px)/1 var(--font-display);color:var(--fg-on-dark); }
  .u-17e25e { position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:var(--ink-0);object-position:50% 0 }
  .u-999047 { display:flex;flex-direction:column;gap:14px;min-width:0; }
  .u-8a62ec { font:700 clamp(34px,5vw,52px)/1.08 var(--font-display);letter-spacing:var(--tracking-tight);margin:0;color:var(--text-heading);text-wrap:balance; }
  .u-1451fe { font:500 14px/1.5 var(--font-mono);color:var(--text-muted); }
  .u-1ea4ad { font:600 16px/1.45 var(--font-display);color:var(--navy-800);text-wrap:pretty; }
  .u-cd6c2a { display:flex;flex-wrap:wrap;gap:6px;margin-top:4px; }
  .u-444621 { font:500 12px/1.4 var(--font-mono);color:var(--navy-700);white-space:nowrap }
  .u-e48f82 { display:flex;flex-wrap:wrap;gap:10px;margin-top:10px; }
  .u-5cf619 { background:var(--surface-page); }
  .u-edc1d0 { display:flex;flex-direction:column;gap:clamp(36px,5vw,48px);min-width:0; }
  .u-f21b93 { display:flex;flex-direction:column;gap:14px; }
  .u-b41c80 { margin:0;font:var(--type-body-lg);color:var(--text-body);text-wrap:pretty; }
  .u-af3fba { border-radius:20px;border:2px dashed var(--navy-200);padding:20px;font:var(--type-body);color:var(--text-muted); }
  .u-459fe4 { display:flex;flex-direction:column;gap:10px; }
  .u-46a307 { font:500 12px/1.5 var(--font-mono);color:var(--red-600); }
  .u-e6c996 { display:flex;flex-direction:column;gap:4px;min-width:0; }
  .u-4fad8d { font:600 15px/1.4 var(--font-display);text-wrap:pretty; }
  .u-16e09c { font:var(--type-body-sm);color:var(--text-muted); }
  .u-c6d710 { color:var(--navy-500);display:flex; }
  .u-b68202 { display:flex;flex-direction:column;gap:20px;min-width:0; }
  .u-086c04 { border-top:2px solid var(--navy-900);padding:16px 0 0;display:flex;flex-direction:column;gap:14px }
  .u-64fd1f { font:600 12px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--navy-600); }
  .u-fb7434 { display:flex;flex-direction:column;gap:4px; }
  .u-52547a { font:600 12px/1 var(--font-display);color:var(--text-muted); }
  .u-9d8c3c { font:700 16px/1.35 var(--font-display);color:var(--text-heading); }
  .u-12e183 { border-top:2px solid var(--navy-900);padding:16px 0 0;display:flex;flex-direction:column;gap:4px }
  .u-1dad34 { font:600 12px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--text-muted);margin-bottom:8px; }
  .u-8141ff { display:flex;gap:12px;padding:12px 0;box-shadow:inset 0 -1px 0 var(--border-subtle); }
  .u-e719ed { color:var(--navy-500);display:flex;align-items:center;justify-content:center;flex-shrink:0 }
  .u-1ec025 { display:flex;flex-direction:column;gap:3px;min-width:0; }
  .u-40e735 { font:700 14px/1.3 var(--font-display);color:var(--text-heading); }
  .u-bdbbd2 { border-top:2px solid var(--navy-900);padding:16px 0 0;display:flex;flex-direction:column;gap:12px }
  .u-edb37f { font:600 12px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--text-muted); }
  .u-2075ff { display:flex;flex-wrap:wrap;gap:6px; }
  .u-dbd782 { font:500 13px/1.4 var(--font-mono);color:var(--navy-700) }
  .u-3cd102 { padding-bottom:clamp(56px,8vw,96px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:16px; }
  .u-cbcafe { font:700 16px/1.3 var(--font-display); }
  .u-432d1a { justify-content:flex-end;text-align:right; }
</style>
