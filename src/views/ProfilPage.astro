---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { dict, url, asset, type Lang } from '../lib/i18n';
import { members, type Member } from '../lib/content';
import { img } from '../lib/images';

interface Props { lang: Lang; member: Member }
const { lang, member: m } = Astro.props;
const t = dict('profil', lang);
const home = dict('home', lang);

const AV: Record<string, string> = { lead: 'var(--grad-signature)', fac: 'linear-gradient(135deg,var(--navy-500),var(--navy-700))', staff: 'linear-gradient(135deg,var(--red-500),var(--red-700))' };
const i = members.findIndex((x) => x.slug === m.slug);
const bio: string[] = (m.bio && m.bio[lang]) || [];
// Personal websites and LinkedIn are intentionally not shown (owner's decision).
const links = ((m.links || []) as { label: string; href: string }[]).filter((l) => !/linkedin|website|personal|situs/i.test(l.label + ' ' + l.href));
const p = {
  role: t.roles[m.role], group: t.groups[m.g], areaLabel: t.areas[m.area], avBg: AV[m.g],
  photoUrl: m.photo ? await img(m.photo, 720) : '',
  position: m.position ? m.position[lang] : '',
  edu: ((m.edu || []) as any[]).map((e) => ({ deg: e.deg, where: e.where[lang] })),
  interests: (m.interests || []) as string[],
  pubs: (m.pubs || []) as any[],
};
const nb = (k: number) => { const x = members[(i + k + members.length) % members.length]; return { name: x.name, href: url(lang, 'anggota/' + x.slug + '/') }; };
const prev = nb(-1), next = nb(1);
---
<BaseLayout lang={lang} path={`anggota/${m.slug}/`} active="anggota" title={`${m.name} — Lexin`} description={p.position || `${m.name}, ${p.role} — Lexin`}>

<section class="page-header">
  <img src={asset('assets/lexin-mark.png')} alt="" class="ph-mark" />
  <div class="container" style="position:relative;padding-top:clamp(28px,4vw,40px);padding-bottom:clamp(40px,6vw,64px)">
    <nav style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;font:600 13px/1 var(--font-display)" aria-label="Breadcrumb">
      <a href={url(lang, 'anggota/')} class="crumb"><Icon name="arrow-left" size={14} />{t.people}</a>
      <span style="color:var(--text-muted)">/</span>
      <span style="color:var(--text-muted)">{p.group}</span>
    </nav>
    <div class="hero-grid">
      <div class="photo" style={`background:${p.avBg}`}>
        <span style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font:700 clamp(56px,7vw,88px)/1 var(--font-display);color:#FFFFFF">{m.ini}</span>
        {p.photoUrl && <img src={p.photoUrl} alt={m.name} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#FFFFFF" />}
      </div>
      <div style="display:flex;flex-direction:column;gap:14px;min-width:0">
        <span class="eyebrow">{p.role}</span>
        <h1 style="font:700 clamp(34px,5vw,52px)/1.08 var(--font-display);letter-spacing:var(--tracking-tight);margin:0;color:var(--text-heading);text-wrap:balance">{m.name}</h1>
        <span style="font:500 14px/1.5 var(--font-mono);color:var(--text-muted)">{m.titles}</span>
        {p.position && <span style="font:600 16px/1.45 var(--font-display);color:var(--navy-800);text-wrap:pretty">{p.position}</span>}
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px">
          {m.tags.map((g: string) => <span style="height:28px;padding:0 12px;border-radius:999px;background:#FFFFFF;box-shadow:inset 0 0 0 1px var(--navy-200);color:var(--navy-700);font:600 12.5px/28px var(--font-display);white-space:nowrap">{g}</span>)}
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:10px">
          <Button variant="primary" iconLeft="mail" href={'mailto:' + m.email}>{m.email}</Button>
          {links.map((l) => <a href={l.href} class="ext-link" target="_blank" rel="noopener">{l.label}<Icon name="arrow-up-right" size={14} /></a>)}
        </div>
      </div>
    </div>
  </div>
</section>

<section style="background:var(--surface-page)">
  <div class="container body-grid">
    <div style="display:flex;flex-direction:column;gap:clamp(36px,5vw,48px);min-width:0">
      <div style="display:flex;flex-direction:column;gap:14px">
        <h2 class="h-sub">{t.bio}</h2>
        {bio.map((para) => <p style="margin:0;font:var(--type-body-lg);color:var(--text-body);text-wrap:pretty">{para}</p>)}
        {bio.length === 0 && <div style="border-radius:20px;border:2px dashed var(--navy-200);padding:20px;font:var(--type-body);color:var(--text-muted)">{t.bioPending}</div>}
      </div>
      {p.pubs.length > 0 && (
        <div style="display:flex;flex-direction:column;gap:14px">
          <h2 class="h-sub">{t.pubs}</h2>
          <div style="display:flex;flex-direction:column;gap:10px">
            {p.pubs.map((u) => (
              <a href={u.href} class="pub" target="_blank" rel="noopener">
                <span style="font:500 12px/1.5 var(--font-mono);color:var(--red-600)">{u.year}</span>
                <span style="display:flex;flex-direction:column;gap:4px;min-width:0">
                  <span style="font:600 15px/1.4 var(--font-display);text-wrap:pretty">{u.title}</span>
                  <span style="font:var(--type-body-sm);color:var(--text-muted)">{u.venue}</span>
                </span>
                <span style="color:var(--navy-500);display:flex"><Icon name="arrow-up-right" size={16} /></span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
    <aside style="display:flex;flex-direction:column;gap:20px;min-width:0">
      <div style="border-radius:var(--radius-xl);background:var(--navy-50);box-shadow:inset 0 0 0 1px var(--navy-200);padding:24px;display:flex;flex-direction:column;gap:14px">
        <span style="font:600 11px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--navy-600)">{t.atLexin}</span>
        <div style="display:flex;flex-direction:column;gap:4px"><span style="font:600 12px/1 var(--font-display);color:var(--text-muted)">{t.roleLabel}</span><span style="font:700 16px/1.35 var(--font-display);color:var(--text-heading)">{p.role}</span></div>
        <div style="display:flex;flex-direction:column;gap:4px"><span style="font:600 12px/1 var(--font-display);color:var(--text-muted)">{t.foundationLabel}</span><span style="font:700 16px/1.35 var(--font-display);color:var(--text-heading)">{p.areaLabel}</span></div>
      </div>
      {p.edu.length > 0 && (
        <div style="border-radius:var(--radius-xl);background:var(--surface-card);box-shadow:var(--shadow-md);padding:24px;display:flex;flex-direction:column;gap:4px">
          <span style="font:600 11px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--text-muted);margin-bottom:8px">{t.edu}</span>
          {p.edu.map((e) => (
            <div style="display:flex;gap:12px;padding:12px 0;box-shadow:inset 0 -1px 0 var(--border-subtle)">
              <span style="width:36px;height:36px;border-radius:11px;background:var(--navy-50);color:var(--navy-500);display:flex;align-items:center;justify-content:center;flex-shrink:0"><Icon name="graduation-cap" size={18} /></span>
              <span style="display:flex;flex-direction:column;gap:3px;min-width:0"><span style="font:700 14px/1.3 var(--font-display);color:var(--text-heading)">{e.deg}</span><span style="font:var(--type-body-sm);color:var(--text-muted)">{e.where}</span></span>
            </div>
          ))}
        </div>
      )}
      {p.interests.length > 0 && (
        <div style="border-radius:var(--radius-xl);background:var(--surface-card);box-shadow:var(--shadow-md);padding:24px;display:flex;flex-direction:column;gap:12px">
          <span style="font:600 11px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--text-muted)">{t.interests}</span>
          <div style="display:flex;flex-wrap:wrap;gap:6px">
            {p.interests.map((g) => <span style="padding:6px 12px;border-radius:999px;background:var(--navy-50);color:var(--navy-700);font:600 12.5px/1.3 var(--font-display)">{g}</span>)}
          </div>
        </div>
      )}
    </aside>
  </div>
</section>

<section style="background:var(--surface-page)">
  <div class="container" style="padding-bottom:clamp(56px,8vw,96px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:16px">
    <a href={prev.href} class="pn">
      <Icon name="arrow-left" size={18} />
      <span style="display:flex;flex-direction:column;gap:4px;min-width:0"><span class="pn-lbl">{t.prev}</span><span style="font:700 16px/1.3 var(--font-display)">{prev.name}</span></span>
    </a>
    <a href={next.href} class="pn" style="justify-content:flex-end;text-align:right">
      <span style="display:flex;flex-direction:column;gap:4px;min-width:0"><span class="pn-lbl">{t.next}</span><span style="font:700 16px/1.3 var(--font-display)">{next.name}</span></span>
      <Icon name="arrow-right" size={18} />
    </a>
  </div>
</section>

</BaseLayout>

<style>
  .crumb { display: inline-flex; align-items: center; gap: 6px; color: var(--navy-600); }
  .crumb:hover { color: var(--red-600); }
  .hero-grid { display: grid; grid-template-columns: minmax(0,1fr); gap: 28px clamp(32px,5vw,56px); align-items: center; margin-top: clamp(24px,4vw,40px); }
  .photo { position: relative; width: 100%; max-width: 320px; aspect-ratio: 4/5; border-radius: 28px; overflow: hidden; box-shadow: var(--shadow-lg); }
  @media (min-width: 860px) {
    .hero-grid { grid-template-columns: minmax(0,360px) minmax(0,1fr); }
    .photo { max-width: 360px; }
  }
  .ext-link { height: 44px; padding: 0 16px; border-radius: 999px; background: #FFFFFF; box-shadow: inset 0 0 0 1px var(--border-subtle); display: inline-flex; align-items: center; gap: 6px; font: 600 14px/1 var(--font-display); color: var(--navy-900); white-space: nowrap; }
  .ext-link:hover { box-shadow: inset 0 0 0 1px var(--navy-300); color: var(--navy-600); }
  .body-grid { padding-top: clamp(48px,7vw,80px); padding-bottom: clamp(48px,7vw,80px); display: grid; grid-template-columns: minmax(0,1fr); gap: 40px clamp(32px,5vw,72px); align-items: start; }
  @media (min-width: 960px) { .body-grid { grid-template-columns: minmax(0,1fr) 340px; } }
  .h-sub { font: var(--type-h3); font-size: clamp(20px,2.2vw,24px); color: var(--text-heading); margin: 0; }
  .pub { display: grid; grid-template-columns: auto minmax(0,1fr) auto; gap: 14px; align-items: baseline; padding: 16px 18px; border-radius: 18px; background: var(--surface-card); box-shadow: inset 0 0 0 1px var(--border-subtle); color: var(--text-heading); transition: box-shadow .2s; }
  .pub:hover { box-shadow: inset 0 0 0 1px var(--navy-300), var(--shadow-md); color: var(--text-heading); }
  .pn { border-radius: var(--radius-xl); box-shadow: inset 0 0 0 1px var(--border-subtle); padding: 20px 22px; display: flex; align-items: center; gap: 14px; color: var(--text-heading); }
  .pn:hover { box-shadow: inset 0 0 0 1px var(--navy-300); color: var(--navy-600); }
  .pn-lbl { font: 600 11px/1 var(--font-display); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--text-muted); }
</style>
