---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import Icon from '../components/Icon.astro';
import { dict, url, asset, fmtDate, type Lang } from '../lib/i18n';
import { allPubs, postsByDate, pubKind } from '../lib/content';
import { img } from '../lib/images';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict('home', lang);

const ICON: Record<string, string> = { verified: 'badge-check', handshake: 'handshake', policy: 'shield-check', gavel: 'gavel', balance: 'scale', terminal: 'terminal', account_balance: 'landmark', school: 'graduation-cap', description: 'file-text', hub: 'network' };
const SHY: Record<string, string> = { Perselisihan: 'Perse­lisihan', Pengadilan: 'Penga­dilan', Governance: 'Gover­nance', Regulation: 'Regu­lation', Judgement: 'Judge­ment', Relations: 'Rela­tions', Disputes: 'Dis­putes' };

const areas = t.areas.map((a: string[], i: number) => {
  const mitra = a[4];
  const mitraLogo = /PSHTN/.test(mitra || '') ? 'assets/partners/pshtn.png' : /Kem(e)?naker/.test(mitra || '') ? 'assets/partners/kemnaker.png' : '';
  return {
    icon: ICON[a[0]] || a[0], title: a[1], q: a[2], m: a[3], mitra, mitraLogo,
    mitraLogoW: /pshtn/.test(mitraLogo) ? '18px' : '76px',
    num: '0' + (i + 1), href: url(lang, 'riset/#area-' + (i + 1)),
    short: a[1].split(' ').map((x) => SHY[x] || x).join(' '),
  };
});

// Detail text for each clickable part of the "how we work" diagram.
const details: Record<string, { eyebrow: string; title: string; body: string; link: string; href: string }> = {};
const detailHref: Record<string, string> = { products: url(lang, 'produk/'), partner: url(lang, 'partisipasi/'), foundations: url(lang, 'riset/#fondasi'), infra: url(lang, 'riset/#infrastruktur') };
for (const k of ['products', 'partner', 'foundations', 'infra']) {
  const d = t.details[k];
  details[k] = { eyebrow: d[0], title: d[1], body: d[2], link: d[3], href: detailHref[k] };
}
areas.forEach((a: any, i: number) => { details['a' + i] = { eyebrow: t.details.areaEyebrow + ' ' + a.num, title: a.title, body: a.q, link: t.details.areaLink, href: a.href }; });
const initial = details.products;

const products = t.products.map((p: any, i: number) => ({ ...p, href: url(lang, i === 0 ? 'produk/#klaussa' : 'produk/#fiskallink'), icon: ICON[p.icon] || p.icon, tone: i === 0 ? 'success' : 'yellow' }));
const audiences = t.audiences.map((a: any, i: number) => ({ ...a, href: url(lang, 'partisipasi/#' + ['mitra-riset', 'data-kode', 'lembaga', 'fellowship'][i]), icon: ICON[a.icon] || a.icon }));
const clients = await Promise.all(t.clients.map(async (c: any) => ({ ...c, photoUrl: c.photo ? await img(c.photo, 720) : '' })));

// "Terbaru": the two newest posts plus the two newest publications, built from content at build time.
const KIND = { book: { id: 'BUKU', en: 'BOOK' }, journal: { id: 'JURNAL', en: 'JOURNAL' }, conf: { id: 'KONFERENSI', en: 'CONFERENCE' } } as const;
const latest = [
  ...postsByDate().slice(0, 2).map((p) => ({ type: lang === 'id' ? 'WAWASAN' : 'INSIGHTS', meta: fmtDate(p.date, lang), title: (p.title as any)[lang] || p.title.id, href: url(lang, 'wawasan/' + p.slug + '/') })),
  ...allPubs().sort((a, b) => +b.year - +a.year).slice(0, 2).map((p) => ({ type: KIND[pubKind(p.venue)][lang], meta: p.year + ' · ' + p.venue.split(',')[0].split(':')[0], title: p.title, href: p.href || url(lang, 'publikasi/') })),
];

const ci = t.tagline.indexOf(', ');
const tagA = t.tagline.slice(0, ci + 1), tagB = t.tagline.slice(ci + 2);
---
<BaseLayout lang={lang} path="" title={lang === 'id' ? 'Lexin — Pusat Informatika Hukum Universitas Indonesia' : 'Lexin — Universitas Indonesia Center for Legal Informatics'}>

<section class="hero on-dark">
  <img src={asset('assets/lexin-mark.png')} alt="" class="hero-mark" />
  <div class="container hero-grid">
    <div>
      <p class="hero-eyebrow">{t.heroEyebrow}</p>
      <h1 class="hero-h1">{tagA} <span class="ember-text">{tagB}</span></h1>
      <p class="hero-body">{t.heroBody}</p>
      <div class="hero-ctas">
        <Button variant="gradient" size="lg" iconRight="arrow-right" href={url(lang, 'riset/')}>{t.ctaResearch}</Button>
        <Button variant="inverse" size="lg" href={url(lang, 'partisipasi/')}>{t.ctaPartner}</Button>
      </div>
    </div>

    <div class="diagram" data-details={JSON.stringify(details)}>
      <div class="diagram-head">
        <span class="lbl">{t.diagramLabel}</span>
        <span class="hint"><Icon name="mouse-pointer-click" size={15} />{t.diagramHint}</span>
      </div>
      <div class="house">
        <button type="button" class="roof part sel" data-k="products" aria-label={t.roof}>
          <span class="roof-inner">
            <span class="roof-lbl">{t.roof}</span>
            <span class="roof-chips">
              <span class="rchip">Klaussa</span>
              <span class="rchip">FiskalLink</span>
              <span class="rchip ghost">{t.moreDev}</span>
            </span>
          </span>
        </button>
        <div class="rule-row">
          <span class="rule-lbl">{t.pillarsLabel}</span>
          <span class="rule"></span>
        </div>
        <div class="pillars">
          {areas.map((a: any, i: number) => (
            <button type="button" class="pillar part" data-k={'a' + i}>
              <Icon name={a.icon} size={20} />
              <span class="pillar-txt">
                <span class="pnum">{a.num}</span>
                <span class="pshort"><span class="shy">{a.short}</span><span class="noshy">{a.title}</span></span>
              </span>
            </button>
          ))}
          <button type="button" class="pillar partner part" data-k="partner">
            <Icon name="plus" size={20} />
            <span class="pillar-txt">
              <span class="partner-t">{t.yourArea}</span>
              <span class="partner-s">{t.partnerWithUs}</span>
            </span>
          </button>
        </div>
        <button type="button" class="found part" data-k="foundations">
          <span class="found-text"><span class="found-lbl">{t.foundationLabel}</span><span class="found-name">Legal AI Foundations</span></span>
          <span class="found-chips">
            {t.foundationChips.map((c: string) => <span class="fchip">{c}</span>)}
          </span>
        </button>
        <button type="button" class="infra part" data-k="infra">
          <span class="infra-top"></span>
          <span class="infra-body">
            <span class="infra-eyebrow">{t.infraEyebrow}</span>
            <span class="infra-label">{t.infraLabel}</span>
          </span>
        </button>
        <div class="pop" hidden>
          <span class="notch"></span>
          <div class="pop-head">
            <div class="pop-eyebrow" data-f="eyebrow"></div>
            <button type="button" class="pop-x" aria-label={lang === 'id' ? 'Tutup' : 'Close'}><Icon name="x" size={16} /></button>
          </div>
          <div class="pop-title" data-f="title"></div>
          <p class="pop-body" data-f="body"></p>
          <a class="lx-btn lx-btn--link" data-f="link" href="#"><span data-f="linkText"></span><span class="lx-btn__r"><Icon name="arrow-right" size={17} /></span></a>
        </div>
      </div>
      <div class="selected">
        <div class="sel-head">
          <span class="sel-lbl"><Icon name="mouse-pointer-click" size={14} />{t.selectedLabel}</span>
          <span class="rule"></span>
        </div>
        <div class="sel-card">
          <div class="sel-main">
            <div class="sel-eyebrow" data-f="eyebrow">{initial.eyebrow}</div>
            <div class="sel-title" data-f="title">{initial.title}</div>
            <p class="sel-body" data-f="body">{initial.body}</p>
          </div>
          <a href={initial.href} class="sel-link" data-f="link"><span data-f="linkText">{initial.link}</span><Icon name="arrow-right" size={16} /></a>
        </div>
      </div>
    </div>
  </div>
  <div class="stripe"></div>
</section>

<section class="band-page">
  <div class="container sec">
    <div class="intro-grid">
      <div>
        <div class="eyebrow">{t.researchEyebrow}</div>
        <h2 class="h-sec">{t.researchTitle}</h2>
      </div>
      <div class="intro-side">
        <p class="lede">{t.researchBody}</p>
        <Button variant="secondary" iconRight="arrow-right" href={url(lang, 'riset/')}>{t.researchCta}</Button>
      </div>
    </div>
    <ol class="area-list">
      {areas.map((a: any) => (
        <li>
          <a href={a.href} class="area-row">
            <span class="area-num">{a.num}</span>
            <span class="area-main">
              <span class="area-title">{a.title}</span>
              <span class="area-q">{a.q}</span>
            </span>
            <span class="area-meta">
              <span class="mini-lbl">{t.methods}</span>
              <span class="area-methods">{a.m}</span>
            </span>
            <span class="area-mitra">
              {a.mitra && <span class="mini-lbl">{t.mitraLabel}</span>}
              {a.mitra && (
                <span class="mitra">
                  {a.mitraLogo && <span role="img" aria-label={a.mitra} class="mitra-logo" style={`--w:${a.mitraLogoW};background-image:url("${asset(a.mitraLogo)}")`}></span>}
                  <span class="mitra-name">{a.mitra}</span>
                </span>
              )}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="band-mist">
  <div class="container sec">
    <div class="sec-head">
      <div>
        <div class="eyebrow">{t.productsEyebrow}</div>
        <h2 class="h-sec">{t.productsTitle}</h2>
      </div>
      <Button variant="secondary" iconRight="arrow-right" href={url(lang, 'produk/')}>{t.allProducts}</Button>
    </div>
    <div class="prod-grid">
      {products.map((p: any) => (
        <div class="prod-card">
          <div class="prod-head on-dark">
            <span class="prod-icon"><Icon name={p.icon} size={34} /></span>
            <span class="prod-name">{p.name}</span>
          </div>
          <div class="prod-body">
            <div class="prod-status"><Badge tone={p.tone} variant="soft" dot>{p.status}</Badge></div>
            <p class="prod-desc">{p.desc}</p>
            <ul class="recog-list">
              {p.recog.map((r: string) => <li class="recog"><Icon name="award" size={14} />{r}</li>)}
            </ul>
            <div class="prod-cta"><Button variant="link" iconRight="arrow-right" href={p.href}>{p.cta}</Button></div>
          </div>
        </div>
      ))}
    </div>
    <p class="disclaimer">
      <Icon name="info" size={16} />
      <span>{t.disclaimer}</span>
    </p>
  </div>
</section>

<section class="band-page">
  <div class="container sec train-grid">
    <div>
      <div class="eyebrow">{t.trainEyebrow}</div>
      <h2 class="h-sec h-sec--sm">{t.trainTitle}</h2>
      <p class="lede lede--spaced">{t.trainBody}</p>
      <div class="train-cta">
        <Button variant="primary" size="lg" iconRight="arrow-right" href="mailto:hadiputra@cs.ui.ac.id">{t.trainCta}</Button>
      </div>
    </div>
    <div class="client-grid">
      {clients.map((c: any) => (
        <figure class="client">
          {c.photoUrl && <div role="img" aria-label={c.name} class="client-photo" style={`background-image:url(${c.photoUrl})`}></div>}
          <figcaption>
            <span class="client-code">{c.code}</span>
            <h3 class="client-name">{c.name}</h3>
            <p class="client-body">{c.body}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<section class="partners">
  <div class="container partners-grid">
    <div class="eyebrow eyebrow--muted">{t.partnersLabel}</div>
    <ul class="partner-row">
      {t.partners.map((p: any) => (
        <li class="partner-cell">
          <span class="partner-logo" role="img" aria-label={p.long} style={`background-image:url("${asset(p.logo)}")`}></span>
          <span class="partner-short">{p.short}</span>
          <span class="partner-long">{p.long}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="band-page">
  <div class="container sec">
    <div class="eyebrow">{t.eventsEyebrow}</div>
    <h2 class="h-sec">{t.eventsTitle}</h2>
    <div class="events-grid">
      <div class="forum on-dark">
        <img src={asset('assets/lexin-mark.png')} alt="" class="forum-mark" />
        <div class="forum-top">
          <Badge tone="yellow" variant="solid">{t.flagship}</Badge>
          <span class="forum-dates">{t.datesTbc}</span>
        </div>
        <h3 class="forum-h">Lexin <span class="ember-text">Forum</span></h3>
        <p class="forum-body">{t.forumBody}</p>
        <div class="forum-cta">
          <Button variant="inverse" iconRight="bell" href="mailto:hadiputra@cs.ui.ac.id?subject=Lexin%20Forum">{t.forumCta}</Button>
        </div>
      </div>
      <div class="latest-col">
        <div class="latest-head">
          <span class="eyebrow eyebrow--muted">{t.latestLabel}</span>
          <span class="latest-links">
            <Button variant="link" iconRight="arrow-right" href={url(lang, 'wawasan/')}>{t.allInsights}</Button>
            <Button variant="link" iconRight="arrow-right" href={url(lang, 'publikasi/')}>{t.allPubs}</Button>
          </span>
        </div>
        <ul class="latest-list">
          {latest.map((n) => (
            <li>
              <a href={n.href} class="latest" target={/^https?:/.test(n.href) ? '_blank' : undefined} rel={/^https?:/.test(n.href) ? 'noopener' : undefined}>
                <span class="latest-meta"><span class="latest-type">{n.type}</span><span aria-hidden="true">·</span><span class="latest-date">{n.meta}</span></span>
                <span class="latest-title">{n.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="band-mist">
  <div class="container sec">
    <div class="sec-head">
      <div class="work-head">
        <div class="eyebrow">{t.workEyebrow}</div>
        <h2 class="h-sec">{t.workTitle}</h2>
      </div>
      <div class="work-contact">
        <span class="work-person"><span class="work-name">Dr. Panca Hadi Putra</span><span class="work-mail">hadiputra@cs.ui.ac.id</span></span>
        <Button variant="gradient" size="lg" iconRight="arrow-right" href={url(lang, 'kontak/')}>{t.contactUs}</Button>
      </div>
    </div>
    <ul class="aud-grid">
      {audiences.map((a: any) => (
        <li class="aud">
          <h3 class="aud-title">{a.title}</h3>
          <p class="aud-body">{a.body}</p>
          <div class="aud-cta"><Button variant="link" iconRight="arrow-right" href={a.href}>{a.cta}</Button></div>
        </li>
      ))}
    </ul>
  </div>
</section>

</BaseLayout>

<script>
  // "Cara kami bekerja" house diagram: select a part, show its detail.
  // ≥1120px: a popover next to the part (only after a click). Narrower: the "selected" card under the diagram.
  import { fadeIn } from '../scripts/motion';
  const root = document.querySelector<HTMLElement>('.diagram');
  if (root) {
    const details = JSON.parse(root.dataset.details || '{}');
    const house = root.querySelector<HTMLElement>('.house')!;
    const pop = root.querySelector<HTMLElement>('.pop')!;
    const notch = pop.querySelector<HTMLElement>('.notch')!;
    const card = root.querySelector<HTMLElement>('.sel-card')!;
    const wide = matchMedia('(min-width: 1120px)');

    const fill = (el: HTMLElement, d: any) => {
      el.querySelector<HTMLElement>('[data-f="eyebrow"]')!.textContent = d.eyebrow;
      el.querySelector<HTMLElement>('[data-f="title"]')!.textContent = d.title;
      el.querySelector<HTMLElement>('[data-f="body"]')!.textContent = d.body;
      el.querySelector<HTMLElement>('[data-f="linkText"]')!.textContent = d.link;
      el.querySelector<HTMLAnchorElement>('[data-f="link"]')!.href = d.href;
    };

    const place = (part: HTMLElement, k: string) => {
      const r = part.getBoundingClientRect(), hr = house.getBoundingClientRect();
      const W = hr.width, cx = r.left - hr.left + r.width / 2;
      const cw = Math.min(360, W * 0.94);
      const left = Math.max(0, Math.min(cx - cw / 2, W - cw));
      const above = k === 'foundations' || k === 'infra';
      pop.style.width = cw + 'px';
      pop.style.left = left + 'px';
      pop.style.top = (above ? r.top - hr.top - 12 : r.bottom - hr.top + 12) + 'px';
      pop.style.transform = above ? 'translateY(-100%)' : 'none';
      notch.style.left = Math.max(20, Math.min(cx - left, cw - 20)) + 'px';
      notch.style.top = above ? 'calc(100% - 7px)' : '-6px';
    };

    root.querySelectorAll<HTMLElement>('.part').forEach((part) => {
      part.addEventListener('click', () => {
        const k = part.dataset.k!;
        root.querySelectorAll('.part').forEach((p) => p.classList.toggle('sel', p === part));
        fill(card, details[k]);
        if (wide.matches) { fill(pop, details[k]); pop.hidden = false; place(part, k); fadeIn(pop); }
      });
    });
    pop.querySelector('.pop-x')!.addEventListener('click', (e) => { e.stopPropagation(); pop.hidden = true; });
    wide.addEventListener('change', () => { pop.hidden = true; });
  }
</script>

<style>
  /* Hallmark · pre-emit critique: P4 H4 E4 S4 R4 V4 · redesign in place, brand tokens kept (Poppins/Plus Jakarta/Lexin indigo-red-yellow) · structure: ruled-row areas, 2 product cards, captioned photos, ruled news list, ruled audience columns · gradient text removed · reduced-motion global */
  /* Hero: dark night surface, left-aligned copy, diagram right. */
  .hero { background: var(--grad-night); color: var(--fg-on-dark); position: relative; overflow: hidden; }
  .hero-mark { position: absolute; left: clamp(-160px,-8vw,-60px); bottom: clamp(-200px,-12vw,-80px); height: clamp(320px,42vw,620px); opacity: .08; filter: brightness(0) invert(1); pointer-events: none; max-width: none; }
  .hero-grid { position: relative; padding-top: clamp(40px,7vw,72px); padding-bottom: clamp(56px,9.5vw,104px); display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,480px),1fr)); gap: clamp(40px,6vw,64px); align-items: center; }
  .hero-eyebrow { margin: 0; padding-left: var(--space-4); border-left: 3px solid var(--yellow-400); font: 600 clamp(11px,2.9vw,12px)/1.4 var(--font-display); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--yellow-300); }
  .hero-h1 { font: 700 clamp(38px,6.4vw,64px)/1.06 var(--font-display); letter-spacing: var(--tracking-tight); margin: var(--space-6) 0 0; color: var(--fg-on-dark); text-wrap: balance; overflow-wrap: anywhere; min-width: 0; }
  .hero-body { font: var(--type-body-lg); margin: var(--space-6) 0 0; color: var(--fg-on-dark-2); max-width: 520px; text-wrap: pretty; }
  .hero-ctas { display: flex; gap: var(--space-3); margin-top: var(--space-10); flex-wrap: wrap; }

  .diagram { background: var(--on-dark-fill); box-shadow: inset 0 0 0 1px var(--on-dark-line); border-radius: var(--radius-xl); padding: clamp(14px,3vw,28px); }
  .diagram-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-2); margin-bottom: var(--space-5); }
  .diagram-head .lbl { font: 600 12px/1 var(--font-display); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--fg-on-dark-2); }
  .diagram-head .hint { font: 500 13px/1 var(--font-sans); color: var(--fg-on-dark-2); display: flex; align-items: center; gap: 6px; }
  .house { position: relative; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .part { border: 0; font: inherit; color: inherit; text-align: inherit; cursor: pointer; }
  .part:focus-visible { outline: 2px solid var(--yellow-300); outline-offset: 3px; }
  .roof { width: 104%; padding: 2px; clip-path: polygon(50% 0,100% 62%,100% 100%,0 100%,0 62%); background: var(--navy-400); display: block; }
  .roof.sel { background: var(--ink-0); }
  .roof-inner { background: linear-gradient(180deg,var(--navy-500),var(--navy-700)); clip-path: polygon(50% 0,100% 62%,100% 100%,0 100%,0 62%); padding: 64px var(--space-5) var(--space-4); display: flex; flex-direction: column; align-items: center; gap: var(--space-3); }
  .roof-lbl { font: 600 12px/1 var(--font-display); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--yellow-300); }
  .roof-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
  .rchip, .fchip { height: 28px; padding: 0 var(--space-3); border-radius: var(--radius-xs); background: var(--ink-0); color: var(--navy-800); font: 600 13px/28px var(--font-display); white-space: nowrap; }
  .fchip { height: 26px; font-size: 12px; line-height: 26px; padding: 0 10px; }
  .rchip.ghost { background: transparent; box-shadow: inset 0 0 0 1px var(--on-dark-line-2); color: var(--fg-on-dark); font: 500 13px/28px var(--font-sans); }
  .rule-row, .sel-head { width: 100%; display: flex; align-items: center; gap: 10px; margin-top: var(--space-1); }
  .rule-lbl { font: 600 12px/1 var(--font-display); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--yellow-300); white-space: nowrap; }
  .rule { flex: 1; height: 1px; background: var(--on-dark-rule); }
  .pillars { width: 100%; display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: var(--space-2); }
  .pillar { height: 188px; border-radius: var(--radius-lg); padding: 14px var(--space-3); display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; background: var(--pillar-fill); color: var(--fg-on-dark); box-shadow: inset 0 0 0 1px var(--pillar-line); transition: background-color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .pillar.sel { background: var(--ink-0); color: var(--navy-800); }
  .pillar-txt { display: flex; flex-direction: column; gap: 6px; }
  .pnum { font: 500 12px/1 var(--font-mono); opacity: .75; }
  .pshort { font: 600 13px/1.25 var(--font-display); hyphens: manual; overflow-wrap: anywhere; }
