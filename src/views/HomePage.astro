---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import Icon from '../components/Icon.astro';
import { dict, url, asset, fmtDate, type Lang } from '../lib/i18n';
import { allPubs, postsByDate, pubKind } from '../lib/content';
import { img } from '../lib/images';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict('home', lang);

const ICON: Record<string, string> = { verified: 'badge-check', handshake: 'handshake', policy: 'shield-check', gavel: 'gavel', balance: 'scale', terminal: 'terminal', account_balance: 'landmark', school: 'graduation-cap', description: 'file-text', hub: 'network' };
const TILES = [['var(--navy-50)', 'var(--navy-500)'], ['var(--red-50)', 'var(--red-500)'], ['var(--yellow-100)', 'var(--yellow-700)'], ['var(--grad-signature)', '#FFFFFF']];
const SHY: Record<string, string> = { Perselisihan: 'Perse­lisihan', Pengadilan: 'Penga­dilan', Governance: 'Gover­nance', Regulation: 'Regu­lation', Judgement: 'Judge­ment', Relations: 'Rela­tions', Disputes: 'Dis­putes' };

const areas = t.areas.map((a: string[], i: number) => {
  const mitra = a[4];
  const mitraLogo = /PSHTN/.test(mitra || '') ? 'assets/partners/pshtn.png' : /Kem(e)?naker/.test(mitra || '') ? 'assets/partners/kemnaker.png' : '';
  return {
    icon: ICON[a[0]] || a[0], title: a[1], q: a[2], m: a[3], mitra, mitraLogo,
    mitraLogoW: /pshtn/.test(mitraLogo) ? '18px' : '76px',
    num: '0' + (i + 1), href: url(lang, 'riset/#area-' + (i + 1)), tileBg: TILES[i][0], tileFg: TILES[i][1],
    short: a[1].split(' ').map((x) => SHY[x] || x).join(' '),
  };
});

// Detail text for each clickable part of the "how we work" diagram.
const details: Record<string, { eyebrow: string; title: string; body: string; link: string; href: string }> = {};
const detailHref: Record<string, string> = { products: url(lang, 'produk/'), partner: url(lang, 'partisipasi/'), foundations: url(lang, 'riset/#fondasi'), infra: url(lang, 'riset/#infrastruktur') };
for (const k of ['products', 'partner', 'foundations', 'infra']) {
  const d = t.details[k];
  details[k] = { eyebrow: d[0], title: d[1], body: d[2], link: d[3], href: detailHref[k] };
}
areas.forEach((a: any, i: number) => { details['a' + i] = { eyebrow: t.details.areaEyebrow + ' ' + a.num, title: a.title, body: a.q, link: t.details.areaLink, href: a.href }; });
const initial = details.products;

const products = t.products.map((p: any, i: number) => ({ ...p, href: url(lang, i === 0 ? 'produk/#klaussa' : 'produk/#fiskallink'), icon: ICON[p.icon] || p.icon, tone: i === 0 ? 'success' : 'yellow' }));
const audiences = t.audiences.map((a: any, i: number) => ({ ...a, href: url(lang, 'partisipasi/#' + ['mitra-riset', 'data-kode', 'lembaga', 'fellowship'][i]), icon: ICON[a.icon] || a.icon, tileBg: TILES[i][0], tileFg: TILES[i][1] }));
const clients = await Promise.all(t.clients.map(async (c: any) => ({ ...c, photoUrl: c.photo ? await img(c.photo, 720) : '' })));

// "Terbaru": the two newest posts plus the two newest publications, built from content at build time.
const KIND = { book: { id: 'BUKU', en: 'BOOK' }, journal: { id: 'JURNAL', en: 'JOURNAL' }, conf: { id: 'KONFERENSI', en: 'CONFERENCE' } } as const;
const latest = [
  ...postsByDate().slice(0, 2).map((p) => ({ type: lang === 'id' ? 'WAWASAN' : 'INSIGHTS', meta: fmtDate(p.date, lang), title: (p.title as any)[lang] || p.title.id, href: url(lang, 'wawasan/' + p.slug + '/') })),
  ...allPubs().sort((a, b) => +b.year - +a.year).slice(0, 2).map((p) => ({ type: KIND[pubKind(p.venue)][lang], meta: p.year + ' · ' + p.venue.split(',')[0].split(':')[0], title: p.title, href: p.href || url(lang, 'publikasi/') })),
];

const ci = t.tagline.indexOf(', ');
const tagA = t.tagline.slice(0, ci + 1), tagB = t.tagline.slice(ci + 2);
---
<BaseLayout lang={lang} path="" title={lang === 'id' ? 'Lexin — Pusat Informatika Hukum Universitas Indonesia' : 'Lexin — Universitas Indonesia Center for Legal Informatics'}>

<section class="hero">
  <img src={asset('assets/lexin-mark.png')} alt="" class="hero-mark" />
  <div class="container hero-grid">
    <div>
      <span class="hero-pill"><span class="dot"></span>{t.heroEyebrow}</span>
      <h1 class="hero-h1">{tagA} <span class="ember-text">{tagB}</span></h1>
      <p class="subline">{t.subline}</p>
      <p class="hero-body">{t.heroBody}</p>
      <div class="hero-ctas">
        <Button variant="gradient" size="lg" iconRight="arrow-right" href={url(lang, 'riset/')}>{t.ctaResearch}</Button>
        <Button variant="inverse" size="lg" href={url(lang, 'partisipasi/')}>{t.ctaPartner}</Button>
      </div>
    </div>

    <div class="diagram" data-details={JSON.stringify(details)}>
      <div class="diagram-head">
        <span class="lbl">{t.diagramLabel}</span>
        <span class="hint"><Icon name="mouse-pointer-click" size={15} />{t.diagramHint}</span>
      </div>
      <div class="house">
        <button type="button" class="roof part sel" data-k="products" aria-label={t.roof}>
          <span class="roof-inner">
            <span class="roof-lbl">{t.roof}</span>
            <span class="roof-chips">
              <span class="rchip">Klaussa</span>
              <span class="rchip">FiskalLink</span>
              <span class="rchip ghost">{t.moreDev}</span>
            </span>
          </span>
        </button>
        <div class="rule-row">
          <span class="rule-lbl">{t.pillarsLabel}</span>
          <span class="rule"></span>
        </div>
        <div class="pillars">
          {areas.map((a: any, i: number) => (
            <button type="button" class="pillar part" data-k={'a' + i}>
              <Icon name={a.icon} size={20} />
              <span class="pillar-txt">
                <span class="pnum">{a.num}</span>
                <span class="pshort"><span class="shy">{a.short}</span><span class="noshy">{a.title}</span></span>
              </span>
            </button>
          ))}
          <button type="button" class="pillar partner part" data-k="partner">
            <Icon name="plus" size={20} />
            <span class="pillar-txt" style="gap:4px">
              <span style="font:600 14px/1.25 var(--font-display)">{t.yourArea}</span>
              <span style="font:400 12px/1.3 var(--font-sans);color:#FFFFFF">{t.partnerWithUs}</span>
            </span>
          </button>
        </div>
        <button type="button" class="found part" data-k="foundations">
          <span style="display:flex;flex-direction:column;gap:4px;text-align:left"><span style="font:600 11px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--navy-600)">{t.foundationLabel}</span><span style="font:700 16px/1.2 var(--font-display);white-space:nowrap;color:var(--navy-900)">Legal AI Foundations</span></span>
          <span style="display:flex;gap:6px;flex-wrap:wrap">
            {t.foundationChips.map((c: string) => <span class="fchip">{c}</span>)}
          </span>
        </button>
        <button type="button" class="infra part" data-k="infra">
          <span class="infra-top"></span>
          <span class="infra-body">
            <span style="font:600 11px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--yellow-300)">{t.infraEyebrow}</span>
            <span style="font:500 12px/1.3 var(--font-mono);color:#FFFFFF;white-space:nowrap">{t.infraLabel}</span>
          </span>
        </button>
        <div class="pop" hidden>
          <span class="notch"></span>
          <div style="position:relative;display:flex;justify-content:space-between;align-items:flex-start;gap:12px">
            <div class="pop-eyebrow" data-f="eyebrow"></div>
            <button type="button" class="pop-x" aria-label={lang === 'id' ? 'Tutup' : 'Close'}><Icon name="x" size={16} /></button>
          </div>
          <div class="pop-title" data-f="title"></div>
          <p class="pop-body" data-f="body"></p>
          <a class="lx-btn lx-btn--link" data-f="link" href="#"><span data-f="linkText"></span><span class="lx-btn__r"><Icon name="arrow-right" size={17} /></span></a>
        </div>
      </div>
      <div class="selected">
        <div class="sel-head">
          <span class="sel-lbl"><Icon name="mouse-pointer-click" size={14} />{t.selectedLabel}</span>
          <span class="rule"></span>
        </div>
        <div class="sel-card">
          <div style="flex:1 1 240px;min-width:0">
            <div class="sel-eyebrow" data-f="eyebrow">{initial.eyebrow}</div>
            <div class="sel-title" data-f="title">{initial.title}</div>
            <p class="sel-body" data-f="body">{initial.body}</p>
          </div>
          <a href={initial.href} class="sel-link" data-f="link"><span data-f="linkText">{initial.link}</span><Icon name="arrow-right" size={16} /></a>
        </div>
      </div>
    </div>
  </div>
  <div class="stripe"></div>
</section>

<section style="background:var(--surface-page)">
  <div class="container sec">
    <div class="intro-grid">
      <div>
        <div class="eyebrow">{t.researchEyebrow}</div>
        <h2 class="h-sec" style="text-wrap:balance">{t.researchTitle}</h2>
      </div>
      <div style="display:flex;flex-direction:column;gap:16px;align-items:flex-start">
        <p style="font:var(--type-body-lg);color:var(--text-muted);margin:0;text-wrap:pretty">{t.researchBody}</p>
        <Button variant="secondary" iconRight="arrow-right" href={url(lang, 'riset/')}>{t.researchCta}</Button>
      </div>
    </div>
    <div class="area-grid">
      {areas.map((a: any) => (
        <a href={a.href} class="area-card lift">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <span class="tile" style={`background:${a.tileBg};color:${a.tileFg}`}><Icon name={a.icon} size={24} /></span>
            <span style="font:500 13px/1 var(--font-mono);color:var(--text-muted)">{a.num}</span>
          </div>
          <h3 style="font:var(--type-h4);color:var(--text-heading);margin:10px 0 0">{a.title}</h3>
          <p style="font:var(--type-body-sm);color:var(--text-muted);margin:0;flex:1;text-wrap:pretty">{a.q}</p>
          <div style="padding-top:14px;box-shadow:inset 0 1px 0 var(--border-subtle);display:flex;flex-direction:column;gap:6px">
            <span class="mini-lbl">{t.methods}</span>
            <span style="font:400 12.5px/1.5 var(--font-mono);color:var(--navy-700)">{a.m}</span>
          </div>
          {a.mitra && (
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
              <span class="mini-lbl">{t.mitraLabel}</span>
              <span class="mitra-chip">
                {a.mitraLogo && <span role="img" aria-label={a.mitra} style={`width:${a.mitraLogoW};height:26px;background:url("${asset(a.mitraLogo)}") center/contain no-repeat`}></span>}
                <span style="font:600 12px/1 var(--font-display);color:var(--navy-800);white-space:nowrap">{a.mitra}</span>
              </span>
            </div>
          )}
        </a>
      ))}
    </div>
  </div>
</section>

<section style="background:var(--grad-mist)">
  <div class="container sec">
    <div style="display:flex;justify-content:space-between;align-items:end;gap:20px 32px;flex-wrap:wrap">
      <div>
        <div class="eyebrow">{t.productsEyebrow}</div>
        <h2 class="h-sec">{t.productsTitle}</h2>
      </div>
      <Button variant="secondary" iconRight="arrow-right" href={url(lang, 'produk/')}>{t.allProducts}</Button>
    </div>
    <div class="prod-grid">
      {products.map((p: any) => (
        <div class="prod-card">
          <div class="prod-head">
            <span class="prod-icon"><Icon name={p.icon} size={34} /></span>
            <span style="font:700 40px/1 var(--font-display);letter-spacing:var(--tracking-tight);color:#FFFFFF">{p.name}</span>
          </div>
          <div style="padding:24px 28px 28px;display:flex;flex-direction:column;gap:16px;flex:1">
            <div style="display:flex"><Badge tone={p.tone} variant="soft" dot>{p.status}</Badge></div>
            <p style="margin:0;font:var(--type-body);color:var(--text-body);text-wrap:pretty">{p.desc}</p>
            <div style="display:flex;flex-wrap:wrap;gap:6px;flex:1;align-content:flex-start">
              {p.recog.map((r: string) => <span class="recog"><Icon name="award" size={13} />{r}</span>)}
            </div>
            <div style="display:flex"><Button variant="link" iconRight="arrow-right" href={p.href}>{p.cta}</Button></div>
          </div>
        </div>
      ))}
    </div>
    <div style="margin-top:28px;display:flex;align-items:flex-start;gap:10px;font:var(--type-body-sm);color:var(--text-muted)">
      <Icon name="info" size={16} style="margin-top:2px" />
      <span>{t.disclaimer}</span>
    </div>
  </div>
</section>

<section style="background:var(--surface-page)">
  <div class="container sec train-grid">
    <div>
      <div class="eyebrow">{t.trainEyebrow}</div>
      <h2 style="font:var(--type-h2);font-size:clamp(28px,3.6vw,38px);letter-spacing:var(--tracking-snug);color:var(--text-heading);margin:14px 0 0;text-wrap:balance">{t.trainTitle}</h2>
      <p style="font:var(--type-body-lg);color:var(--text-muted);margin:20px 0 0;text-wrap:pretty">{t.trainBody}</p>
      <div style="margin-top:32px">
        <Button variant="primary" size="lg" iconRight="arrow-right" href="mailto:hadiputra@cs.ui.ac.id">{t.trainCta}</Button>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:20px">
      {clients.map((c: any) => (
        <div style="border-radius:var(--radius-xl);box-shadow:var(--shadow-md);overflow:hidden;display:flex;flex-direction:column;background:var(--surface-card)">
          {c.photoUrl && <div role="img" aria-label={c.name} style={`width:100%;aspect-ratio:16/9;display:block;background:var(--ink-50) url(${c.photoUrl}) center/cover no-repeat`}></div>}
          <div style="padding:22px 24px 26px;display:flex;flex-direction:column;gap:12px">
            <span style="align-self:flex-start;height:28px;padding:0 12px;border-radius:999px;background:var(--navy-50);color:var(--navy-600);font:500 13px/28px var(--font-mono)">{c.code}</span>
            <h3 style="font:var(--type-h4);color:var(--text-heading);margin:0">{c.name}</h3>
            <p style="margin:0;font:var(--type-body-sm);color:var(--text-muted)">{c.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="partners">
  <div class="container partners-grid">
    <div class="eyebrow" style="color:var(--text-muted);line-height:1.5">{t.partnersLabel}</div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,140px),1fr));gap:12px">
      {t.partners.map((p: any) => (
        <div class="partner-card">
          <span style="height:64px;display:flex;align-items:center;justify-content:center;margin-bottom:4px"><span role="img" aria-label={p.long} style={`width:132px;height:64px;background:url("${asset(p.logo)}") center/contain no-repeat`}></span></span>
          <span style="font:700 15px/1.2 var(--font-display);color:var(--navy-800);white-space:nowrap">{p.short}</span>
          <span style="font:400 11px/1.3 var(--font-sans);color:var(--text-muted)">{p.long}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<section style="background:var(--surface-page)">
  <div class="container sec">
    <div class="eyebrow">{t.eventsEyebrow}</div>
    <h2 class="h-sec">{t.eventsTitle}</h2>
    <div class="events-grid">
      <div class="forum">
        <img src={asset('assets/lexin-mark.png')} alt="" style="position:absolute;right:-40px;bottom:-40px;height:260px;opacity:.12;filter:brightness(0) invert(1)" />
        <div style="display:flex;gap:8px;align-items:center;position:relative">
          <Badge tone="yellow" variant="solid">{t.flagship}</Badge>
          <span style="height:24px;padding:0 10px;border-radius:999px;box-shadow:inset 0 0 0 1px rgba(255,255,255,.3);font:600 12px/24px var(--font-display);color:var(--fg-on-dark-2)">{t.datesTbc}</span>
        </div>
        <h3 style="font:700 clamp(36px,5.4vw,52px)/1.05 var(--font-display);letter-spacing:var(--tracking-tight);margin:auto 0 0;position:relative;color:#FFFFFF">Lexin <span class="ember-text">Forum</span></h3>
        <p style="margin:0;font:var(--type-body-lg);color:var(--fg-on-dark-2);max-width:520px;position:relative">{t.forumBody}</p>
        <div style="position:relative">
          <Button variant="inverse" iconRight="bell" href="mailto:hadiputra@cs.ui.ac.id?subject=Lexin%20Forum">{t.forumCta}</Button>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:12px">
        <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px 16px;padding:0 4px 4px">
          <span class="eyebrow" style="color:var(--text-muted)">{t.latestLabel}</span>
          <span style="display:flex;flex-wrap:wrap;gap:4px 16px;justify-content:flex-end">
            <Button variant="link" iconRight="arrow-right" href={url(lang, 'wawasan/')}>{t.allInsights}</Button>
            <Button variant="link" iconRight="arrow-right" href={url(lang, 'publikasi/')}>{t.allPubs}</Button>
          </span>
        </div>
        {latest.map((n) => (
          <a href={n.href} class="latest lift" target={/^https?:/.test(n.href) ? '_blank' : undefined} rel={/^https?:/.test(n.href) ? 'noopener' : undefined}>
            <span style="display:flex;flex-wrap:wrap;gap:4px 8px;align-items:center;line-height:1.4;font:var(--type-body-sm);color:var(--text-muted);min-width:0"><span style="font:500 12px/1 var(--font-mono);color:var(--red-600);white-space:nowrap">{n.type}</span>·<span style="min-width:0;overflow-wrap:anywhere">{n.meta}</span></span>
            <span style="font:600 18px/1.35 var(--font-display)">{n.title}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<section style="background:var(--surface-page)">
  <div class="container" style="padding-bottom:clamp(56px,9vw,96px)">
    <div class="work">
      <div style="display:flex;justify-content:space-between;align-items:end;gap:32px;flex-wrap:wrap">
        <div style="max-width:640px">
          <div class="eyebrow">{t.workEyebrow}</div>
          <h2 class="h-sec">{t.workTitle}</h2>
        </div>
        <div style="display:flex;align-items:center;gap:12px 16px;flex-wrap:wrap">
          <span style="display:flex;flex-direction:column;gap:4px"><span style="font:600 15px/1.3 var(--font-display);color:var(--text-heading)">Dr. Panca Hadi Putra</span><span style="font:var(--type-mono);color:var(--navy-700)">hadiputra@cs.ui.ac.id</span></span>
          <Button variant="gradient" size="lg" iconRight="arrow-right" href={url(lang, 'kontak/')}>{t.contactUs}</Button>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));gap:20px;margin-top:clamp(28px,4vw,44px)">
        {audiences.map((a: any) => (
          <div style="background:var(--surface-card);border-radius:var(--radius-xl);box-shadow:var(--shadow-md);padding:26px 22px;display:flex;flex-direction:column;gap:12px">
            <span style={`width:48px;height:48px;border-radius:15px;background:${a.tileBg};color:${a.tileFg};display:flex;align-items:center;justify-content:center`}><Icon name={a.icon} size={22} /></span>
            <h3 style="font:var(--type-h4);font-size:18px;color:var(--text-heading);margin:6px 0 0">{a.title}</h3>
            <p style="margin:0;font:var(--type-body-sm);color:var(--text-muted);flex:1;text-wrap:pretty">{a.body}</p>
            <div style="display:flex"><Button variant="link" iconRight="arrow-right" href={a.href}>{a.cta}</Button></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

</BaseLayout>

<script>
  // "Cara kami bekerja" house diagram: select a part, show its detail.
  // ≥1120px: a popover next to the part (only after a click). Narrower: the "selected" card under the diagram.
  const root = document.querySelector<HTMLElement>('.diagram');
  if (root) {
    const details = JSON.parse(root.dataset.details || '{}');
    const house = root.querySelector<HTMLElement>('.house')!;
    const pop = root.querySelector<HTMLElement>('.pop')!;
    const notch = pop.querySelector<HTMLElement>('.notch')!;
    const card = root.querySelector<HTMLElement>('.sel-card')!;
    const wide = matchMedia('(min-width: 1120px)');

    const fill = (el: HTMLElement, d: any) => {
      el.querySelector<HTMLElement>('[data-f="eyebrow"]')!.textContent = d.eyebrow;
      el.querySelector<HTMLElement>('[data-f="title"]')!.textContent = d.title;
      el.querySelector<HTMLElement>('[data-f="body"]')!.textContent = d.body;
      el.querySelector<HTMLElement>('[data-f="linkText"]')!.textContent = d.link;
      el.querySelector<HTMLAnchorElement>('[data-f="link"]')!.href = d.href;
    };

    const place = (part: HTMLElement, k: string) => {
      const r = part.getBoundingClientRect(), hr = house.getBoundingClientRect();
      const W = hr.width, cx = r.left - hr.left + r.width / 2;
      const cw = Math.min(360, W * 0.94);
      const left = Math.max(0, Math.min(cx - cw / 2, W - cw));
      const above = k === 'foundations' || k === 'infra';
      pop.style.width = cw + 'px';
      pop.style.left = left + 'px';
      pop.style.top = (above ? r.top - hr.top - 12 : r.bottom - hr.top + 12) + 'px';
      pop.style.transform = above ? 'translateY(-100%)' : 'none';
      notch.style.left = Math.max(20, Math.min(cx - left, cw - 20)) + 'px';
      notch.style.top = above ? 'calc(100% - 7px)' : '-6px';
    };

    root.querySelectorAll<HTMLElement>('.part').forEach((part) => {
      part.addEventListener('click', () => {
        const k = part.dataset.k!;
        root.querySelectorAll('.part').forEach((p) => p.classList.toggle('sel', p === part));
        fill(card, details[k]);
        if (wide.matches) { fill(pop, details[k]); pop.hidden = false; place(part, k); }
      });
    });
    pop.querySelector('.pop-x')!.addEventListener('click', (e) => { e.stopPropagation(); pop.hidden = true; });
    wide.addEventListener('change', () => { pop.hidden = true; });
  }
</script>

