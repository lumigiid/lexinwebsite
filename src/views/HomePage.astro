---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import Icon from '../components/Icon.astro';
import { dict, url, asset, fmtDate, mailto, type Lang } from '../lib/i18n';
import { allPubs, postsByDate, pubKind } from '../lib/content';
import { img } from '../lib/images';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict('home', lang);

const ICON: Record<string, string> = { verified: 'badge-check', handshake: 'handshake', policy: 'shield-check', gavel: 'gavel', balance: 'scale', terminal: 'terminal', account_balance: 'landmark', school: 'graduation-cap', description: 'file-text', hub: 'network' };
const SHY: Record<string, string> = { Perselisihan: 'Perse­lisihan', Pengadilan: 'Penga­dilan', Governance: 'Gover­nance', Regulation: 'Regu­lation', Judgement: 'Judge­ment', Relations: 'Rela­tions', Disputes: 'Dis­putes' };

const areas = t.areas.map((a: string[], i: number) => {
  const mitra = a[4];
  const mitraLogo = /PSHTN/.test(mitra || '') ? 'assets/partners/pshtn.png' : /Kem(e)?naker/.test(mitra || '') ? 'assets/partners/kemnaker.png' : '';
  return {
    icon: ICON[a[0]] || a[0], title: a[1], q: a[2], m: a[3], mitra, mitraLogo,
    mitraLogoW: /pshtn/.test(mitraLogo) ? '18px' : '76px',
    num: '0' + (i + 1), href: url(lang, 'riset/#area-' + (i + 1)),
    short: a[1].split(' ').map((x) => SHY[x] || x).join(' '),
  };
});


// Logos shown on the product cards (all sit on white chips; h = rendered height in px).
const logo = (file: string, alt: string, h: number) => ({ src: 'assets/partners/' + file, alt, h });
const cardMeta = [
  {
    video: 'assets/video/home-klaussa-loop.mp4',
    logo: { src: 'assets/products/klaussa-logo-white.png', h: 40 },
    partners: [] as ReturnType<typeof logo>[],
    recog: [logo('ui-incubate.png', 'UI Incubate', 14), logo('google-for-startups.png', 'Google for Startups', 18), logo('nvidia-inception.png', 'NVIDIA Inception', 26)],
    recogText: [] as string[],
  },
  {
    video: 'assets/video/home-fiskallink-loop.mp4',
    logo: { src: 'assets/products/fiskallink-logo-white.png', h: 42 },
    partners: [logo('kemenkeu.png', 'Kementerian Keuangan', 24), logo('british-embassy-jakarta.jpg', 'British Embassy Jakarta', 34), logo('amana-solutions.webp', 'AMANA Solutions', 18), logo('pijar-foundation.png', 'Pijar Foundation', 18), logo('amazon-web-services.webp', 'Amazon Web Services', 24)],
    recog: [] as ReturnType<typeof logo>[],
    recogText: [] as string[], // filled from the dictionary below (no AIPS logo file yet)
  },
];
const products = t.products.map((p: any, i: number) => ({ ...p, meta: { ...cardMeta[i], recogText: cardMeta[i].recog.length ? [] : p.recog }, href: url(lang, i === 0 ? 'produk/#klaussa' : 'produk/#fiskallink'), icon: ICON[p.icon] || p.icon, tone: i === 0 ? 'success' : 'yellow' }));
const audiences = t.audiences.map((a: any, i: number) => ({ ...a, href: url(lang, 'partisipasi/#' + ['mitra-riset', 'data-kode', 'lembaga', 'fellowship'][i]), icon: ICON[a.icon] || a.icon }));
const clients = await Promise.all(t.clients.map(async (c: any) => ({ ...c, photoUrl: c.photo ? await img(c.photo, 720) : '' })));

// "Terbaru": the two newest posts plus the two newest publications, built from content at build time.
const KIND = { book: { id: 'BUKU', en: 'BOOK' }, journal: { id: 'JURNAL', en: 'JOURNAL' }, conf: { id: 'KONFERENSI', en: 'CONFERENCE' } } as const;
const latest = [
  ...postsByDate().slice(0, 2).map((p) => ({ type: lang === 'id' ? 'WAWASAN' : 'INSIGHTS', meta: fmtDate(p.date, lang), title: (p.title as any)[lang] || p.title.id, href: url(lang, 'wawasan/' + p.slug + '/') })),
  ...allPubs().sort((a, b) => +b.year - +a.year).slice(0, 2).map((p) => ({ type: KIND[pubKind(p.venue)][lang], meta: p.year + ' · ' + p.venue.split(',')[0].split(':')[0], title: p.title, href: p.href || url(lang, 'publikasi/') })),
];

const heroPhoto = await img('assets/hero-justice.jpg', 2000);
const forumPhoto = await img('assets/forum-conf.jpg', 1400);
const ci = t.tagline.indexOf('. ');
const tagA = t.tagline.slice(0, ci + 1), tagB = t.tagline.slice(ci + 2);
---
<BaseLayout lang={lang} path="">

<section class="hero on-dark">
  <div class="hero-photo" style={`background-image:url(${heroPhoto})`} aria-hidden="true"></div>
  <div class="hero-veil" aria-hidden="true"></div>
  <img src={asset('assets/lexin-mark.png')} alt="" class="hero-mark" />
  <div class="container hero-grid">
    <div>
      <h1 class="hero-h1">{tagA} <span class="ember-text">{tagB}</span></h1>
      <p class="hero-body">{t.heroBody}</p>
      <div class="hero-ctas">
        <Button variant="accent" size="lg" iconRight="arrow-right" href={url(lang, 'riset/')}>{t.ctaResearch}</Button>
        <Button variant="inverse" size="lg" href={url(lang, 'partisipasi/')}>{t.ctaPartner}</Button>
      </div>
    </div>

  </div>
  <div class="stripe"></div>
</section>

<section class="band-page who">
  <div class="container sec">
    <div class="who-grid">
      <div class="who-lead">
        <div>
          <div class="eyebrow">{t.who.eyebrow}</div>
          <h2 class="h-sec">{t.who.title}</h2>
        </div>
        <dl class="who-facts">
          {t.who.facts.map((f: string[]) => <div><dt>{f[0]}</dt><dd>{f[1]}</dd></div>)}
        </dl>
      </div>
      <div class="who-body">
        <p>{t.who.p1}</p>
        <p>{t.who.p2}</p>
        <div><Button variant="secondary" iconRight="arrow-right" href={url(lang, 'anggota/')}>{t.who.cta}</Button></div>
      </div>
    </div>
  </div>
</section>

<section class="band-mist how">
  <div class="container sec">
    <div class="eyebrow">{t.stack.eyebrow}</div>
    <h2 class="h-sec">{t.stack.title}</h2>
    <div class="house">
      <div class="tier tier--partners">
        <strong>{t.stack.partnersTitle}</strong>
        <span>{t.stack.partnersBody}</span>
      </div>
      <div class="tier tier--roof" data-axis={t.stack.axis.products}>
        <div class="roof-shape">
          <p class="roof-title">{t.stack.productsTitle}</p>
          <div class="roof-cells">
            <a class="roof-cell" href={url(lang, 'produk/#klaussa')}><strong>Klaussa</strong><span>{t.stack.productLines[0]}</span></a>
            <a class="roof-cell" href={url(lang, 'produk/#fiskallink')}><strong>FiskalLink</strong><span>{t.stack.productLines[1]}</span></a>
            <a class="roof-cell roof-cell--more" href={url(lang, 'produk/')}><strong>{t.stack.productLines[2]}</strong></a>
          </div>
        </div>
        <div class="roof-beam"></div>
      </div>
      <ol class="tier tier--pillars" data-axis={t.stack.axis.applied}>
        {areas.map((a: any, i: number) => (
          <li class="col"><a href={a.href}>
            <span class="col-cap"></span>
            <span class="col-shaft">
              <span class="col-num">{a.num}</span>
              <strong>{a.title}</strong>
              <span class="col-line">{t.stack.pillarLines[i]}</span>
            </span>
            <span class="col-base"></span>
          </a></li>
        ))}
        <li class="col col--open"><a href={url(lang, 'partisipasi/')}>
          <span class="col-cap"></span>
          <span class="col-shaft">
            <span class="col-num">+</span>
            <strong>{t.stack.openArea}</strong>
            <span class="col-line">{t.stack.openAreaLine}</span>
          </span>
          <span class="col-base"></span>
        </a></li>
      </ol>
      <div class="tier tier--foundation" data-axis={t.stack.axis.basic}>
        <ul class="found-cells">
          {t.stack.foundation.map((f: string[], i: number) => <li><a class="found-cell" href={url(lang, 'riset/#fondasi-' + (i + 1))}><strong>{f[0]}</strong><span>{f[1]}</span></a></li>)}
        </ul>
        <p class="found-label"><a href={url(lang, 'riset/#fondasi')}>{t.stack.foundationLabel}<Icon name="arrow-right" size={14} /></a></p>
      </div>
    </div>
  </div>
</section>

<section class="band-page">
  <div class="container sec">
    <div class="intro-grid">
      <div>
        <div class="eyebrow">{t.researchEyebrow}</div>
        <h2 class="h-sec">{t.researchTitle}</h2>
      </div>
      <div class="intro-side">
        <p class="lede">{t.researchBody}</p>
        <Button variant="secondary" iconRight="arrow-right" href={url(lang, 'riset/')}>{t.researchCta}</Button>
      </div>
    </div>
    <ol class="area-list">
      {areas.map((a: any) => (
        <li>
          <a href={a.href} class="area-row">
            <span class="area-num">{a.num}</span>
            <span class="area-main">
              <span class="area-title">{a.title}</span>
              <span class="area-q">{a.q}</span>
            </span>
            <span class="area-meta">
              <span class="mini-lbl">{t.methods}</span>
              <span class="area-methods">{a.m}</span>
            </span>
            <span class="area-mitra">
              {a.mitra && <span class="mini-lbl">{t.mitraLabel}</span>}
              {a.mitra && (
                <span class="mitra">
                  {a.mitraLogo && <span role="img" aria-label={a.mitra} class="mitra-logo" style={`--w:${a.mitraLogoW};background-image:url("${asset(a.mitraLogo)}")`}></span>}
                  <span class="mitra-name">{a.mitra}</span>
                </span>
              )}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="band-mist">
  <div class="container sec">
    <div class="sec-head">
      <div>
        <div class="eyebrow">{t.productsEyebrow}</div>
        <h2 class="h-sec">{t.productsTitle}</h2>
      </div>
      <Button variant="secondary" iconRight="arrow-right" href={url(lang, 'produk/')}>{t.allProducts}</Button>
    </div>
    <div class="prod-grid">
      {products.map((p: any) => (
        <div class="prod-card">
          <div class="prod-head on-dark">
            <video class="prod-video" data-src={asset(p.meta.video)} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
            <span class="prod-veil" aria-hidden="true"></span>
            <span class="prod-icon"><Icon name={p.icon} size={34} /></span>
            <img class="prod-logo" src={asset(p.meta.logo.src)} alt={p.name} style={`height:${p.meta.logo.h}px`} />
          </div>
          <div class="prod-body">
            <p class="prod-desc">{p.desc}</p>
            <div class="prod-logos">
              {p.meta.partners.length > 0 && (
                <div class="logo-group">
                  <span class="mini-lbl">{t.mitraLabel}</span>
                  <ul class="logo-row">
                    {p.meta.partners.map((l: any) => <li class="logo-chip"><img src={asset(l.src)} alt={l.alt} style={`height:${l.h}px`} loading="lazy" /></li>)}
                  </ul>
                </div>
              )}
              {(p.meta.recog.length > 0 || p.meta.recogText.length > 0) && (
                <div class="logo-group">
                  <span class="mini-lbl">{t.recogLabel}</span>
                  <ul class="logo-row">
                    {p.meta.recog.map((l: any) => <li class="logo-chip"><img src={asset(l.src)} alt={l.alt} style={`height:${l.h}px`} loading="lazy" /></li>)}
                    {p.meta.recogText.map((r: string) => <li class="logo-chip logo-chip--text"><Icon name="award" size={14} />{r}</li>)}
                  </ul>
                </div>
              )}
            </div>
            <div class="prod-cta"><Button variant="link" iconRight="arrow-right" href={p.href}>{p.cta}</Button></div>
          </div>
        </div>
      ))}
    </div>
    <p class="disclaimer">
      <Icon name="info" size={16} />
      <span>{t.disclaimer}</span>
    </p>
  </div>
</section>

<section class="band-page">
  <div class="container sec train-grid">
    <div>
      <div class="eyebrow">{t.trainEyebrow}</div>
      <h2 class="h-sec h-sec--sm">{t.trainTitle}</h2>
      <p class="lede lede--spaced">{t.trainBody}</p>
      <div class="train-cta">
        <Button variant="primary" size="lg" iconRight="arrow-right" href={mailto('Program pelatihan Lexin')}>{t.trainCta}</Button>
      </div>
    </div>
    <div class="client-grid">
      {clients.map((c: any) => (
        <figure class="client">
          {c.photoUrl && <div role="img" aria-label={c.name} class="client-photo" style={`background-image:url(${c.photoUrl})`}></div>}
          <figcaption>
            <span class="client-code">{c.code}</span>
            <h3 class="client-name">{c.name}</h3>
            <p class="client-body">{c.body}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<section class="partners">
  <div class="container partners-grid">
    <div class="eyebrow eyebrow--muted">{t.partnersLabel}</div>
    <ul class="partner-row">
      {t.partners.map((p: any) => (
        <li class="partner-cell">
          <span class="partner-logo" role="img" aria-label={p.long} style={`background-image:url("${asset(p.logo)}")`}></span>
          <span class="partner-short">{p.short}</span>
          <span class="partner-long">{p.long}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="band-page">
  <div class="container sec">
    <div class="eyebrow">{t.eventsEyebrow}</div>
    <h2 class="h-sec">{t.eventsTitle}</h2>
    <div class="events-grid">
      <div class="latest-col">
        <div class="latest-head">
          <span class="eyebrow eyebrow--muted">{t.latestLabel}</span>
          <span class="latest-links">
            <Button variant="link" iconRight="arrow-right" href={url(lang, 'wawasan/')}>{t.allInsights}</Button>
            <Button variant="link" iconRight="arrow-right" href={url(lang, 'publikasi/')}>{t.allPubs}</Button>
          </span>
        </div>
        <ul class="latest-list">
          {latest.map((n) => (
            <li>
              <a href={n.href} class="latest" data-no-italic={n.type === 'WAWASAN' || n.type === 'INSIGHTS' ? undefined : ''} target={/^https?:/.test(n.href) ? '_blank' : undefined} rel={/^https?:/.test(n.href) ? 'noopener' : undefined}>
                <span class="latest-meta"><span class="latest-type">{n.type}</span><span aria-hidden="true">·</span><span class="latest-date">{n.meta}</span></span>
                <span class="latest-title">{n.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="forum on-dark">
        <div class="forum-photo" style={`background-image:url(${forumPhoto})`} aria-hidden="true"></div>
        <div class="forum-veil" aria-hidden="true"></div>
        <img src={asset('assets/lexin-mark.png')} alt="" class="forum-mark" />
        <div class="forum-top">
          <Badge tone="yellow" variant="solid">{t.flagship}</Badge>
          <span class="forum-dates">{t.datesTbc}</span>
        </div>
        <h3 class="forum-h">Lexin <span class="ember-text">Forum</span></h3>
        <p class="forum-body">{t.forumBody}</p>
        <div class="forum-cta">
          <Button variant="inverse" iconRight="bell" href={mailto('Lexin Forum')}>{t.forumCta}</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="band-mist">
  <div class="container sec">
    <div class="sec-head">
      <div class="work-head">
        <div class="eyebrow">{t.workEyebrow}</div>
        <h2 class="h-sec">{t.workTitle}</h2>
      </div>
      <div class="work-contact">
        <span class="work-person"><span class="work-name">Dr. Panca Hadi Putra</span></span>
        <Button variant="primary" size="lg" iconRight="arrow-right" href={mailto()}>{t.contactUs}</Button>
      </div>
    </div>
    <ul class="aud-grid">
      {audiences.map((a: any) => (
        <li class="aud">
          <h3 class="aud-title">{a.title}</h3>
          <p class="aud-body">{a.body}</p>
          <div class="aud-cta"><Button variant="link" iconRight="arrow-right" href={a.href}>{a.cta}</Button></div>
        </li>
      ))}
    </ul>
  </div>
</section>

</BaseLayout>

<script>
  // Product-card loops: load and play only while on screen; never under reduced motion or Data Saver.
  const loops = document.querySelectorAll<HTMLVideoElement>('.prod-video');
  const saveData = (navigator as any).connection?.saveData;
  if (loops.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches && !saveData) {
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) { if (!v.src) v.src = v.dataset.src || ''; v.play().catch(() => {}); } else v.pause();
    }), { threshold: 0.25 });
    loops.forEach((v) => io.observe(v));
  }

</script>

<style>
  /* Hallmark · pre-emit critique: P4 H4 E4 S4 R4 V4 · redesign in place, brand tokens kept (Poppins/Plus Jakarta/Lexin indigo-red-yellow) · structure: ruled-row areas, 2 product cards, captioned photos, ruled news list, ruled audience columns · gradient text removed · reduced-motion global */
  /* Hero: dark night surface, left-aligned copy, diagram right. */
  .hero { background: var(--grad-night); color: var(--fg-on-dark); position: relative; overflow: hidden; width: 100%; min-height: calc(100vh - 80px); min-height: calc(100svh - 80px); display: flex; flex-direction: column; justify-content: center; }
  @media (max-width: 639.98px) { .hero { min-height: calc(100vh - 64px); min-height: calc(100svh - 64px); } }
  .hero-photo { position: absolute; inset: -90px 0 0 0; width: 100%; background-size: cover; background-position: center 30%; background-repeat: no-repeat; }
  .hero-veil { position: absolute; inset: 0; background: var(--grad-night); opacity: .8; }
  .hero-mark { position: absolute; right: clamp(-160px,-8vw,-60px); bottom: clamp(-200px,-12vw,-80px); height: clamp(320px,42vw,620px); opacity: .06; filter: brightness(0) invert(1); pointer-events: none; max-width: none; }
  .hero-grid { position: relative; width: 100%; padding-top: clamp(72px,10vw,128px); padding-bottom: clamp(72px,10vw,128px); display: grid; grid-template-columns: minmax(0,780px); }
  .hero-h1 { font: 700 clamp(24px,6.8vw,56px)/1.1 var(--font-display); letter-spacing: var(--tracking-tight); margin: 0; color: var(--fg-on-dark); text-wrap: balance; overflow-wrap: anywhere; min-width: 0; }
  .hero-body { font: var(--type-body-lg); margin: var(--space-6) 0 0; color: var(--fg-on-dark-2); max-width: 520px; text-wrap: pretty; }
  .hero-ctas { display: flex; gap: var(--space-3); margin-top: var(--space-10); flex-wrap: wrap; }


  /* Who we are: plain, descriptive */
  .who-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,420px),1fr)); gap: var(--space-6) clamp(32px,6vw,80px); align-items: start; }
  .who-body { display: flex; flex-direction: column; gap: var(--space-4); }
  .who-body p { margin: 0; font: var(--type-body-lg); color: var(--text-body); text-wrap: pretty; max-width: 62ch; }
  .who-lead { display: flex; flex-direction: column; gap: var(--space-8); }
  .who-facts { margin: 0; padding: 0; border-top: 2px solid var(--navy-900); }
  .who-facts > div { display: grid; grid-template-columns: minmax(96px,160px) minmax(0,1fr); gap: var(--space-4); padding: 12px 0; border-bottom: 1px solid var(--border-default); }
  .who-facts dt { font: 600 12px/1.6 var(--font-display); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--text-muted); }
  .who-facts dd { margin: 0; font: var(--type-body-sm); color: var(--text-heading); }

  /* How we work: a house. Partners above, roof = products, pillars = applied areas, foundation = basic research. */
  .house { margin-top: clamp(32px,5vw,56px); max-width: 1040px; margin-inline: auto; display: flex; flex-direction: column; gap: 0; }
  .tier strong { display: block; font: 700 17px/1.25 var(--font-display); }
  .tier--partners { position: relative; border: 1.5px dashed var(--navy-300); border-radius: var(--radius-md); background: var(--ink-0); padding: var(--space-4) var(--space-5); text-align: center; color: var(--navy-900); margin-bottom: 28px; }
  .tier--partners::after { content: ""; position: absolute; left: 50%; top: 100%; width: 2px; height: 28px; background: var(--navy-300); transform: translateX(-50%); }
  .tier--partners span { display: block; font: var(--type-body-sm); color: var(--text-muted); margin-top: 4px; }
  .roof-shape { position: relative; background: var(--grad-night); color: var(--fg-on-dark); clip-path: polygon(50% 0, 100% 100%, 0 100%); min-height: 244px; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; padding: 0 0 var(--space-5); }
  .roof-title { position: absolute; top: 116px; left: 50%; transform: translateX(-50%); margin: 0; width: max-content; max-width: 46%; text-align: center; font: 600 12px/1.3 var(--font-display); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--yellow-300); }
  .roof-cells { width: 74%; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); }
  .roof-cell { display: block; padding: var(--space-2) var(--space-3); text-align: center; color: var(--fg-on-dark); transition: color var(--dur-base) var(--ease-out); }
  .roof-cell + .roof-cell { box-shadow: inset 1px 0 0 var(--on-dark-line); }
  .roof-cell:hover { color: var(--yellow-300); }
  .roof-cell strong { font-size: 19px; }
  .roof-cell span { display: block; font: 400 13px/1.35 var(--font-sans); color: var(--fg-on-dark-2); margin-top: 2px; }
  .roof-cell--more { display: flex; align-items: center; justify-content: center; }
  .roof-cell--more strong { font-size: 14px; font-weight: 600; color: var(--fg-on-dark-2); }
  .roof-beam { height: 16px; margin: 0 -1.5%; background: var(--navy-900); box-shadow: 0 4px 0 var(--yellow-400); border-radius: 2px; }
  .tier--pillars { list-style: none; margin: 4px 0 0; padding: 0 1.5%; display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 30px; }
  .col a { display: flex; flex-direction: column; height: 100%; color: var(--navy-900); }
