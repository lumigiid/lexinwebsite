---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { dict, gmail, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict('partisipasi', lang);

// No forms on the site: each path opens an email to Dr. Panca Hadi Putra with the subject prefilled.
const paths = t.paths.map((p: any, i: number) => ({
  ...p,
  mailto: gmail('Lexin · ' + p.program),
}));
---
<BaseLayout lang={lang} path="partisipasi/" active="partisipasi" title={`Lexin — ${t.nav[5]}`}>

<PageHeader>
  <div class="eyebrow">{t.eyebrow}</div>
  <h1 class="ph-h1">{t.titleA} <span class="grad-text">{t.titleB}</span></h1>
  <div class="ph-rule"></div>
  <p class="u-65f54a">{t.intro}</p>
</PageHeader>

<section class="u-5cf619">
  <div class="container u-596bb7">
    <div class="u-f77183">
      {paths.map((p: any) => (
        <article id={p.id} class="path">
          <div class="u-6008a8">
            <span class="ico"><Icon name={p.icon} size={26} /></span>
            <span class="u-e6c996"><span class="mini-lbl">{p.who}</span><span class="u-b4699f">{p.program}</span></span>
          </div>
          <p class="u-455b81">{p.body}</p>
          <div class="u-b682dd">
            <div class="u-459fe4">
              <span class="mini-lbl">{t.youGet}</span>
              {p.get.map((x: string) => <span class="u-d3efde"><span class="u-fa92f7"><Icon name="check" size={16} /></span><span class="u-89bd09">{x}</span></span>)}
            </div>
            <div class="u-459fe4">
              <span class="mini-lbl">{t.weAsk}</span>
              {p.ask.map((x: string) => <span class="u-21141e"><span class="u-d58298"><Icon name="arrow-right" size={16} /></span><span class="u-89bd09">{x}</span></span>)}
            </div>
          </div>
          <div class="u-7f4a12">
            <Button variant="secondary" iconRight="mail" href={p.mailto}>{p.cta}</Button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="open-to">
  <div class="container open-inner">
    <div class="eyebrow">{t.open.eyebrow}</div>
    <h2 class="h-sec open-title">{t.open.title}</h2>
    <p class="open-intro">{t.open.intro}</p>
    <ul class="open-grid">
      {t.open.items.map((o: string[], i: number) => (
        <li><span class="open-no">{String(i + 1).padStart(2, '0')}</span><strong>{o[0]}</strong><span>{o[1]}</span></li>
      ))}
    </ul>
  </div>
</section>

<section class="u-efb5dc">
  <div class="container u-3aaecb">
    <div class="eyebrow u-83de02">{t.stepsEyebrow}</div>
    <h2 class="h-sec u-4b5425">{t.stepsTitle}</h2>
    <div class="u-078113">
      {t.steps.map((s: any) => (
        <div class="u-c7eab3">
          <span class="grad-text u-df60ca">{s.n}</span>
          <h3 class="u-59d76c">{s.title}</h3>
          <p class="u-7efbc9">{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="daftar" class="u-c1db9a">
  <div class="container u-a422bd">
    <div class="u-37d2b6">
      <div class="eyebrow">{t.formEyebrow}</div>
      <h2 class="h-sec u-1386d5">{t.formTitle}</h2>
      <p class="u-2fede3">{t.formBody}</p>
      <span class="u-0b5a77">Dr. Panca Hadi Putra</span>
      <div class="mail-link"><Button variant="primary" iconRight="mail" href={gmail()}>{t.contactUs}</Button></div>
    </div>
    <div class="u-d2c60f">
      <span class="mini-lbl u-2937bf">{t.byPath}</span>
      {paths.map((p: any) => (
        <a href={p.mailto} class="path-mail" target="_blank" rel="noopener">
          <span class="ico"><Icon name={p.icon} size={20} /></span>
          <span class="u-2fca08"><span class="u-cbcafe">{p.program}</span><span class="u-16e09c">{p.who}</span></span>
          <Icon name="mail" size={18} />
        </a>
      ))}
    </div>
  </div>
</section>

</BaseLayout>

<style>
  .path { scroll-margin-top: 100px; border-top: 2px solid var(--navy-900); padding: clamp(24px,3vw,32px) 0 0; display: flex; flex-direction: column; gap: 18px }
  .path:target { border-top-color: var(--red-500) }
  .mini-lbl { font: 600 12px/1 var(--font-display); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--text-muted); }
  .h-sec { font: var(--type-h1); font-size: clamp(28px,3.8vw,40px); letter-spacing: var(--tracking-tight); color: var(--text-heading); text-wrap: balance; }
  .mail-link { display: inline-flex; align-items: center; gap: 8px; font: 500 14px/1 var(--font-mono); color: var(--navy-600); margin-top: -8px; }
  .mail-link:hover { color: var(--red-600); }
  .path-mail { display: flex; align-items: center; gap: 14px; padding: 14px 4px; border-bottom: 1px solid var(--border-default); color: var(--text-heading) }
  .path-mail:hover { background: var(--navy-50); color: var(--navy-600); }
  .u-65f54a { font:var(--type-body-lg);margin:24px 0 0;color:var(--text-body);max-width:640px;text-wrap:pretty; }
  .u-5cf619 { background:var(--surface-page); }
  .u-596bb7 { padding-top:clamp(40px,6vw,72px);padding-bottom:clamp(40px,6vw,72px); }
  .u-f77183 { display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,520px),1fr));gap:24px; }
  .u-6008a8 { display:flex;align-items:center;gap:14px; }
  .u-e6c996 { display:flex;flex-direction:column;gap:4px;min-width:0; }
  .u-b4699f { font:700 22px/1.25 var(--font-display);color:var(--text-heading); }
  .u-455b81 { margin:0;font:var(--type-body);color:var(--text-body);text-wrap:pretty; }
  .u-b682dd { display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:18px 28px; }
  .u-459fe4 { display:flex;flex-direction:column;gap:10px; }
  .u-d3efde { display:flex;gap:10px;align-items:flex-start;font:var(--type-body-sm);color:var(--text-body); }
  .u-fa92f7 { color:var(--navy-500);display:flex;margin-top:2px; }
  .u-89bd09 { flex:1;min-width:0; }
  .u-21141e { display:flex;gap:10px;align-items:flex-start;font:var(--type-body-sm);color:var(--text-muted); }
  .u-d58298 { color:var(--ink-400);display:flex;margin-top:2px; }
  .u-7f4a12 { margin-top:auto;padding-top:18px;box-shadow:inset 0 1px 0 var(--border-subtle);display:flex; }
  .u-efb5dc { background:var(--navy-50);box-shadow:inset 0 1px 0 var(--border-subtle),inset 0 -1px 0 var(--border-subtle); }
  .u-3aaecb { padding-top:clamp(56px,8vw,88px);padding-bottom:clamp(56px,8vw,88px); }
  .u-83de02 { color:var(--navy-600); }
  .u-4b5425 { margin:14px 0 0; }
  .u-078113 { display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:20px;margin-top:clamp(28px,4vw,40px); }
  .u-c7eab3 { border-top:2px solid var(--navy-900);padding:20px 0 0;display:flex;flex-direction:column;gap:10px }
  .u-df60ca { font:700 32px/1 var(--font-display);letter-spacing:var(--tracking-tight); }
  .u-59d76c { font:var(--type-h4);color:var(--text-heading);margin:6px 0 0; }
  .u-7efbc9 { margin:0;font:var(--type-body-sm);color:var(--text-muted);text-wrap:pretty; }
  .u-c1db9a { scroll-margin-top:80px;background:var(--surface-page); }
  .u-a422bd { padding-top:clamp(56px,8vw,96px);padding-bottom:clamp(56px,8vw,96px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:32px clamp(32px,5vw,72px);align-items:start; }
  .u-37d2b6 { display:flex;flex-direction:column;gap:16px; }
  .u-1386d5 { margin:0; }
  .u-2fede3 { margin:0;font:var(--type-body-lg);color:var(--text-muted);text-wrap:pretty; }
  .u-0b5a77 { font:700 16px/1.3 var(--font-display);color:var(--text-heading);margin-top:4px; }
  .u-d2c60f { border-radius:var(--radius-xl);background:var(--surface-card);box-shadow:var(--shadow-lg);padding:clamp(22px,3vw,32px);display:flex;flex-direction:column;gap:6px; }
  .u-2937bf { margin-bottom:6px; }
  .u-2fca08 { display:flex;flex-direction:column;gap:3px;flex:1;min-width:0; }
  .u-cbcafe { font:700 16px/1.3 var(--font-display); }
  .u-16e09c { font:var(--type-body-sm);color:var(--text-muted); }
  .ico { color: var(--navy-500); display: inline-flex; flex: none; }
  .open-to { background: var(--surface-page); }
  .open-inner { padding-top: clamp(56px,8vw,88px); padding-bottom: clamp(56px,8vw,88px); }
  .open-title { margin-top: 14px; text-wrap: balance; }
  .open-intro { margin: var(--space-4) 0 0; font: var(--type-body-lg); color: var(--text-body); max-width: 62ch; }
  .open-grid { list-style: none; margin: clamp(28px,4vw,48px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,300px),1fr)); gap: 0 var(--space-8); }
  .open-grid li { display: flex; flex-direction: column; gap: 6px; padding: var(--space-5) 0; border-top: 2px solid var(--navy-900); }
  .open-no { font: 500 12px/1 var(--font-mono); color: var(--red-600); }
  .open-grid strong { font: 700 20px/1.25 var(--font-display); color: var(--text-heading); }
  .open-grid li span:last-child { font: var(--type-body-sm); color: var(--text-muted); text-wrap: pretty; }
</style>
