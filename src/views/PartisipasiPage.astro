---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { dict, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict('partisipasi', lang);

const TILES = [['var(--navy-50)', 'var(--navy-500)'], ['var(--red-50)', 'var(--red-500)'], ['var(--yellow-100)', 'var(--navy-800)'], ['var(--grad-signature)', '#FFFFFF']];
// No forms on the site: each path opens an email to Dr. Panca Hadi Putra with the subject prefilled.
const paths = t.paths.map((p: any, i: number) => ({
  ...p, tileBg: TILES[i][0], tileFg: TILES[i][1],
  mailto: 'mailto:hadiputra@cs.ui.ac.id?subject=' + encodeURIComponent('Lexin · ' + p.program),
}));
---
<BaseLayout lang={lang} path="partisipasi/" active="partisipasi" title={`Lexin — ${t.nav[5]}`}>

<PageHeader>
  <div class="eyebrow">{t.eyebrow}</div>
  <h1 class="ph-h1">{t.titleA} <span class="grad-text">{t.titleB}</span></h1>
  <div class="ph-rule"></div>
  <p style="font:var(--type-body-lg);margin:24px 0 0;color:var(--text-body);max-width:640px;text-wrap:pretty">{t.intro}</p>
</PageHeader>

<section style="background:var(--surface-page)">
  <div class="container" style="padding-top:clamp(40px,6vw,72px);padding-bottom:clamp(40px,6vw,72px)">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,520px),1fr));gap:24px">
      {paths.map((p: any) => (
        <article id={p.id} class="path">
          <div style="display:flex;align-items:center;gap:14px">
            <span style={`width:56px;height:56px;border-radius:17px;background:${p.tileBg};color:${p.tileFg};display:flex;align-items:center;justify-content:center;flex-shrink:0`}><Icon name={p.icon} size={26} /></span>
            <span style="display:flex;flex-direction:column;gap:4px;min-width:0"><span class="mini-lbl">{p.who}</span><span style="font:700 22px/1.25 var(--font-display);color:var(--text-heading)">{p.program}</span></span>
          </div>
          <p style="margin:0;font:var(--type-body);color:var(--text-body);text-wrap:pretty">{p.body}</p>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:18px 28px">
            <div style="display:flex;flex-direction:column;gap:10px">
              <span class="mini-lbl">{t.youGet}</span>
              {p.get.map((x: string) => <span style="display:flex;gap:10px;align-items:flex-start;font:var(--type-body-sm);color:var(--text-body)"><span style="color:var(--navy-500);display:flex;margin-top:2px"><Icon name="check" size={16} /></span><span style="flex:1;min-width:0">{x}</span></span>)}
            </div>
            <div style="display:flex;flex-direction:column;gap:10px">
              <span class="mini-lbl">{t.weAsk}</span>
              {p.ask.map((x: string) => <span style="display:flex;gap:10px;align-items:flex-start;font:var(--type-body-sm);color:var(--text-muted)"><span style="color:var(--ink-400);display:flex;margin-top:2px"><Icon name="arrow-right" size={16} /></span><span style="flex:1;min-width:0">{x}</span></span>)}
            </div>
          </div>
          <div style="margin-top:auto;padding-top:18px;box-shadow:inset 0 1px 0 var(--border-subtle);display:flex">
            <Button variant="secondary" iconRight="mail" href={p.mailto}>{p.cta}</Button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section style="background:var(--navy-50);box-shadow:inset 0 1px 0 var(--border-subtle),inset 0 -1px 0 var(--border-subtle)">
  <div class="container" style="padding-top:clamp(56px,8vw,88px);padding-bottom:clamp(56px,8vw,88px)">
    <div class="eyebrow" style="color:var(--navy-600)">{t.stepsEyebrow}</div>
    <h2 class="h-sec" style="margin:14px 0 0">{t.stepsTitle}</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:20px;margin-top:clamp(28px,4vw,40px)">
      {t.steps.map((s: any) => (
        <div style="background:var(--surface-card);border-radius:var(--radius-xl);box-shadow:var(--shadow-md);padding:24px;display:flex;flex-direction:column;gap:10px">
          <span class="grad-text" style="font:700 32px/1 var(--font-display);letter-spacing:var(--tracking-tight)">{s.n}</span>
          <h3 style="font:var(--type-h4);color:var(--text-heading);margin:6px 0 0">{s.title}</h3>
          <p style="margin:0;font:var(--type-body-sm);color:var(--text-muted);text-wrap:pretty">{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="daftar" style="scroll-margin-top:80px;background:var(--surface-page)">
  <div class="container" style="padding-top:clamp(56px,8vw,96px);padding-bottom:clamp(56px,8vw,96px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:32px clamp(32px,5vw,72px);align-items:start">
    <div style="display:flex;flex-direction:column;gap:16px">
      <div class="eyebrow">{t.formEyebrow}</div>
      <h2 class="h-sec" style="margin:0">{t.formTitle}</h2>
      <p style="margin:0;font:var(--type-body-lg);color:var(--text-muted);text-wrap:pretty">{t.formBody}</p>
      <span style="font:700 16px/1.3 var(--font-display);color:var(--text-heading);margin-top:4px">Dr. Panca Hadi Putra</span>
      <a href="mailto:hadiputra@cs.ui.ac.id" class="mail-link"><Icon name="mail" size={16} />hadiputra@cs.ui.ac.id</a>
    </div>
    <div style="border-radius:var(--radius-xl);background:var(--surface-card);box-shadow:var(--shadow-lg);padding:clamp(22px,3vw,32px);display:flex;flex-direction:column;gap:6px">
      <span class="mini-lbl" style="margin-bottom:6px">{t.byPath}</span>
      {paths.map((p: any) => (
        <a href={p.mailto} class="path-mail">
          <span style={`width:44px;height:44px;border-radius:13px;background:${p.tileBg};color:${p.tileFg};display:flex;align-items:center;justify-content:center;flex-shrink:0`}><Icon name={p.icon} size={20} /></span>
          <span style="display:flex;flex-direction:column;gap:3px;flex:1;min-width:0"><span style="font:700 16px/1.3 var(--font-display)">{p.program}</span><span style="font:var(--type-body-sm);color:var(--text-muted)">{p.who}</span></span>
          <Icon name="mail" size={18} />
        </a>
      ))}
    </div>
  </div>
</section>

</BaseLayout>

<style>
  .path { scroll-margin-top: 100px; background: var(--surface-card); border-radius: var(--radius-xl); box-shadow: var(--shadow-md); padding: clamp(24px,3vw,32px); display: flex; flex-direction: column; gap: 18px; transition: box-shadow .3s; }
  .path:target { box-shadow: var(--shadow-md), 0 0 0 2px var(--navy-300); }
  .mini-lbl { font: 600 11px/1 var(--font-display); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--text-muted); }
  .h-sec { font: var(--type-h1); font-size: clamp(28px,3.8vw,40px); letter-spacing: var(--tracking-tight); color: var(--text-heading); text-wrap: balance; }
  .mail-link { display: inline-flex; align-items: center; gap: 8px; font: 500 14px/1 var(--font-mono); color: var(--navy-600); margin-top: -8px; }
  .mail-link:hover { color: var(--red-600); }
  .path-mail { display: flex; align-items: center; gap: 14px; padding: 14px 12px; margin: 0 -12px; border-radius: 16px; color: var(--text-heading); }
  .path-mail:hover { background: var(--navy-50); color: var(--navy-600); }
</style>
