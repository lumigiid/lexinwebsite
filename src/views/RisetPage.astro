  .u-3345b4 { text-wrap:balance; }
  .u-95e5be { display:flex;flex-direction:column;gap:0;margin-top:clamp(28px,4vw,48px) }
  .u-a051c6 { display:flex;flex-direction:column;gap:16px;min-width:0; }
  .u-6008a8 { display:flex;align-items:center;gap:14px; }
  .u-839954 { font:500 13px/1 var(--font-mono);color:var(--text-muted); }
  .u-262303 { font:var(--type-h2);font-size:clamp(24px,2.8vw,30px);letter-spacing:var(--tracking-snug);color:var(--text-heading);margin:4px 0 0;text-wrap:balance; }
  .u-747a39 { display:flex;align-items:center;gap:8px;flex-wrap:wrap; }
