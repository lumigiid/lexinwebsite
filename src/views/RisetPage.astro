---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { dict, url, asset, gmail, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict('riset', lang);

const draftMail = (kind: string, title: string) => gmail(kind + title);
const PUBS = [
  [{ type: t.journalType, title: 'A Framework for Integrated E-notary Services Based on Blockchain for Civil Law Notaries: The Case of Indonesia', year: '2025', href: 'https://dx.doi.org/10.62527/joiv.9.1.3170' }],
  [],
  [
    { type: 'WHITE PAPER', title: t.aiGovWp, year: t.draft, href: draftMail('Draft white paper: ', t.aiGovWp) },
    { type: 'POLICY BRIEF', title: t.aiRoadmap, year: t.draft, href: draftMail('Draft policy brief: ', t.aiRoadmap) },
    { type: t.chapterType, title: 'From Logic Programming to Machine Ethics', year: '2019', href: 'https://doi.org/10.1007/978-3-658-17483-5_14' },
  ],
  [
    { type: t.confType, title: 'IRNLPUI at COLIEE 2025: Utilization of LLMs for Statute Law Retrieval and Legal Entailment Task', year: '2025', href: 'https://doi.org/10.1145/3769126.3785016' },
    { type: t.confType, title: 'Extreme Multilabel Text Classification on Indonesian Tax Court Ruling using Single Channel CNN and IndoBERT Embedding', year: '2021', href: 'https://doi.org/10.1109/IWBIS53353.2021.9631855' },
  ],
];
const areas = t.areas.map((a: any, i: number) => ({
  ...a, id: 'area-' + (i + 1), num: '0' + (i + 1),
  rows: a.rows.map((v: string, k: number) => ({ label: t.rowLabels[k], val: v })),
  pubs: PUBS[i],
}));
const ext = (h: string) => /^https?:/.test(h) ? { target: '_blank', rel: 'noopener' } : {};
---
<BaseLayout lang={lang} path="riset/" active="riset" title={`Lexin — ${t.nav[0]}`}>

<PageHeader tall>
  <div class="eyebrow">{t.eyebrow}</div>
  <h1 class="ph-h1">{t.titleA} <span class="grad-text">{t.titleB}</span></h1>
  <div class="ph-rule"></div>
  <div class="u-7c6fc7">
    <p class="u-207b5b">{t.intro}</p>
    <div class="u-180d23">
      {areas.map((p: any) => (
        <a href={'#' + p.id} class="area-pill" data-go={p.id}>
          <span class="area-pill-n">{p.num}</span>{p.title}
        </a>
      ))}
    </div>
  </div>
</PageHeader>

<div class="u-c451fd">
  <div class="rail-layer">
    <div class="container rail-wrap">
      <aside class="rail" aria-label={t.onThisPage}>
        <div class="u-d6b458">{t.onThisPage}</div>
        <a href={url(lang, 'produk/')} class="r-roof">
          <span class="u-e0e296">{t.roof}<Icon name="arrow-up-right" size={12} /></span>
        </a>
        {areas.map((p: any) => (
          <a href={'#' + p.id} class="r-area" data-go={p.id} data-spy={p.id}>
            <span class="u-305db9">{p.num}</span>
            <span class="u-691bd6">{p.title}</span>
          </a>
        ))}
        <a href="#kolaborasi" class="r-collab" data-go="kolaborasi" data-spy="kolaborasi">
          <Icon name="plus" size={14} />
          <span class="u-691bd6">{t.yourArea}</span>
        </a>
        <a href="#fondasi" class="r-found" data-go="fondasi" data-spy="fondasi">
          <span class="u-509d8c">{t.foundationLabel}</span>
          <span class="u-9e553e">Legal AI Foundations</span>
        </a>
        <a href="#infrastruktur" class="r-infra" data-go="infrastruktur" data-spy="infrastruktur">
          <span class="u-81cd8b">{t.infraEyebrow}</span>
          <span class="u-976103">{t.infraTitle}</span>
        </a>
      </aside>
    </div>
  </div>

  <div class="container body-grid">
    <div class="rail-spacer"></div>
    <div class="u-3f9f96">
      <section class="u-fdf45d">
        <div>
          <div class="eyebrow">{t.areasEyebrow}</div>
          <h2 class="h-sec u-3345b4">{t.areasTitle}</h2>
        </div>
        <div class="u-95e5be">
          {areas.map((a: any) => (
            <article id={a.id} class="area">
              <div class="u-a051c6">
                <div class="u-6008a8">
                  <span class="area-ico"><Icon name={a.icon} size={24} /></span>
                  <span class="u-839954">{t.areaWord} {a.num}</span>
                </div>
                <h3 class="u-262303">{a.title}</h3>
                <div class="u-747a39">
                  <span class="mini-lbl">{t.mitraLabel}</span>
                  {a.mitra
                    ? <span class="u-c2b3d4">{a.mitra}</span>
                    : <a href="#kolaborasi" data-go="kolaborasi" class="open-partner">{t.openForPartner}</a>}
                </div>
                <p class="u-6aadf7">“{a.q}”</p>
              </div>
              <div class="u-620166">
                {a.rows.map((r: any) => (
                  <div class="u-a077cb">
                    <span class="u-48a538">{r.label}</span>
                    <span class="u-482e9f">{r.val}</span>
                  </div>
                ))}
                <div class="u-101e92">
                  <span class="mini-lbl">{t.relatedPubs}</span>
                  {a.pubs.length === 0 && <span class="u-c8e90f">{t.pubsSoon}</span>}
                  {a.pubs.map((u: any) => (
                    <a href={u.href} class="pub-row" {...ext(u.href)}>
                      <span class="u-a2e852">{u.type}</span>
                      <span class="u-94df67">{u.title}</span>
                      <span class="u-93240e">{u.year}</span>
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>
  </div>

  <section id="fondasi" class="anchor u-efb5dc">
    <div class="container body-grid sec-pad">
      <div class="rail-spacer"></div>
      <div class="u-3f9f96">
        <div class="split-intro">
          <div>
            <div class="eyebrow u-83de02">{t.foundationLabel}</div>
            <h2 class="h-sec">Legal AI Foundations</h2>
          </div>
          <p class="u-40c710">{t.foundationBody}</p>
        </div>
        <div class="fnd-list">
          {t.foundations.map((f: any, i: number) => (
            <article class="fnd anchor" id={'fondasi-' + (i + 1)}>
              <div class="fnd-main">
                <span class="fnd-no">{t.foundationLabel} 0{i + 1}</span>
                <h3 class="fnd-title">{f.title}</h3>
                <p class="fnd-body">{f.body}</p>
              </div>
              <div class="fnd-pubs">
                <span class="mini-lbl">{t.relatedPubs}</span>
                {!f.hasPub && <span class="u-b6199c">{t.pubsSoonShort}</span>}
                {f.hasPub && (
                  <a href={f.pubHref} class="pub-card" target="_blank" rel="noopener">
                    <span class="u-3a9402">{f.pubMeta}</span>
                    <span class="u-ff6f63">{f.pubTitle}</span>
                  </a>
                )}
                {f.hasPub2 && (
                  <a href={f.pub2Href} class="pub-card" target="_blank" rel="noopener">
                    <span class="u-3a9402">{f.pub2Meta}</span>
                    <span class="u-ff6f63">{f.pub2Title}</span>
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="infrastruktur" class="anchor u-5cf619">
    <div class="container body-grid sec-pad">
      <div class="rail-spacer"></div>
      <div class="u-3f9f96">
        <div class="split-intro">
          <div>
            <div class="eyebrow">{t.infraEyebrow} · {t.dataCode}</div>
            <h2 class="h-sec">{t.infraTitle}</h2>
          </div>
          <p class="u-40c710">{t.infraBody}</p>
        </div>
        <div class="infra-list">
          {t.infra.map((f: any, i: number) => (
            <article class="infra-row">
              <span class="infra-code">{f.code}</span>
              <h3 class="infra-title">{f.title}</h3>
              <p class="infra-body">{f.body}</p>
            </article>
          ))}
        </div>
        <div class="u-f5829b">
          <div class="u-625693">
            <span class="u-bf79a6">{t.openData}</span>
            <span class="u-aa02aa">{t.lexidTitle}</span>
            <span class="u-134f33">{t.lexidBody}</span>
            <span class="u-72f6e0">{t.relatedPubs}</span>
            <a href="https://doi.org/10.21609/jiki.v16i1.1096" class="lexid-paper" target="_blank" rel="noopener"><span class="u-5fde3d">{t.paperLabel} · JIKI 2023</span><span>LexID: The Metadata and Semantic Knowledge Graph Construction of Indonesian Legal Document</span></a>
          </div>
          <div class="u-4ad06f">
            <Button variant="inverse" iconRight="arrow-right" href="https://github.com/ninggar17/dataset_lexid_pdf">{t.dataset}</Button>
            <a href="https://github.com/lab-lexin" class="gh-btn" target="_blank" rel="noopener"><Icon name="github" size={16} />lab-lexin</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<section id="kolaborasi" class="anchor u-5cf619">
  <div class="container u-063ebc">
    <div class="collab">
      <img src={asset('assets/lexin-mark.png')} alt="" class="u-283b2c" />
      <div class="u-c451fd">
        <div class="eyebrow u-d05469">{t.collabEyebrow}</div>
        <h2 class="h-sec u-ca959c">{t.collabTitle}</h2>
        <p class="u-a702e9">{t.collabBody}</p>
        <div class="u-89c227">
          <Button variant="accent" size="lg" iconRight="mail" href={gmail()}>{t.contactUs}</Button>
          <Button variant="inverse" size="lg" href={url(lang, 'partisipasi/')}>{t.participate}</Button>
        </div>
      </div>
      <div class="u-c8f82e">
        <span class="u-3f9990"><Icon name="plus" size={22} /><span class="u-ab8bd9">{t.yourArea}</span></span>
        {t.collabWays.map((c: any) => (
          <div class="u-b7f8db">
            <span class="u-2ba496">{c.n}</span>
            <span class="u-fb7434"><span class="u-5c85bd">{c.title}</span><span class="u-134f33">{c.body}</span></span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

</BaseLayout>

<script>
  const SECTIONS = ['area-1', 'area-2', 'area-3', 'area-4', 'fondasi', 'infrastruktur', 'kolaborasi'];
  const goto = (id: string) => {
    const el = document.getElementById(id);
    if (!el) return;
    const off = innerWidth < 640 ? 76 : 96;
    const top = el.getBoundingClientRect().top + scrollY - off;
    const L = (window as any).__lenis;
    if (L) L.scrollTo(top, { duration: 1.4 }); else scrollTo({ top, behavior: 'smooth' });
    history.replaceState(null, '', '#' + id);
  };
  document.querySelectorAll<HTMLElement>('[data-go]').forEach((el) => el.addEventListener('click', (e) => { e.preventDefault(); goto(el.dataset.go!); }));
  if (location.hash) setTimeout(() => goto(location.hash.slice(1)), 150);

  // Scroll-spy for the desktop rail.
  const spies = document.querySelectorAll<HTMLElement>('[data-spy]');
  const onScroll = () => {
    let cur = '';
    for (const id of SECTIONS) { const el = document.getElementById(id); if (el && el.getBoundingClientRect().top < 160) cur = id; }
    spies.forEach((s) => s.classList.toggle('on', s.dataset.spy === cur));
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .area-pill { cursor: pointer; min-height: 36px; white-space: nowrap; padding: 0 14px 0 0; border-bottom: 2px solid var(--navy-900); display: inline-flex; align-items: center; gap: 10px; font: 600 13px/1 var(--font-display); color: var(--navy-900) }
  .area-pill:hover { border-bottom-color: var(--red-500); color: var(--navy-600) }
  .h-sec { font: var(--type-h1); font-size: clamp(30px,4.2vw,44px); letter-spacing: var(--tracking-tight); color: var(--text-heading); margin: 14px 0 0; }
  .mini-lbl { font: 600 12px/1 var(--font-display); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--text-muted); }

  .rail-layer { position: absolute; inset: 0; z-index: 5; pointer-events: none; display: none; }
  .rail-wrap { height: 100%; padding-top: clamp(56px,8vw,88px); padding-bottom: clamp(56px,8vw,88px); }
  .rail { position: sticky; top: 104px; width: 232px; pointer-events: auto; display: flex; flex-direction: column; gap: 6px; }
  .r-roof { display: block; position: relative; clip-path: polygon(50% 0,100% 100%,0 100%); background: var(--grad-night); padding: 34px 12px 8px; text-align: center; margin-bottom: 4px }
  .r-roof:hover { filter: brightness(1.15) }
  .r-area { cursor: pointer; min-height: 52px; margin: 0 6px; padding: 8px 14px; display: flex; align-items: center; gap: 10px; background: linear-gradient(90deg, var(--navy-100) 0 5px, var(--ink-0) 5px calc(100% - 5px), var(--navy-100) calc(100% - 5px)); color: var(--navy-900); border-top: 4px solid var(--navy-700); border-bottom: 4px solid var(--navy-700); box-shadow: inset 0 0 0 1px var(--navy-200); transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out) }
  .r-area:hover { border-top-color: var(--yellow-500); border-bottom-color: var(--yellow-500); color: var(--navy-900) }
  .r-area.on, .r-area.on:hover { background: linear-gradient(90deg, var(--yellow-300) 0 5px, var(--yellow-50) 5px calc(100% - 5px), var(--yellow-300) calc(100% - 5px)); border-top-color: var(--yellow-500); border-bottom-color: var(--yellow-500); color: var(--navy-900) }
  .r-collab { cursor: pointer; min-height: 48px; margin: 0 6px; padding: 8px 14px; display: flex; align-items: center; gap: 10px; border: 1.5px dashed var(--yellow-500); background: transparent; color: var(--navy-900) }
  .r-collab:hover, .r-collab.on { background: var(--yellow-100); color: var(--navy-900); }
  .r-found { cursor: pointer; min-height: 52px; margin-top: 6px; padding: 10px 14px; display: flex; flex-direction: column; justify-content: center; gap: 4px; background: var(--navy-600); color: var(--fg-on-dark); border-radius: 3px; box-shadow: 0 -5px 0 var(--navy-300) }
  .r-found:hover, .r-found.on { background: var(--navy-700); color: var(--fg-on-dark); box-shadow: 0 -5px 0 var(--yellow-400) }
  .r-infra { cursor: pointer; margin: 0; min-height: 48px; padding: 10px 14px; display: flex; flex-direction: column; justify-content: center; gap: 4px; background: var(--navy-900); border-radius: 3px; box-shadow: inset 0 3px 0 var(--navy-700) }
  .r-infra:hover { background: var(--navy-800) }
  .r-infra.on { background: var(--navy-800); box-shadow: inset 0 3px 0 var(--yellow-400) }

  .body-grid { display: grid; grid-template-columns: minmax(0,1fr); gap: 48px; align-items: start; }
  .rail-spacer { display: none; }
  .sec-pad { padding-top: clamp(56px,8vw,88px); padding-bottom: clamp(56px,8vw,88px); }
  .anchor { scroll-margin-top: 80px; }
  .area { scroll-margin-top: 104px; border-top: 2px solid var(--navy-900); padding: clamp(24px,3.4vw,40px) 0; display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,400px),1fr)); gap: 28px clamp(28px,4vw,56px) }
  @media (min-width: 1120px) {
    .rail-layer { display: block; }
    .body-grid { grid-template-columns: 232px minmax(0,1fr); }
    .rail-spacer { display: block; }
    .area { grid-template-columns: repeat(auto-fit,minmax(min(100%,320px),1fr)); }
  }
  .open-partner { font: 600 13px/1.3 var(--font-display); color: var(--navy-800); text-decoration: underline; text-decoration-color: var(--yellow-500); text-decoration-thickness: 2px; text-underline-offset: 3px }
  .open-partner:hover { color: var(--red-600) }
  .pub-row { display: flex; align-items: baseline; gap: 10px; padding: 10px 4px; border-bottom: 1px solid var(--border-default); color: var(--text-heading) }
  .pub-card { padding: 10px 4px; border-bottom: 1px solid var(--border-default); display: flex; flex-direction: column; gap: 4px; color: var(--text-heading) }
  .pub-row:hover, .pub-card:hover { background: var(--navy-50); color: var(--navy-600); }
  .split-intro { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,380px),1fr)); gap: 20px clamp(28px,5vw,64px); align-items: end; }
  .lexid-paper { margin-top: 2px; display: inline-flex; align-items: baseline; gap: 8px; font: 600 14px/1.4 var(--font-display); color: var(--yellow-300); }
  .lexid-paper:hover { color:var(--fg-on-dark); }
  .gh-btn { height: 44px; padding: 0 18px; border-radius: var(--radius-pill); box-shadow: inset 0 0 0 1px var(--on-dark-line-2); display: inline-flex; align-items: center; gap: 8px; font: 600 14px/1 var(--font-display); color:var(--fg-on-dark) }
  .gh-btn:hover { background: var(--on-dark-fill-2); color:var(--fg-on-dark) }
  .collab { border-radius: clamp(24px,3vw,32px); background: var(--grad-night); color:var(--fg-on-dark); padding: clamp(24px,5vw,56px); position: relative; overflow: hidden; display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,380px),1fr)); gap: 32px clamp(32px,5vw,64px); align-items: center; }
  .u-7c6fc7 { display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:20px 64px;margin-top:24px;align-items:start; }
  .u-207b5b { font:var(--type-body-lg);margin:0;color:var(--text-body);text-wrap:pretty; }
  .u-180d23 { display:flex;flex-wrap:wrap;gap:8px; }
  .u-c451fd { position:relative; }
  .u-d6b458 { font:600 12px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--text-muted);margin:0 0 10px 4px; }
  .u-e0e296 { display:flex;align-items:center;justify-content:center;gap:6px;font:600 12px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--yellow-300); }
  .u-305db9 { font:500 12px/1 var(--font-mono);opacity:.7; }
  .u-691bd6 { font:600 13px/1.25 var(--font-display); }
  .u-509d8c { font:600 12px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--yellow-300) }
  .u-9e553e { font:700 14px/1.2 var(--font-display);color:var(--fg-on-dark) }
  .u-81cd8b { font:600 12px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--yellow-300) }
  .u-976103 { font:600 13px/1.2 var(--font-display);color:var(--fg-on-dark); }
  .u-3f9f96 { min-width:0; }
