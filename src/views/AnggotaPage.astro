---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { dict, url, type Lang } from '../lib/i18n';
import { members } from '../lib/content';
import { img } from '../lib/images';
import rosterData from '../data/rosters.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict('anggota', lang);

// The prototype had this filter row switched off; the handoff README asks for it. Set to false to hide it.
const SHOW_FILTER = true;

const AV: Record<string, string> = { lead: 'var(--navy-800)', fac: 'var(--navy-500)', staff: 'var(--red-600)' };
const filters = [['all', t.all], ['ret', t.areas.ret], ['rea', t.areas.rea], ['tru', t.areas.tru]].map(([k, label]) => ({
  k, label,
}));
// Name-only lists. A section with no names is simply not rendered.
const rosters = (['rstaff', 'ugrad', 'grad', 'alumni'] as const)
  .map((k) => ({ k, title: t.groups[k], names: rosterData[k] as string[] }))
  .filter((r) => r.names.length > 0);
const groups = await Promise.all(['lead', 'fac', 'staff'].map(async (g) => {
  const list = await Promise.all(members.filter((m) => m.g === g).map(async (m) => ({
    ...m, role: t.roles[m.role], avBg: AV[g], photoUrl: m.photo ? await img(m.photo, 640) : '',
    position: m.position ? m.position[lang] : '', lede: (m.bio && m.bio[lang] && m.bio[lang][0]) || '',
    href: url(lang, 'anggota/' + m.slug + '/'),
  })));
  return { g, title: t.groups[g], members: list };
}));
const byG = (g: string) => groups.find((x) => x.g === g)!;
const lead = byG('lead').members[0];
const fac = byG('fac');
const staff = byG('staff');
---
<BaseLayout lang={lang} path="anggota/" active="anggota" title={`Lexin — ${t.nav[2]}`}>

<PageHeader>
  <div class="eyebrow">{t.eyebrow}</div>
  <h1 class="ph-h1">{t.titleA} <span class="grad-text">{t.titleB}</span></h1>
  <div class="ph-rule"></div>
  <p class="u-65f54a">{t.intro}</p>
</PageHeader>

<section class="u-5cf619">
  <div class="container u-9869f5">
    {SHOW_FILTER && (
      <div class="filterbar">
        <span class="u-edb37f">{t.filterLabel}</span>
        <div class="u-180d23">
          {filters.map((f) => (
            <button type="button" class:list={['fbtn', { on: f.k === 'all' }]} data-filter={f.k} aria-pressed={f.k === 'all' ? 'true' : 'false'}>{f.label}</button>
          ))}
        </div>
      </div>
    )}
    <div class="u-8f9416">
      {lead && (
        <div class="grp lead">
          <h2 class="grp-title">{byG('lead').title}</h2>
          <article class="mcard lead-card" data-area={lead.area}>
            <a href={lead.href} class="pphoto" tabindex="-1" aria-hidden="true">
              <span class="pini" style={`background:${lead.avBg}`}>{lead.ini}</span>
              {lead.photoUrl && <img src={lead.photoUrl} alt={lead.name} loading="lazy" />}
            </a>
            <div class="lead-body">
              <a href={lead.href} class="lead-name">{lead.name}</a>
              <span class="lead-role">{lead.role}</span>
              {lead.position && <span class="lead-pos">{lead.position}</span>}
              {lead.lede && <p class="lead-lede">{lead.lede}</p>}
              <div class="ptags">{lead.tags.map((g: string) => <span class="u-1ac452">{g}</span>)}</div>
              <div class="lead-actions">
                <Button variant="primary" size="sm" iconRight="arrow-right" href={lead.href}>{t.viewProfile}</Button>
              </div>
            </div>
          </article>
        </div>
      )}

      <div class="grp">
        <h2 class="grp-title">{fac.title}</h2>
        <div class="pgrid pgrid--5">
          {fac.members.map((m: any) => (
            <article class="mcard pcard" data-area={m.area}>
              <a href={m.href} class="pphoto" tabindex="-1" aria-hidden="true">
                <span class="pini" style={`background:${m.avBg}`}>{m.ini}</span>
                {m.photoUrl && <img src={m.photoUrl} alt={m.name} loading="lazy" />}
              </a>
              <a href={m.href} class="mname">{m.name}</a>
              <span class="u-0b70bb">{m.role}</span>
              <div class="ptags">{m.tags.map((g: string) => <span class="u-1ac452">{g}</span>)}</div>
            </article>
          ))}
        </div>
      </div>

      <div class="team-row">
        <div class="grp">
          <h2 class="grp-title">{staff.title}</h2>
          <div class="pgrid pgrid--3">
            {staff.members.map((m: any) => (
              <article class="mcard pcard" data-area={m.area}>
                <a href={m.href} class="pphoto" tabindex="-1" aria-hidden="true">
                  <span class="pini" style={`background:${m.avBg}`}>{m.ini}</span>
                  {m.photoUrl && <img src={m.photoUrl} alt={m.name} loading="lazy" />}
                </a>
                <a href={m.href} class="mname">{m.name}</a>
                <span class="u-0b70bb">{m.role}</span>
                <div class="ptags">{m.tags.map((g: string) => <span class="u-1ac452">{g}</span>)}</div>
              </article>
            ))}
          </div>
        </div>
        <aside class="rosters">
          {rosters.map((r) => (
            <div class="grp roster">
              <h2 class="grp-title grp-title--sm">{r.title}</h2>
              <ul class="roster-list">
                {r.names.map((n) => <li>{n}</li>)}
              </ul>
            </div>
          ))}
        </aside>
      </div>
      <div class="empty u-aa2922" hidden>{t.empty}</div>
    </div>
  </div>
</section>

<section class="u-5cf619">
  <div class="container u-3c657e">
    <div class="u-ed592c">
      <div class="u-1426fd">
        <span class="u-9e6429">{t.joinTitle}</span>
        <span class="u-827c3f">{t.joinBody}</span>
      </div>
      <Button variant="secondary" iconRight="arrow-right" href={url(lang, 'partisipasi/')}>{t.joinCta}</Button>
    </div>
  </div>
</section>

</BaseLayout>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.fbtn');
  const apply = (k: string) => {
    btns.forEach((b) => { const on = b.dataset.filter === k; b.classList.toggle('on', on); b.setAttribute('aria-pressed', String(on)); });
    let any = false;
    document.querySelectorAll<HTMLElement>('.grp').forEach((grp) => {
      if (grp.classList.contains('roster')) { grp.hidden = k !== 'all'; return; }
      let n = 0;
      grp.querySelectorAll<HTMLElement>('.mcard').forEach((c) => { const show = k === 'all' || c.dataset.area === k; c.hidden = !show; if (show) n++; });
      grp.hidden = n === 0;
      if (n) any = true;
    });
    document.querySelector<HTMLElement>('.empty')!.hidden = any;
  };
  btns.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));
</script>

<style>
  .filterbar { margin: 0 0 var(--space-6); padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px }
  .fbtn { cursor: pointer; border: 0; height: 40px; padding: 0 16px; border-radius: 999px; display: inline-flex; align-items: center; gap: 8px; font: 600 14px/1 var(--font-display); white-space: nowrap; background: var(--ink-0); color: var(--navy-900); box-shadow: inset 0 0 0 1px var(--border-subtle); }
  .fbtn:hover { box-shadow: inset 0 0 0 1px var(--navy-300); }
  .fbtn.on { background: var(--navy-600); color:var(--fg-on-dark); box-shadow: none; }
  .mcard { border-top: 2px solid var(--navy-900); padding: 20px; border-radius: 0 0 var(--radius-md) var(--radius-md); display: flex; flex-direction: column; gap: 14px; transition: background-color var(--dur-base) var(--ease-out) }
  .go { width: 40px; height: 40px; border-radius: 999px; display: flex; align-items: center; justify-content: center; background: var(--ink-50); color: var(--navy-600); }
  .go:hover { background: var(--navy-600); color:var(--fg-on-dark); }
  .mname { font: 700 19px/1.3 var(--font-display); color: var(--text-heading); text-wrap: balance; }
  .mname:hover { color: var(--navy-600); }
  .mmail { margin-top: auto; padding-top: 14px; box-shadow: inset 0 1px 0 var(--border-subtle); display: flex; align-items: center; gap: 8px; font: 500 13px/1.3 var(--font-mono); color: var(--navy-600); word-break: normal; overflow-wrap: normal; min-width: 0; }
  .mmail:hover { color: var(--red-600); }
  .u-65f54a { font:var(--type-body-lg);margin:24px 0 0;color:var(--text-body);max-width:640px;text-wrap:pretty; }
  .u-5cf619 { background:var(--surface-page); }
  .u-9869f5 { padding-top:clamp(32px,5vw,48px);padding-bottom:clamp(48px,7vw,80px); }
  .u-edb37f { font:600 12px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--text-muted); }
  .u-180d23 { display:flex;flex-wrap:wrap;gap:8px; }
  .u-305db9 { font:500 12px/1 var(--font-mono);opacity:.7; }
  .u-8f9416 { display:flex;flex-direction:column;gap:clamp(40px,6vw,64px); }
  .u-b5a98e { display:flex;flex-direction:column;gap:20px; }
  .u-a45ba4 { display:flex;align-items:baseline;gap:12px;flex-wrap:wrap; }
  .u-9ecc2d { font:var(--type-h2);font-size:clamp(24px,2.8vw,30px);letter-spacing:var(--tracking-snug);color:var(--text-heading);margin:0; }
  .u-839954 { font:500 13px/1 var(--font-mono);color:var(--text-muted); }
  .u-8bf80c { display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:20px; }
  .u-be11a8 { display:flex;justify-content:space-between;align-items:flex-start;gap:12px; }
  .u-17e25e { position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 0;background:var(--ink-0) }
  .u-fb7434 { display:flex;flex-direction:column;gap:4px; }
  .u-aadf51 { font:500 13px/1.4 var(--font-mono);color:var(--text-muted); }
  .u-0b70bb { font:600 14px/1.3 var(--font-display);color:var(--red-600); }
  .u-2075ff { display:flex;flex-wrap:wrap;gap:6px; }
  .u-1ac452 { font:500 12px/1.4 var(--font-mono);color:var(--navy-700);white-space:nowrap }
  .u-aa2922 { border-radius:var(--radius-xl);border:2px dashed var(--navy-200);padding:32px;text-align:center;font:var(--type-body);color:var(--text-muted); }
  .u-3c657e { padding-bottom:clamp(56px,8vw,96px); }
  .u-ed592c { border-radius:var(--radius-xl);background:var(--navy-50);box-shadow:inset 0 0 0 1px var(--navy-200);padding:clamp(24px,3.4vw,36px);display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px 32px; }
  .u-1426fd { display:flex;flex-direction:column;gap:6px;max-width:620px; }
  .u-9e6429 { font:700 clamp(22px,2.4vw,26px)/1.25 var(--font-display);color:var(--text-heading); }
  .u-827c3f { font:var(--type-body);color:var(--text-muted);text-wrap:pretty; }
  .roster-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 0 var(--space-8); border-top: 2px solid var(--navy-900); }
  .roster-list li { padding: 14px 4px; border-bottom: 1px solid var(--border-default); font: 600 16px/1.4 var(--font-display); color: var(--navy-900); }
  .mcard:hover { background: var(--navy-50); }
  .u-1ac452:not(:last-child)::after { content: ","; }
  .u-8f9416 { gap: clamp(36px,5vw,56px); }
  .grp { display: flex; flex-direction: column; gap: var(--space-5); min-width: 0; }
  .grp-title { font: var(--type-h2); font-size: clamp(22px,2.4vw,28px); letter-spacing: var(--tracking-snug); color: var(--text-heading); margin: 0; }
  .grp-title--sm { font-size: 20px; }
  .pgrid { display: grid; gap: var(--space-5); }
  /* Fixed track size: a card keeps the same size no matter how many are left after filtering. */
  .pgrid--5, .pgrid--3 { grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 222px)); justify-content: start; }
  .pcard { border-top: 0; padding: 0; border-radius: var(--radius-md); gap: 6px; }
  .pphoto { position: relative; display: block; aspect-ratio: 4 / 5; border-radius: var(--radius-lg); overflow: hidden; margin-bottom: var(--space-2); background: var(--navy-100); }
  .pphoto img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; display: block; transition: transform var(--dur-slower) var(--ease-out); }
  .pcard:hover .pphoto img, .lead-card:hover .pphoto img { transform: scale(1.04); }
  .pini { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: var(--fg-on-dark); font: 700 44px/1 var(--font-display); }
  .ptags { display: flex; flex-wrap: wrap; gap: 4px 6px; }
  .pcard .mname { font-size: 17px; }
  .pcard .ptags { margin-bottom: 8px; }
  .pcard .mmail { margin-top: auto; padding-top: 10px; word-break: break-all; font-size: 12px; }
  .lead-card { border-top: 2px solid var(--navy-900); padding: var(--space-6) 0 0; display: grid; grid-template-columns: minmax(0,240px) minmax(0,1fr); gap: var(--space-6) clamp(24px,4vw,48px); align-items: start; background: transparent; }
  .lead-body { display: flex; flex-direction: column; gap: var(--space-2); }
  .lead-name { font: 700 clamp(26px,3vw,34px)/1.15 var(--font-display); color: var(--text-heading); letter-spacing: var(--tracking-snug); }
  .lead-name:hover { color: var(--navy-600); }
  .lead-titles { font: 500 13px/1.4 var(--font-mono); color: var(--text-muted); }
  .lead-role { font: 600 15px/1.3 var(--font-display); color: var(--red-600); }
  .lead-pos { font: var(--type-body-sm); color: var(--text-body); }
  .lead-lede { margin: var(--space-2) 0 0; font: var(--type-body); color: var(--text-body); max-width: 62ch; text-wrap: pretty; }
  .lead-actions { margin-top: var(--space-3); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); }
  .mmail--plain { margin: 0; padding: 0; box-shadow: none; }
  .team-row { display: grid; grid-template-columns: minmax(0,1fr); gap: var(--space-8); align-items: start; }
  .rosters { display: flex; flex-direction: column; gap: var(--space-6); }
  .rosters .roster-list { grid-template-columns: 1fr; gap: 0; }
  .rosters .roster-list li { font-size: 15px; padding: 10px 4px; }
  @media (min-width: 1000px) { .team-row { grid-template-columns: minmax(0,1.7fr) minmax(0,1fr); gap: clamp(32px,5vw,64px); } }
  @media (max-width: 639.98px) { .lead-card { grid-template-columns: 1fr; } .lead-card .pphoto { max-width: 220px; } }
  /* Whole card is one link target: the name's link stretches over the card; the email stays separately clickable. */
  .pcard, .lead-card { position: relative; cursor: pointer; }
  .pcard .mname::after, .lead-name::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: var(--radius-md); }
  .pcard .mmail, .lead-actions { position: relative; z-index: 2; }
  .pcard, .lead-card { transition: background-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out); }
  .pcard:hover { background: var(--navy-50); box-shadow: 0 0 0 10px var(--navy-50); }
  .lead-card:hover { background: var(--navy-50); box-shadow: 0 0 0 14px var(--navy-50); }
  .pcard:hover .mname, .lead-card:hover .lead-name { color: var(--red-600); }
  .pcard:hover .pphoto, .lead-card:hover .pphoto { box-shadow: 0 6px 0 var(--yellow-400); }
  .pcard:focus-within, .lead-card:focus-within { outline: 2px solid var(--border-focus); outline-offset: 6px; border-radius: var(--radius-md); }
</style>
