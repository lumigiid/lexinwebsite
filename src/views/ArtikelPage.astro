---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { dict, url, type Lang } from '../lib/i18n';
import { postsByDate, type Post } from '../lib/content';
import { postView } from '../lib/posts';

interface Props { lang: Lang; post: Post }
const { lang, post } = Astro.props;
const t = dict('wawasan-artikel', lang);

const u = await postView(post, lang);
const more = await Promise.all(postsByDate().filter((p) => p.slug !== post.slug).slice(0, 3).map((p) => postView(p, lang)));
---
<BaseLayout lang={lang} path={`wawasan/${u.slug}/`} active="wawasan" title={`${u.title} — Lexin`} description={u.dek}>

<section class="page-header">
  <div style="position:relative;max-width:880px;margin:0 auto;padding:clamp(28px,4vw,40px) 20px clamp(36px,5vw,56px)">
    <nav style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;font:600 13px/1 var(--font-display)" aria-label="Breadcrumb">
      <a href={url(lang, 'wawasan/')} class="crumb"><Icon name="arrow-left" size={14} />{t.back}</a>
      <span style="color:var(--text-muted)">/</span><span style="color:var(--text-muted)">{u.typeLabel}</span>
    </nav>
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:clamp(24px,4vw,36px)">
      <span style={`height:26px;padding:0 10px;border-radius:999px;background:${u.typeBg};color:${u.typeFg};font:600 11px/26px var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;white-space:nowrap`}>{u.typeLabel}</span>
      <span style="font:500 13px/1 var(--font-mono);color:var(--text-muted)">{u.dateLabel}</span>
    </div>
    <h1 style="font:700 clamp(32px,4.8vw,48px)/1.12 var(--font-display);letter-spacing:var(--tracking-tight);margin:18px 0 0;color:var(--text-heading);text-wrap:balance">{u.title}</h1>
    <p style="margin:18px 0 0;font:500 clamp(18px,1.8vw,21px)/1.5 var(--font-display);color:var(--navy-800);text-wrap:pretty">{u.dek}</p>
    <div style="width:56px;height:4px;border-radius:2px;background:var(--red-500);margin-top:28px"></div>
  </div>
</section>

<section style="background:var(--surface-page)">
  <div class="body">
    <article style="display:flex;flex-direction:column;gap:20px;min-width:0">
      <div style={`position:relative;width:100%;aspect-ratio:16/8;border-radius:24px;overflow:hidden;background:${u.panel};color:${u.ink};display:flex;align-items:center;justify-content:center`}>
        <Icon name={u.icon} size={64} />
        <span role={u.photoBg !== 'none' ? 'img' : undefined} aria-label={u.photoBg !== 'none' ? u.title : undefined} style={`position:absolute;inset:0;background:${u.photoBg}`}></span>
      </div>
      {u.body.map((para) => <p style="margin:0;font:400 clamp(17px,1.5vw,18px)/1.75 var(--font-sans);color:var(--text-body);text-wrap:pretty">{para}</p>)}
      {u.gallery.map((g) => (
        <figure style="margin:8px 0 0;display:flex;flex-direction:column;gap:10px">
          <span role="img" aria-label={g.cap} style={`display:block;width:100%;aspect-ratio:${g.ratio};border-radius:20px;background:${g.bg}`}></span>
          <figcaption style="font:var(--type-body-sm);color:var(--text-muted)">{g.cap}</figcaption>
        </figure>
      ))}
      {u.link && <div style="display:flex"><Button variant="gradient" iconRight="arrow-up-right" href={u.link.href}>{u.link.label}</Button></div>}
      {u.sources.length > 0 && (
        <div style="margin-top:8px;border-radius:20px;background:var(--surface-card);box-shadow:inset 0 0 0 1px var(--border-subtle);padding:20px 22px;display:flex;flex-direction:column;gap:12px">
          <span style="font:600 11px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--text-muted)">{t.sources}</span>
          {u.sources.map((s) => <a href={s.href} target="_blank" rel="noopener" class="src"><span>{t.readAt} {s.name}</span><Icon name="arrow-up-right" size={16} /></a>)}
        </div>
      )}
    </article>
    <aside class="side">
      {u.authors.length > 0 && (
        <div style="border-radius:var(--radius-xl);background:var(--navy-50);box-shadow:inset 0 0 0 1px var(--navy-200);padding:22px;display:flex;flex-direction:column;gap:12px">
          <span style="font:600 11px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--navy-600)">{t.people}</span>
          {u.authors.map((a) => (
            <a href={a.href} class="person">
              <span style={`width:32px;height:32px;border-radius:50%;background:${a.avBg};color:#FFFFFF;display:flex;align-items:center;justify-content:center;font:700 11px/1 var(--font-display);flex-shrink:0`}>{a.ini}</span>
              <span style="font:600 14px/1.3 var(--font-display)">{a.name}</span>
            </a>
          ))}
        </div>
      )}
      <div style="display:flex;flex-direction:column;gap:10px">
        <span style="font:600 11px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--text-muted)">{t.more}</span>
        {more.map((m) => (
          <a href={m.href} class="more">
            <span style="font:500 12px/1 var(--font-mono);color:var(--text-muted)">{m.typeLabel} · {m.dateLabel}</span>
            <span style="font:700 15px/1.35 var(--font-display);text-wrap:pretty">{m.title}</span>
          </a>
        ))}
      </div>
    </aside>
  </div>
</section>

</BaseLayout>

<style>
  .crumb { display: inline-flex; align-items: center; gap: 6px; color: var(--navy-600); }
  .crumb:hover { color: var(--red-600); }
  .body { max-width: 1088px; margin: 0 auto; padding: clamp(40px,6vw,64px) 20px; display: grid; grid-template-columns: minmax(0,1fr); gap: 40px clamp(32px,5vw,64px); align-items: start; }
  .side { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  @media (min-width: 960px) {
    .body { grid-template-columns: minmax(0,1fr) 300px; }
    .side { position: sticky; top: 104px; }
  }
  .src { display: flex; align-items: center; justify-content: space-between; gap: 12px; font: 600 15px/1.35 var(--font-display); color: var(--navy-700); }
  .src:hover { color: var(--red-600); }
  .person { display: flex; align-items: center; gap: 10px; color: var(--text-heading); }
  .person:hover { color: var(--navy-600); }
  .more { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px; border-radius: 18px; background: var(--surface-card); box-shadow: inset 0 0 0 1px var(--border-subtle); color: var(--text-heading); }
  .more:hover { box-shadow: inset 0 0 0 1px var(--navy-300); color: var(--navy-600); }
</style>
