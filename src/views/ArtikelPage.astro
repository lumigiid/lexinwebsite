---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { dict, url, asset, type Lang } from '../lib/i18n';
import { postsByDate, type Post } from '../lib/content';
import { postView } from '../lib/posts';

interface Props { lang: Lang; post: Post }
const { lang, post } = Astro.props;
const t = dict('wawasan-artikel', lang);

const u = await postView(post, lang);
const more = await Promise.all(postsByDate().filter((p) => p.slug !== post.slug).slice(0, 3).map((p) => postView(p, lang)));
---
<BaseLayout lang={lang} path={`wawasan/${u.slug}/`} active="wawasan" title={`${u.title} — Lexin`} description={u.dek}>

<section class="page-header">
  <div class="u-472bd9">
    <nav class="u-04f982" aria-label="Breadcrumb">
      <a href={url(lang, 'wawasan/')} class="crumb"><Icon name="arrow-left" size={14} />{t.back}</a>
      <span class="u-5b795a">/</span><span class="u-5b795a">{u.typeLabel}</span>
    </nav>
    <div class="u-738f05">
      <span class="type-tag" style={`background:${u.typeBg};color:${u.typeFg}`}>{u.typeLabel}</span>
      <span class="u-839954">{u.dateLabel}</span>
    </div>
    <h1 class="u-e4d2ff">{u.title}</h1>
    <p class="u-07e376">{u.dek}</p>
    <div class="u-d4876b"></div>
  </div>
</section>

<section class="u-5cf619">
  <div class="body">
    <article class="u-b68202">
      <div style={`position:relative;width:100%;aspect-ratio:16/8;border-radius:24px;overflow:hidden;background:${u.panel};color:${u.ink};display:flex;align-items:center;justify-content:center`}>
        <Icon name={u.icon} size={64} />
        <span role={u.photoBg !== 'none' ? 'img' : undefined} aria-label={u.photoBg !== 'none' ? u.title : undefined} style={`position:absolute;inset:0;background:${u.photoBg}`}></span>
      </div>
      {u.photoBg !== 'none' && u.credit && <p class="photo-credit">{u.credit}</p>}
      {u.body.map((para) => <p class="u-8df7e6">{para}</p>)}
      {u.gallery.map((g) => (
        <figure class="u-3dfe65">
          <span role="img" aria-label={g.cap} style={`display:block;width:100%;aspect-ratio:${g.ratio};border-radius:20px;background:${g.bg}`}></span>
          <figcaption class="u-16e09c">{g.cap}</figcaption>
        </figure>
      ))}
      {u.video && (
        <figure class="vid">
          <video src={asset(u.video.src)} poster={u.video.poster ? asset(u.video.poster) : undefined} controls playsinline preload="metadata" aria-label={u.embed ? u.embed.title : u.title}></video>
        </figure>
      )}
      {u.embed && (
        <p class="vid-link"><a href={u.embed.watch} target="_blank" rel="noopener">{u.embed.cta}<Icon name="arrow-up-right" size={14} /></a></p>
      )}
      {u.link && <div class="u-f7dbba"><Button variant="primary" iconRight="arrow-up-right" href={u.link.href}>{u.link.label}</Button></div>}
      {u.sources.length > 0 && (
        <div class="u-ea3812">
          <span class="u-edb37f">{t.sources}</span>
          {u.sources.map((s) => <a href={s.href} target="_blank" rel="noopener" class="src"><span>{t.readAt} {s.name}</span><Icon name="arrow-up-right" size={16} /></a>)}
        </div>
      )}
    </article>
    <aside class="side">
      {u.authors.length > 0 && (
        <div class="u-a7f2c7">
          <span class="u-64fd1f">{t.people}</span>
          {u.authors.map((a) => (
            <a href={a.href} class="person">
              <span style={`width:32px;height:32px;border-radius:50%;background:${a.avBg};color:var(--fg-on-dark);display:flex;align-items:center;justify-content:center;font:700 11px/1 var(--font-display);flex-shrink:0`}>{a.ini}</span>
              <span class="u-16cf97">{a.name}</span>
            </a>
          ))}
        </div>
      )}
      <div class="u-459fe4">
        <span class="u-edb37f">{t.more}</span>
        {more.map((m) => (
          <a href={m.href} class="more">
            <span class="u-93240e">{m.typeLabel} · {m.dateLabel}</span>
            <span class="u-d11f23">{m.title}</span>
          </a>
        ))}
      </div>
    </aside>
  </div>
</section>

</BaseLayout>

<style>
  .crumb { display: inline-flex; align-items: center; gap: 6px; color: var(--navy-600); }
  .crumb:hover { color: var(--red-600); }
  .body { max-width: 1088px; margin: 0 auto; padding: clamp(40px,6vw,64px) 20px; display: grid; grid-template-columns: minmax(0,1fr); gap: 40px clamp(32px,5vw,64px); align-items: start; }
  .side { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  @media (min-width: 960px) {
    .body { grid-template-columns: minmax(0,1fr) 300px; }
    .side { position: sticky; top: 104px; }
  }
  .src { display: flex; align-items: center; justify-content: space-between; gap: 12px; font: 600 15px/1.35 var(--font-display); color: var(--navy-700); }
  .src:hover { color: var(--red-600); }
  .person { display: flex; align-items: center; gap: 10px; color: var(--text-heading); }
  .person:hover { color: var(--navy-600); }
  .more { display: flex; flex-direction: column; gap: 6px; padding: 14px 12px; margin: 0 -12px; border-bottom: 1px solid var(--border-default); color: var(--text-heading) }
  .more:hover { color: var(--navy-600) }
  .u-472bd9 { position:relative;max-width:880px;margin:0 auto;padding:clamp(28px,4vw,40px) 20px clamp(36px,5vw,56px); }
  .u-04f982 { display:flex;align-items:center;gap:8px;flex-wrap:wrap;font:600 13px/1 var(--font-display); }
  .u-5b795a { color:var(--text-muted); }
  .u-738f05 { display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:clamp(24px,4vw,36px); }
  .u-839954 { font:500 13px/1 var(--font-mono);color:var(--text-muted); }
  .u-e4d2ff { font:700 clamp(32px,4.8vw,48px)/1.12 var(--font-display);letter-spacing:var(--tracking-tight);margin:18px 0 0;color:var(--text-heading);text-wrap:balance; }
  .u-07e376 { margin:18px 0 0;font:500 clamp(18px,1.8vw,21px)/1.5 var(--font-display);color:var(--navy-800);text-wrap:pretty; }
  .u-d4876b { width:56px;height:4px;border-radius:2px;background:var(--red-500);margin-top:28px; }
  .u-5cf619 { background:var(--surface-page); }
  .u-b68202 { display:flex;flex-direction:column;gap:20px;min-width:0; }
  .u-8df7e6 { margin:0;font:400 clamp(17px,1.5vw,18px)/1.75 var(--font-sans);color:var(--text-body);text-wrap:pretty; }
  .u-3dfe65 { margin:8px 0 0;display:flex;flex-direction:column;gap:10px; }
  .u-16e09c { font:var(--type-body-sm);color:var(--text-muted); }
  .u-f7dbba { display:flex; }
  .u-ea3812 { margin-top:8px;border-radius:20px;background:var(--surface-card);box-shadow:inset 0 0 0 1px var(--border-subtle);padding:20px 22px;display:flex;flex-direction:column;gap:12px; }
  .u-edb37f { font:600 12px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--text-muted); }
  .u-a7f2c7 { border-radius:var(--radius-xl);background:var(--navy-50);box-shadow:inset 0 0 0 1px var(--navy-200);padding:22px;display:flex;flex-direction:column;gap:12px; }
  .u-64fd1f { font:600 12px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--navy-600); }
  .u-16cf97 { font:600 14px/1.3 var(--font-display); }
  .u-459fe4 { display:flex;flex-direction:column;gap:10px; }
  .u-93240e { font:500 12px/1 var(--font-mono);color:var(--text-muted); }
  .u-d11f23 { font:700 15px/1.35 var(--font-display);text-wrap:pretty; }
  .type-tag { display: inline-flex; align-items: center; height: 24px; padding: 0 8px; border-radius: var(--radius-xs); font: 600 12px/1 var(--font-display); letter-spacing: var(--tracking-wide); text-transform: uppercase; white-space: nowrap; }
  .vid { margin: 8px 0 0; width: 100%; border-radius: var(--radius-lg); overflow: hidden; background: var(--navy-900); }
  .vid video { display: block; width: 100%; max-height: 560px; object-fit: contain; background: var(--navy-900); }
  .vid-link { margin: 0; }
  .vid-link a { display: inline-flex; align-items: center; gap: 6px; font: 600 14px/1 var(--font-display); color: var(--navy-700); }
  .photo-credit { margin: -12px 0 0; font: 500 12px/1.4 var(--font-mono); color: var(--text-muted); }
</style>
