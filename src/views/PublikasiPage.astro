  .u-7a3b8b { display:flex;align-items:center;gap:8px;font:600 12px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--yellow-300); }
  .u-f24032 { font:700 clamp(22px,2.6vw,28px)/1.2 var(--font-display);text-wrap:balance; }
  .u-37a08a { font:var(--type-body-sm);color:var(--fg-on-dark-2);text-wrap:pretty; }
  .u-32fd19 { position:relative;justify-self:start;display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 18px;border-radius:999px;background:var(--ink-0);color:var(--navy-900);font:600 14px/1 var(--font-display);max-width:100%;overflow-wrap:anywhere; }
  .u-839954 { font:500 13px/1 var(--font-mono);color:var(--text-muted); }
  .u-297e45 { display:flex;flex-direction:column;box-shadow:inset 0 1px 0 var(--border-subtle);min-width:0; }
  .u-72fafc { display:flex;align-items:center;gap:10px;flex-wrap:wrap; }
  .u-061089 { font:500 13px/1.3 var(--font-mono);color:var(--text-muted); }
  .u-89bd09 { flex:1;min-width:0; }
