  .u-2075ff { display:flex;flex-wrap:wrap;gap:6px; }
  .u-1c3257 { font:var(--type-body);color:var(--text-muted); }
  .u-3c657e { padding-bottom:clamp(56px,8vw,96px); }
  .u-1a17bf { border-radius:var(--radius-xl);background:var(--navy-50);box-shadow:inset 0 0 0 1px var(--navy-200);padding:clamp(22px,3vw,32px);display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px 32px; }
  .u-77325d { display:flex;flex-direction:column;gap:6px;max-width:640px; }
  .u-8014ef { font:700 clamp(20px,2.2vw,24px)/1.25 var(--font-display);color:var(--text-heading); }
  .u-827c3f { font:var(--type-body);color:var(--text-muted);text-wrap:pretty; }
  .type-tag { display: inline-flex; align-items: center; height: 24px; padding: 0 8px; border-radius: var(--radius-xs); font: 600 12px/1 var(--font-display); letter-spacing: var(--tracking-wide); text-transform: uppercase; white-space: nowrap; }
  .person-name { display: inline-block; max-width: 0; margin: 0; opacity: 0; overflow: hidden; white-space: nowrap; transition: max-width var(--dur-slower) var(--ease-out), margin var(--dur-slower) var(--ease-out), opacity var(--dur-base) var(--ease-out); }
  .person:hover .person-name, .person:focus-visible .person-name { max-width: 260px; margin: 0 7px 0 6px; opacity: 1; }
  @media (hover: none) { .person-name { max-width: none; margin: 0 7px 0 6px; opacity: 1; } }
  .pub-sum { margin: 0; font: var(--type-body-sm); color: var(--text-muted); max-width: 70ch; text-wrap: pretty; }
  .hl { display: flex; flex-direction: column; gap: var(--space-3); }
  .hl-head { display: flex; align-items: center; justify-content: space-between; }
  .hl-title-h { font: var(--type-h3); font-size: 20px; color: var(--text-heading); margin: 0; }
  .hl-nav { display: flex; gap: 6px; }
  .hl-btn { width: 40px; height: 40px; border-radius: 999px; border: 0; background: var(--ink-0); box-shadow: inset 0 0 0 1px var(--border-default); color: var(--navy-700); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background-color var(--dur-base) var(--ease-out); }
  .hl-btn:hover { background: var(--navy-50); }
  .hl-track { display: flex; gap: var(--space-4); overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px 2px var(--space-3); scrollbar-width: thin; }
  .hl-card { flex: 0 0 min(292px, 82%); scroll-snap-align: start; display: flex; flex-direction: column; gap: var(--space-2); border-radius: var(--radius-lg); background: var(--ink-0); box-shadow: inset 0 0 0 1px var(--border-default); padding: 0 0 var(--space-4); overflow: hidden; color: var(--text-heading); transition: box-shadow var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .hl-card:hover { box-shadow: inset 0 0 0 2px var(--yellow-400); color: var(--text-heading); }
  .hl-band { display: flex; align-items: flex-end; justify-content: space-between; height: 84px; padding: var(--space-3) var(--space-4); }
  .hl-kind { font: 700 12px/1 var(--font-display); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
