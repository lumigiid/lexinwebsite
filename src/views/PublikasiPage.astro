  .pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .pill { cursor: pointer; border: 0; height: 36px; padding: 0 14px; border-radius: 999px; display: inline-flex; align-items: center; gap: 8px; font: 600 13px/1 var(--font-display); white-space: nowrap; background: var(--ink-0); color: var(--navy-900); box-shadow: inset 0 0 0 1px var(--border-subtle); }
  .pill:hover { box-shadow: inset 0 0 0 1px var(--navy-300); }
  .pill.on { background: var(--navy-600); color:var(--fg-on-dark); box-shadow: none; }
  .cnt { font: 500 12px/1 var(--font-mono); opacity: .7; }
  .feat { border-radius: var(--radius-xl); background: var(--grad-night); color:var(--fg-on-dark); padding: clamp(24px,3vw,32px); display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,320px),1fr)); gap: 20px 40px; align-items: center; position: relative; overflow: hidden; }
  .feat:hover { color:var(--fg-on-dark); }
  .year { display: grid; grid-template-columns: minmax(0,1fr); gap: 12px 32px; align-items: start; }
  .year-num { position: static; top: 104px; font: 700 clamp(28px,3vw,36px)/1 var(--font-display); letter-spacing: var(--tracking-tight); color: var(--navy-200); }
  @media (min-width: 760px) {
    .year { grid-template-columns: 96px minmax(0,1fr); }
    .year-num { position: sticky; }
  }
  .pub { padding: 20px 0; box-shadow: inset 0 -1px 0 var(--border-subtle); display: flex; flex-direction: column; gap: 10px; }
  .pub-authors { display: inline-flex; flex-wrap: wrap; gap: 6px; margin-left: 4px; }
  .pub .u-72fafc { row-gap: 8px; }
  .pub-title { display: flex; align-items: flex-start; gap: 10px; font: 700 clamp(17px,1.6vw,19px)/1.4 var(--font-display); color: var(--text-heading); text-wrap: pretty; }
  .pub-title:hover { color: var(--navy-600); }
  .person { height: 28px; padding: 0 3px; border-radius: 999px; background: var(--navy-50); display: inline-flex; align-items: center; gap: 0; font: 600 12px/1 var(--font-display); color: var(--navy-800); white-space: nowrap; }
  .person:hover { background: var(--navy-100); color: var(--navy-600); }
  .empty { border-radius: var(--radius-xl); border: 2px dashed var(--navy-200); padding: 32px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .empty[hidden] { display: none; }
  .reset { cursor: pointer; border: 0; height: 36px; padding: 0 16px; border-radius: 999px; background: var(--navy-600); color:var(--fg-on-dark); font: 600 13px/1 var(--font-display); }
  .u-65f54a { font:var(--type-body-lg);margin:24px 0 0;color:var(--text-body);max-width:640px;text-wrap:pretty; }
  .u-5cf619 { background:var(--surface-page); }
