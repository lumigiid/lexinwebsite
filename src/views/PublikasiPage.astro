---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { dict, url, asset, type Lang } from '../lib/i18n';
import { members, allPubs, pubKind } from '../lib/content';
import LAYERS from '../data/publication-layers.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict('publikasi', lang);

const AV: Record<string, string> = { lead: 'var(--grad-signature)', fac: 'linear-gradient(135deg,var(--navy-500),var(--navy-700))', staff: 'linear-gradient(135deg,var(--red-500),var(--red-700))' };
const TYPE_STYLE: Record<string, string[]> = { journal: ['var(--navy-50)', 'var(--navy-700)'], conf: ['var(--red-50)', 'var(--red-700)'], book: ['var(--yellow-100)', 'var(--navy-900)'] };
const bySlug = Object.fromEntries(members.map((m) => [m.slug, m]));

// Deduplicated by title; research layers come from publication-layers.json, else from the authors' foundation.
const PUBS = allPubs().map((p) => {
  const who = p.authors.map((s) => bySlug[s]);
  const ex = LAYERS.filter((l) => p.title.toLowerCase().includes(l.match)).flatMap((l) => l.layers);
  const layers = [...new Set(ex.length ? ex : who.map((m) => 'f:' + m.area))];
  return { ...p, type: pubKind(p.venue), who, layers };
}).sort((a, b) => +b.year - +a.year || a.title.localeCompare(b.title));

const years = [...new Set(PUBS.map((p) => p.year))].map((year) => ({ year, items: PUBS.filter((p) => p.year === year) }));

const fits = (p: (typeof PUBS)[number], key: string, k: string) =>
  k === 'all' || (key === 'type' ? p.type === k : key === 'area' ? p.layers.includes(k) : p.who.some((m) => m.slug === k));
const pill = (key: string, k: string, label: string) => ({ key, k, label, count: PUBS.filter((p) => fits(p, key, k)).length });
const types = [['all', t.all], ['journal', t.types.journal], ['conf', t.types.conf], ['book', t.types.book]].map(([k, l]) => pill('type', k, l));
const pillarF = Object.keys(t.pillars).map((k) => pill('area', 'p:' + k, t.pillars[k]));
const areasF = Object.keys(t.areas).map((k) => pill('area', 'f:' + k, t.areas[k]));
const infraF = Object.keys(t.infras).map((k) => pill('area', 'i:' + k, t.infras[k]));
const membersF = [pill('member', 'all', t.all)].concat(members.filter((m) => m.pubs && m.pubs.length).map((m) => pill('member', m.slug, m.name)));
---
<BaseLayout lang={lang} path="publikasi/" active="publikasi" title={`Lexin — ${t.nav[3]}`}>

<PageHeader>
  <div class="eyebrow">{t.eyebrow}</div>
  <h1 class="ph-h1">{t.titleA} <span class="grad-text">{t.titleB}</span></h1>
  <div class="ph-rule"></div>
  <p style="font:var(--type-body-lg);margin:24px 0 0;color:var(--text-body);max-width:640px;text-wrap:pretty">{t.intro}</p>
</PageHeader>

<section style="background:var(--surface-page)">
  <div class="container layout" data-results-word={t.results}>
    <aside class="filters">
      <label class="search">
        <Icon name="search" size={18} />
        <input type="search" placeholder={t.searchPh} aria-label={t.searchPh} />
      </label>
      <div style="display:flex;flex-direction:column;gap:10px"><span class="f-lbl">{t.typeLabel}</span><div class="pills">
        {types.map((f) => <button type="button" class:list={['pill', { on: f.k === 'all' }]} data-key={f.key} data-k={f.k}>{f.label}<span class="cnt">{f.count}</span></button>)}
      </div></div>
      <div style="display:flex;flex-direction:column;gap:12px"><span class="f-lbl">{t.layerLabel}</span>
        <div class="pills"><button type="button" class="pill on" data-key="area" data-k="all">{t.all}<span class="cnt">{PUBS.length}</span></button></div>
        <div style="display:flex;flex-direction:column;gap:8px"><span class="f-sub">{t.pillarLabel}</span><div class="pills">
          {pillarF.map((f) => <button type="button" class="pill" data-key={f.key} data-k={f.k}>{f.label}<span class="cnt">{f.count}</span></button>)}
        </div></div>
        <div style="display:flex;flex-direction:column;gap:8px"><span class="f-sub">{t.foundationLabel}</span><div class="pills">
          {areasF.map((f) => <button type="button" class="pill" data-key={f.key} data-k={f.k}>{f.label}<span class="cnt">{f.count}</span></button>)}
        </div></div>
        <div style="display:flex;flex-direction:column;gap:8px"><span class="f-sub">{t.infraLabel}</span><div class="pills">
          {infraF.map((f) => <button type="button" class="pill" data-key={f.key} data-k={f.k}>{f.label}<span class="cnt">{f.count}</span></button>)}
        </div></div>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px"><span class="f-lbl">{t.memberLabel}</span><div class="pills">
        {membersF.map((f) => <button type="button" class:list={['pill', { on: f.k === 'all' }]} data-key={f.key} data-k={f.k}>{f.label}<span class="cnt">{f.count}</span></button>)}
      </div></div>
    </aside>

    <div style="display:flex;flex-direction:column;gap:clamp(32px,5vw,48px);min-width:0">
      <a href="https://github.com/ninggar17/dataset_lexid_pdf" class="feat" target="_blank" rel="noopener">
        <img src={asset('assets/lexin-mark.png')} alt="" style="position:absolute;right:-40px;bottom:-60px;height:220px;opacity:.1;filter:brightness(0) invert(1);pointer-events:none;max-width:none" />
        <div style="position:relative;display:flex;flex-direction:column;gap:10px">
          <span style="display:flex;align-items:center;gap:8px;font:600 12px/1 var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--yellow-300)"><Icon name="database" size={14} />{t.featLabel}</span>
          <span style="font:700 clamp(22px,2.6vw,28px)/1.2 var(--font-display);text-wrap:balance">{t.featTitle}</span>
          <span style="font:var(--type-body-sm);color:var(--fg-on-dark-2);text-wrap:pretty">{t.featBody}</span>
        </div>
        <span style="position:relative;justify-self:start;display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 18px;border-radius:999px;background:#FFFFFF;color:var(--navy-900);font:600 14px/1 var(--font-display);max-width:100%;overflow-wrap:anywhere"><Icon name="github" size={16} />github.com/ninggar17/dataset_lexid_pdf</span>
      </a>
      <span class="result-label" style="font:500 13px/1 var(--font-mono);color:var(--text-muted)">{PUBS.length} {t.results}</span>
      {years.map((y) => (
        <div class="year" data-year={y.year}>
          <span class="year-num">{y.year}</span>
          <div style="display:flex;flex-direction:column;box-shadow:inset 0 1px 0 var(--border-subtle);min-width:0">
            {y.items.map((u) => (
              <article class="pub" data-type={u.type} data-layers={u.layers.join(' ')} data-members={u.who.map((m) => m.slug).join(' ')} data-text={(u.title + ' ' + u.venue).toLowerCase()}>
                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                  <span style={`height:24px;padding:0 10px;border-radius:999px;background:${TYPE_STYLE[u.type][0]};color:${TYPE_STYLE[u.type][1]};font:600 11px/24px var(--font-display);letter-spacing:var(--tracking-wide);text-transform:uppercase`}>{t.types[u.type]}</span>
                  <span style="font:500 13px/1.3 var(--font-mono);color:var(--text-muted)">{u.venue}</span>
                </div>
                <a href={u.href} class="pub-title" target="_blank" rel="noopener"><span style="flex:1;min-width:0">{u.title}</span><span style="color:var(--navy-400);display:flex;margin-top:3px"><Icon name="arrow-up-right" size={16} /></span></a>
                <div style="display:flex;flex-wrap:wrap;gap:6px">
                  {u.who.map((a) => (
                    <a href={url(lang, 'anggota/' + a.slug + '/')} class="person"><span style={`width:22px;height:22px;border-radius:50%;background:${AV[a.g]};color:#FFFFFF;display:flex;align-items:center;justify-content:center;font:700 9px/1 var(--font-display)`}>{a.ini}</span>{a.name}</a>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
      <div class="empty" hidden>
        <span style="font:var(--type-body);color:var(--text-muted)">{t.empty}</span>
        <button type="button" class="reset">{t.reset}</button>
      </div>
    </div>
  </div>
</section>

<section style="background:var(--surface-page)">
  <div class="container" style="padding-bottom:clamp(56px,8vw,96px)">
    <div style="border-radius:var(--radius-xl);background:var(--navy-50);box-shadow:inset 0 0 0 1px var(--navy-200);padding:clamp(22px,3vw,32px);display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px 32px">
      <div style="display:flex;flex-direction:column;gap:6px;max-width:640px">
        <span style="font:700 clamp(20px,2.2vw,24px)/1.25 var(--font-display);color:var(--text-heading)">{t.moreTitle}</span>
        <span style="font:var(--type-body);color:var(--text-muted);text-wrap:pretty">{t.moreBody}</span>
      </div>
      <Button variant="secondary" iconRight="arrow-right" href={url(lang, 'anggota/')}>{t.moreCta}</Button>
    </div>
  </div>
</section>

</BaseLayout>

<script>
  type Key = 'type' | 'area' | 'member';
  const state: Record<Key, string> & { q: string } = { q: '', type: 'all', area: 'all', member: 'all' };
  const pubs = [...document.querySelectorAll<HTMLElement>('.pub')];
  const pills = [...document.querySelectorAll<HTMLButtonElement>('.pill')];
  const input = document.querySelector<HTMLInputElement>('.search input')!;
  const word = document.querySelector<HTMLElement>('.layout')!.dataset.resultsWord;

  const has = (el: HTMLElement, attr: string, v: string) => (el.dataset[attr] || '').split(' ').includes(v);
  const match = (el: HTMLElement, skip?: Key) =>
    (skip === 'type' || state.type === 'all' || el.dataset.type === state.type) &&
    (skip === 'area' || state.area === 'all' || has(el, 'layers', state.area)) &&
    (skip === 'member' || state.member === 'all' || has(el, 'members', state.member)) &&
    (!state.q || (el.dataset.text || '').includes(state.q));
  const fits = (el: HTMLElement, key: Key, k: string) =>
    k === 'all' || (key === 'type' ? el.dataset.type === k : has(el, key === 'area' ? 'layers' : 'members', k));

  const render = () => {
    let n = 0;
    pubs.forEach((el) => { const ok = match(el); el.hidden = !ok; if (ok) n++; });
    document.querySelectorAll<HTMLElement>('.year').forEach((y) => { y.hidden = !y.querySelector('.pub:not([hidden])'); });
    pills.forEach((b) => {
      const key = b.dataset.key as Key, k = b.dataset.k!;
      b.classList.toggle('on', state[key] === k);
      b.setAttribute('aria-pressed', String(state[key] === k));
      b.querySelector('.cnt')!.textContent = String(pubs.filter((el) => match(el, key) && fits(el, key, k)).length);
    });
    document.querySelector('.result-label')!.textContent = `${n} ${word}`;
    document.querySelector<HTMLElement>('.empty')!.hidden = n > 0;
  };

  pills.forEach((b) => b.addEventListener('click', () => { state[b.dataset.key as Key] = b.dataset.k!; render(); }));
  input.addEventListener('input', () => { state.q = input.value.trim().toLowerCase(); render(); });
  document.querySelector('.reset')!.addEventListener('click', () => { Object.assign(state, { q: '', type: 'all', area: 'all', member: 'all' }); input.value = ''; render(); });
  render();
</script>

<style>
  .layout { padding-top: clamp(32px,5vw,56px); padding-bottom: clamp(48px,7vw,80px); display: grid; grid-template-columns: minmax(0,1fr); gap: clamp(28px,4vw,56px); align-items: start; }
  .filters { position: static; top: 104px; display: flex; flex-direction: column; gap: 22px; min-width: 0; }
  @media (min-width: 1120px) {
    .layout { grid-template-columns: 300px minmax(0,1fr); }
    .filters { position: sticky; }
  }
  .search { display: flex; align-items: center; gap: 10px; height: 48px; padding: 0 16px; border-radius: 14px; background: #FFFFFF; box-shadow: inset 0 0 0 1px var(--border-subtle); color: var(--text-muted); min-width: 0; }
  .search:focus-within { box-shadow: inset 0 0 0 1.5px var(--navy-500), var(--focus-ring); }
  .search input { flex: 1; min-width: 0; border: 0; outline: none; background: transparent; font: var(--type-body); color: var(--text-heading); }
  .search input:focus-visible { box-shadow: none; }
  .f-lbl { font: 600 11px/1 var(--font-display); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--text-muted); }
  .f-sub { font: 500 11px/1 var(--font-mono); color: var(--text-muted); }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .pill { cursor: pointer; border: 0; height: 36px; padding: 0 14px; border-radius: 999px; display: inline-flex; align-items: center; gap: 8px; font: 600 13px/1 var(--font-display); white-space: nowrap; background: #FFFFFF; color: var(--navy-900); box-shadow: inset 0 0 0 1px var(--border-subtle); }
  .pill:hover { box-shadow: inset 0 0 0 1px var(--navy-300); }
  .pill.on { background: var(--navy-600); color: #FFFFFF; box-shadow: none; }
  .cnt { font: 500 11px/1 var(--font-mono); opacity: .7; }
  .feat { border-radius: var(--radius-xl); background: var(--grad-night); color: #FFFFFF; padding: clamp(24px,3vw,32px); display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,320px),1fr)); gap: 20px 40px; align-items: center; position: relative; overflow: hidden; }
  .feat:hover { color: #FFFFFF; }
  .year { display: grid; grid-template-columns: minmax(0,1fr); gap: 12px 32px; align-items: start; }
  .year-num { position: static; top: 104px; font: 700 clamp(28px,3vw,36px)/1 var(--font-display); letter-spacing: var(--tracking-tight); color: var(--navy-200); }
  @media (min-width: 760px) {
    .year { grid-template-columns: 96px minmax(0,1fr); }
    .year-num { position: sticky; }
  }
  .pub { padding: 20px 0; box-shadow: inset 0 -1px 0 var(--border-subtle); display: flex; flex-direction: column; gap: 10px; }
  .pub-title { display: flex; align-items: flex-start; gap: 10px; font: 700 clamp(17px,1.6vw,19px)/1.4 var(--font-display); color: var(--text-heading); text-wrap: pretty; }
  .pub-title:hover { color: var(--navy-600); }
  .person { height: 28px; padding: 0 10px 0 3px; border-radius: 999px; background: var(--navy-50); display: inline-flex; align-items: center; gap: 6px; font: 600 12px/1 var(--font-display); color: var(--navy-800); white-space: nowrap; }
  .person:hover { background: var(--navy-100); color: var(--navy-600); }
  .empty { border-radius: var(--radius-xl); border: 2px dashed var(--navy-200); padding: 32px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .empty[hidden] { display: none; }
  .reset { cursor: pointer; border: 0; height: 36px; padding: 0 16px; border-radius: 999px; background: var(--navy-600); color: #FFFFFF; font: 600 13px/1 var(--font-display); }
</style>
