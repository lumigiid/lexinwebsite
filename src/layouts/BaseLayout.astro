---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url, asset, MAIN_EMAIL, type Lang, NAV_ROUTES } from '../lib/i18n';
import seo from '../data/seo.json';

const GA_ID = 'G-HL8R92BXMD';

interface Props {
  lang: Lang;
  /** Indonesian route path without language prefix, e.g. `riset/` or `anggota/panca-hadi-putra/`. */
  path: string;
  /** Page title. Defaults to the entry for `path` in `src/data/seo.json`. */
  title?: string;
  description?: string;
  active?: (typeof NAV_ROUTES)[number];
  /** Share image (site path or absolute URL). Defaults to the Lexin logo card. */
  image?: string;
  imageAlt?: string;
  /** Open Graph type: `article` for Wawasan posts, `profile` for member pages. */
  type?: 'website' | 'article' | 'profile';
  /** ISO date for articles. */
  published?: string;
  /** Extra schema.org objects for this page (the organization is always included). */
  jsonLd?: Record<string, any>[];
  /** Keep this page out of search results (the 404 page). */
  noindex?: boolean;
}
const { lang, path, active, image, type = 'website', published, jsonLd = [], noindex = false } = Astro.props;
const page = (seo as any)[path.replace(/\/$/, '') || 'home']?.[lang];
const title: string = Astro.props.title ?? page?.title ?? seo.home[lang].title;
const desc: string = Astro.props.description ?? page?.description ?? seo.home[lang].description;
const abs = (p: string) => new URL(p, Astro.site).href;
const canonical = abs(url(lang, path));
const ogImage = abs(image ?? asset('assets/og-default.png'));
const imageAlt = Astro.props.imageAlt ?? (lang === 'id' ? 'Logo Universitas Indonesia dan Lexin' : 'Universitas Indonesia and Lexin logos');

// The organization behind every page, so search engines can tie the pages together.
const org = {
  '@type': ['ResearchOrganization', 'Organization'],
  '@id': abs('/#organization'),
  name: 'Lexin',
  alternateName: ['Lexin UI', 'Pusat Informatika Hukum Universitas Indonesia', 'Universitas Indonesia Center for Legal Informatics'],
  url: abs('/'),
  logo: abs(asset('assets/logo-lexin.png')),
  email: MAIN_EMAIL,
  description: seo.home[lang].description,
  parentOrganization: {
    '@type': 'CollegeOrUniversity',
    name: 'Fakultas Ilmu Komputer, Universitas Indonesia',
    url: 'https://cs.ui.ac.id/',
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Fakultas Ilmu Komputer, Kampus UI Depok',
    addressLocality: 'Depok',
    addressRegion: 'Jawa Barat',
    postalCode: '16424',
    addressCountry: 'ID',
  },
  sameAs: ['https://github.com/lab-lexin'],
};
const graph = [
  org,
  { '@type': 'WebSite', '@id': abs('/#website'), url: abs('/'), name: 'Lexin', publisher: { '@id': org['@id'] }, inLanguage: ['id', 'en'] },
  ...jsonLd,
];
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="id" href={abs(url('id', path))} />}
    {!noindex && <link rel="alternate" hreflang="en" href={abs(url('en', path))} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={abs(url('id', path))} />}
    <link rel="icon" type="image/png" href={asset('assets/lexin-mark.png')} />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />
    <meta property="og:site_name" content="Lexin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'id' ? 'en_US' : 'id_ID'} />
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={ld} />
    {/* Google Analytics 4. Loads only on the live domain, so local previews don't count as visits. */}
    <script is:inline define:vars={{ GA_ID }}>
      if (location.hostname === 'lexin.cs.ui.ac.id') {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', GA_ID);
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(s);
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500;1,600;1,700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" />
  </head>
  <body>
    <Header lang={lang} path={path} active={active} noindex={noindex} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  <script>import '../scripts/italics';</script>
  <script>import '../scripts/motion';</script>
  </body>
</html>
