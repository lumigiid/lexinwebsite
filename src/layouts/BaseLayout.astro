---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url, asset, type Lang, NAV_ROUTES } from '../lib/i18n';

interface Props {
  lang: Lang;
  /** Indonesian route path without language prefix, e.g. `riset/` or `anggota/panca-hadi-putra/`. */
  path: string;
  title: string;
  description?: string;
  active?: (typeof NAV_ROUTES)[number];
}
const { lang, path, title, description, active } = Astro.props;
const desc = description ?? (lang === 'id'
  ? 'Lexin, Pusat Informatika Hukum Universitas Indonesia: riset, data, dan produk AI untuk sistem hukum Indonesia.'
  : 'Lexin, the Universitas Indonesia Center for Legal Informatics: research, data and AI products for the Indonesian legal system.');
const canonical = new URL(url(lang, path), Astro.site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="id" href={new URL(url('id', path), Astro.site).href} />
    <link rel="alternate" hreflang="en" href={new URL(url('en', path), Astro.site).href} />
    <link rel="icon" type="image/png" href={asset('assets/lexin-mark.png')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500;1,600;1,700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" />
  </head>
  <body>
    <Header lang={lang} path={path} active={active} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  <script>import '../scripts/italics';</script>
  <script>import '../scripts/motion';</script>
  </body>
</html>
