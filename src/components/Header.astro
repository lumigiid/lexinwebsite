---
import Button from './Button.astro';
import IconButton from './IconButton.astro';
import Icon from './Icon.astro';
import { dict, url, asset, NAV_ROUTES, type Lang } from '../lib/i18n';

interface Props { lang: Lang; path: string; active?: (typeof NAV_ROUTES)[number] }
const { lang, path, active } = Astro.props;
const t = dict('home', lang);
const nav = t.nav.map((label: string, i: number) => ({ label, href: url(lang, NAV_ROUTES[i] + '/'), on: NAV_ROUTES[i] === active }));
---
<header class="site-header">
  <div class="container bar">
    <a href={url(lang)} class="brand"><img src={asset('assets/logo-lexin-ui-cobrand.png')} alt="Universitas Indonesia · Lexin" width="1452" height="410" /></a>
    <nav class="nav-wide" aria-label={lang === 'id' ? 'Utama' : 'Main'}>
      {nav.map((n: any) => <a href={n.href} class:list={['nav-link', { on: n.on }]} aria-current={n.on ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="tools">
      <div class="lang" role="group" aria-label="Language">
        <a href={url('id', path)} class:list={{ on: lang === 'id' }} hreflang="id" lang="id">ID</a>
        <a href={url('en', path)} class:list={{ on: lang === 'en' }} hreflang="en" lang="en">EN</a>
      </div>
      <Button variant="primary" size="sm" href={url(lang, 'kontak/')} class="contact-btn">{t.contact}</Button>
      <IconButton icon="menu" label="Menu" variant="ghost" class="menu-btn" aria-expanded="false" aria-controls="mobile-menu">
        <span class="i-open"><Icon name="menu" size={19} /></span><span class="i-close"><Icon name="x" size={19} /></span>
      </IconButton>
    </div>
  </div>
  <nav id="mobile-menu" class="nav-mobile" hidden>
    {nav.map((n: any) => <a href={n.href} class:list={['m-link', { on: n.on }]}>{n.label}</a>)}
    <div style="margin-top:12px">
      <Button variant="gradient" fullWidth iconRight="mail" href="mailto:hadiputra@cs.ui.ac.id">{t.contactUs}</Button>
    </div>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.site-header .menu-btn');
  const panel = document.getElementById('mobile-menu');
  if (btn && panel) {
    const set = (open: boolean) => {
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.classList.toggle('open', open);
    };
    btn.addEventListener('click', () => set(panel.hidden));
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    matchMedia('(min-width: 1120px)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>

<style is:global>
  .site-header { position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.82); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: inset 0 -1px 0 var(--border-subtle); }
  .site-header .bar { height: 80px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .site-header .brand { display: flex; align-items: center; flex-shrink: 1; min-width: 0; }
  .site-header .brand img { height: 44px; max-width: 100%; width: auto; display: block; }
  .site-header .nav-wide { display: flex; gap: 2px; flex: 1; justify-content: center; }
  .site-header .nav-link { padding: 8px 12px; border-radius: 999px; font: 600 15px/1 var(--font-display); color: var(--navy-900); background: transparent; }
  .site-header .nav-link.on { color: var(--navy-600); background: var(--navy-50); }
  .site-header .nav-link:hover, .site-header .m-link:hover { background: var(--navy-50); color: var(--navy-600); }
  .site-header .tools { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .site-header .lang { display: flex; background: var(--ink-50); border-radius: 999px; padding: 3px; gap: 2px; }
  .site-header .lang a { display: inline-flex; align-items: center; height: 30px; padding: 0 12px; border-radius: 999px; font: 600 12px/1 var(--font-display); background: transparent; color: var(--ink-600); }
  .site-header .lang a.on { background: var(--grad-signature); color: #FFFFFF; }
  .site-header .lang a:not(.on):hover { color: var(--navy-700); }
  .site-header .menu-btn { display: none; }
  .site-header .menu-btn .i-close, .site-header .menu-btn.open .i-open { display: none; }
  .site-header .menu-btn.open .i-close { display: inline-flex; }
  .site-header .menu-btn .i-open { display: inline-flex; }
  .site-header .nav-mobile { border-top: 1px solid var(--border-subtle); background: #FFFFFF; padding: 12px 20px 20px; display: flex; flex-direction: column; gap: 2px; max-height: calc(100vh - 64px); overflow: auto; }
  .site-header .m-link { min-height: 48px; display: flex; align-items: center; padding: 0 12px; border-radius: 14px; font: 600 17px/1 var(--font-display); color: var(--navy-900); }
  .site-header .m-link.on { color: var(--navy-600); background: var(--navy-50); }
  @media (max-width: 1119.98px) {
    .site-header .nav-wide { display: none; }
    .site-header .menu-btn { display: inline-flex; }
  }
  @media (min-width: 1120px) { .site-header .nav-mobile { display: none !important; } }
  @media (max-width: 639.98px) {
    .site-header .bar { height: 64px; }
    .site-header .brand img { height: 34px; }
    .site-header .contact-btn { display: none !important; }
  }
</style>
